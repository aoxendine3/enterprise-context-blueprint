hash_id(id ^ 0x8888888844442222ULL);\n    uint64_t h4 = hash_id(id ^ 0x123456789ABCDEF0ULL);\n    memcpy(out, &h1, 8);\n    memcpy(out + 8, &h2, 8);\n    memcpy(out + 16, &h3, 8);\n    memcpy(out + 24, &h4, 8);\n}\n\n// Multithreaded populate args\ntypedef struct {\n    GateMap* map;\n    uint64_t start_i;\n    uint64_t end_i;\n} PopulateArgs;\n\nvoid* populate_worker(void* arg) {\n    PopulateArgs* p = (PopulateArgs*)arg;\n    GateMap* map = p->map;\n    uint64_t mask = map->mask;\n\n    for (uint64_t i = p->start_i; i < p->end_i; i++) {\n        uint64_t id_h = hash_id(i);\n        uint64_t idx = id_h & mask;\n        while (1) {\n            // Atomic CAS check for slot ownership\n            uint64_t expected = 0;\n            if (__atomic_compare_exchange_n(&map->entries[idx].agent_id_hash, &expected, id_h, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {\n                generate_token(i, map->entries[idx].token);\n                break;\n            }\n            if (expected == id_h) {\n                break;\n            }\n            idx = (idx + 1) & mask;\n        }\n    }\n    return NULL;\n}\n\n// Multithreaded attack args\ntypedef struct {\n    GateMap* map;\n    uint64_t start_k;\n    uint64_t end_k;\n    uint64_t num_agents;\n    uint64_t false_positives;\n    uint64_t false_negatives;\n    int is_forged_attack;\n} AttackArgs;\n\nvoid* attack_worker(void* arg) {\n    AttackArgs* w = (AttackArgs*)arg;\n    GateMap* map = w->map;\n    uint64_t mask = map->mask;\n    uint64_t fps = 0;\n    uint64_t fns = 0;\n    uint8_t token[32];\n\n    for (uint64_t k = w->start_k; k < w->end_k; k++) {\n        uint64_t victim_id = (k * 13) % w->num_agents;\n        uint64_t victim_h = hash_id(victim_id);\n\n        generate_token(victim_id, token);\n\n        if (w->is_forged_attack) {\n            token[k % 32] ^= 0xFF; // Corrupt token with bitflip attack\n        }\n\n        uint64_t idx = victim_h & mask;\n        int passed = 0;\n        while (map->entries[idx].ag
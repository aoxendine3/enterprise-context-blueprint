    double insert_ms = ticks_to_ms(t1 - t0);\n\n    printf(\"   Init Time       : %.2f ms\\n\", init_ms);\n    printf(\"   Populate Time   : %.2f ms\\n\", insert_ms);\n\n    // Parallel attack phase 1 (Forged Probes)\n    AttackArgs atk_args[num_threads];\n    uint64_t atk_chunk = NUM_ATTACKS / num_threads;\n\n    t0 = mach_absolute_time();\n    for (int t = 0; t < num_threads; t++) {\n        atk_args[t].map = &map;\n        atk_args[t].start_k = t * atk_chunk;\n        atk_args[t].end_k = (t == num_threads - 1) ? NUM_ATTACKS : (t + 1) * atk_chunk;\n        atk_args[t].num_agents = num_agents;\n        atk_args[t].is_forged_attack = 1;\n        pthread_create(&threads[t], NULL, attack_worker, &atk_args[t]);\n    }\n\n    uint64_t total_fps = 0;\n    for (int t = 0; t < num_threads; t++) {\n        pthread_join(threads[t], NULL);\n        total_fps += atk_args[t].false_positives;\n    }\n    t1 = mach_absolute_time();\n    double fp_ms = ticks_to_ms(t1 - t0);\n\n    // Parallel attack phase 2 (Valid Probes)\n    t0 = mach_absolute_time();\n    for (int t = 0; t < num_threads; t++) {\n        atk_args[t].map = &map;\n        atk_args[t].start_k = t * atk_chunk;\n        atk_args[t].end_k = (t == num_threads - 1) ? NUM_ATTACKS : (t + 1) * atk_chunk;\n        atk_args[t].num_agents = num_agents;\n        atk_args[t].is_forged_attack = 0;\n        pthread_create(&threads[t], NULL, attack_worker, &atk_args[t]);\n    }\n\n    uint64_t total_fns = 0;\n    for (int t = 0; t < num_threads; t++) {\n        pthread_join(threads[t], NULL);\n        total_fns += atk_args[t].false_negatives;\n    }\n    t1 = mach_absolute_time();\n    double fn_ms = ticks_to_ms(t1 - t0);\n\n    double fp_rate = ((double)total_fps / NUM_ATTACKS) * 100.0;\n    double fn_rate = ((double)total_fns / NUM_ATTACKS) * 100.0;\n    double total_sec = (fp_ms + fn_ms) / 1000.0;\n    double throughput = (NUM_ATTACKS * 2.0) / total_sec;\n\n    printf(\"\\n   === SCALE AUDIT RESULTS (%llu NODES) ===\\n\", (unsi
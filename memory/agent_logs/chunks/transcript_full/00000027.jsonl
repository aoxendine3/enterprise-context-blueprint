0:     slot_size = 131\r\n31:     # 300 bytes reserved for orchestrator metadata, slots start at 300\r\n32:     start = 300 + (node_id * slot_size)\r\n33:     pid = os.getpid()\r\n34: \r\n35:     worker_local_round = 0\r\n36:     last_processed_state = 0\r\n37:     \r\n38:     # Register PID in metadata block\r\n39:     # PID block starts at offset 10 (each node gets 4 bytes for PID + 4 bytes for heartbeat time)\r\n40:     pid_offset = 10 + (node_id * 8)\r\n41:     try:\r\n42:         shm.buf[pid_offset:pid_offset+4] = struct.pack(\"<I\", pid)\r\n43:     except Exception:\r\n44:         pass\r\n45: \r\n46:     last_heartbeat_time = 0\r\n47: \r\n48:     try:\r\n49:         spin_count = 0\r\n50:         while True:\r\n51:             # 1. Heartbeat update (every 100ms)\r\n52:             now = time.perf_counter()\r\n53:             if now - last_heartbeat_time > 0.1:\r\n54:                 shm.buf[pid_offset+4:pid_offset+8] = struct.pack(\"<I\", int(now % 100000))\r\n55:                 last_heartbeat_time = now\r\n56: \r\n57:             # Check global stop flag (Byte 2)\r\n58:             if shm.buf[2] == 1:\r\n59:                 break\r\n60: \r\n61:             # Read orchestrator round number (Byte 3)\r\n62:             round_number = shm.buf[3]\r\n63:             if round_number > worker_local_round:\r\n64:                 last_processed_state = 0\r\n65:                 worker_local_round = round_number\r\n66:                 spin_count = 0  # Reset spin for new round hot-path\r\n67: \r\n68:             # Read the global round state flag from the metadata block (Byte 0)\r\n69:             round_state = shm.buf[0]\r\n70: \r\n71:             if round_state == 0:\r\n72:                 spin_count += 1\r\n73:                 if spin_count < 100000:\r\n74:                     pass\r\n75:                 else:\r\n76:                     os.sched_yield()\r\n77:                 continue\r\n78: \r\n79:             if round_state == 1 and last_processed_state < 1:\r\n80:                 # ------------------\r\n81:                 # 1. PREPARE PHASE\r\n82:                 # ------------------\r\n83:                 prop_byte = shm.buf[1]\r\n84:                 proposal_value = True if prop_byte == 2 else False\r\n85: \r\n86:                 val_to_prepare = proposal_value\r\n87:                 if is_byzantine:\r\n88:                     val_to_prepare = not proposal_value\r\n89: \r\n90:                 # Signature simulates asymmetric cryptosystem verification key pairs\r\n91:                 sig = hmac.new(node_key, f\"PREPARE:{worker_local_round}:{val_to_prepare}\".encode('ascii'), hashlib.sha256).hexdigest()\r\n92: \r\n93:                 # Write prepare vote and signature\r\n94:                 shm.buf[start] = 2 if val_to_prepare else 1\r\n95:                 shm.buf[start+1:start+65] = sig.encode('ascii')\r\n96: \r\n97:                 last_processed_state = 1\r\n98:                 spin_count = 0  # Reset spin count for commit phase transition\r\n99: \r\n100:             elif round_state == 2 and last_processed_state < 2:\r\n101:                 # ------------------\r\n102:                 # 2. COMMIT PHASE\r\n103:                 # ------------------\r\n104:                 prop_byte = shm.buf[1]\r\n105:                 proposal_value = True if prop_byte == 2 else False\r\n106: \r\n107:                 # Read prepares from all nodes and verify\r\n108:                 prepare_tally = {True: 0, False: 0}\r\n109:                 for i in range(num_nodes):\r\n110:                     node_start = 300 + (i * slot_size)\r\n111:                     v_byte = shm.buf[node_start]\r\n112:                     if v_byte == 0:\r\n113:                         continue\r\n114:                     v = True if v_byte == 2 else False\r\n115:                     s = bytes(shm.buf[node_start+1:node_start+65]).decode('ascii')\r\n116: \r\n117:                     other_key = f\"key_secret_{i}\".encode()\r\n118:                     expected = hmac.new(other_key, f\"PREPARE:{worker_local_round}:{v}\".encode('ascii'), hashlib.sha256).hexdigest()\r\n119:                     if s == expected:\r\n120:                         prepare_tally[v] += 1\r\n121: \r\n122:                 # Quorum size is computed dynamically based on active heartbeats reported by parent (Byte 4)\r\n123:                 active_nodes = shm.buf[4]\r\n124:                 if active_nodes < 4:\r\n125:                     active_nodes = num_nodes\r\n126:                 # F threshold adjusts dynamically\r\n127:                 local_f = (active_nodes - 1) // 3\r\n128:                 required_prepares = 2 * local_f + 1\r\n129: \r\n130:                 val_to_commit = None\r\n131:                 if is_byzantine:\r\n132:                     val_to_commit = not proposal_value\r\n133:                 else:\r\n134:                     if prepare_tally[True] >= required_prepares:\r\n135:                         val_to_commit = True\r\n136:                     elif prepare_tally[False] >= required_prepares:\r\n137:                         val_to_commit = False\r\n138: \r\n139:                 if val_to_commit is not None:\r\n140:                     commit_sig = hmac.new(node_key, f\"COMMIT:{worker_local_round}:{val_to_commit}\".encode('ascii'), hashlib.sha256).hexdigest()\r\n141:                     shm.buf[start+65] = 2 if val_to_commit else 1\r\n142:                     shm.buf[start+66:start+130] = commit_sig.encode('ascii')\r\n143: \r\n144:                 last_processed_state = 2\r\n145:                 spin_count = 0  # Reset spin count for finalization phase transition\r\n146: \r\n147:             elif round_state == 3 and last_processed_state < 3:\r\n148:                 # ------------------\r\n149:                 # 3. FINALIZING PHASE\r\n150:                 # ------------------\r\n151:                 commit_tally = {True: 0, False: 0}\r\n152:                 for i in range(num_nodes):\r\n153:                     node_start = 300 + (i * sl
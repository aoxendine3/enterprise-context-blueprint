(\"<I\", hb_bytes)[0]\r\n269:             \r\n270:             if pid != 0:\r\n271:                 # If heartbeat updated in the last 2 seconds (handling modular math wrap)\r\n272:                 diff = (now - hb_time) % 100000\r\n273:                 if diff < 2:\r\n274:                     active_count += 1\r\n275:         \r\n276:         self.shm.buf[4] = active_count if active_count > 0 else self.num_nodes\r\n277: \r\n278:     async def run_consensus_round(self, proposal_value: bool) -> dict:\r\n279:         start_time = time.perf_counter()\r\n280: \r\n281:         if self.use_processes:\r\n282:             # ---------------------------------------------\r\n283:             # PRODUCTION: Persistent Lock-free Process Pool\r\n284:             # ---------------------------------------------\r\n285:             # Track hearts and write active validator count to Byte 4\r\n286:             self._update_heartbeats()\r\n287:             \r\n288:             # Increment global round number (handling byte overflow wrap)\r\n289:             self.current_round_num = (self.current_round_num + 1) % 250\r\n290:             \r\n291:             # Clear validator slots (bytes 300..end)\r\n292:             self.shm.buf[300:self.shm_size] = b'\\x00' * (self.shm_size - 300)\r\n293: \r\n294:             # Write proposal value (Byte 1) and round number (Byte 3)\r\n295:             self.shm.buf[1] = 2 if proposal_value else 1\r\n296:             self.shm.buf[3] = self.current_round_num\r\n297: \r\n298:             # 1. Trigger PREPARE (round_state = 1)\r\n299:             self.shm.buf[0] = 1\r\n300: \r\n301:             # Wait for active nodes to write their prepare vote\r\n302:             prep_start = time.perf_counter()\r\n303:             slot_size = 131\r\n304:             active_limit = self.shm.buf[4]\r\n305:             while True:\r\n306:                 # Count nodes that have written prepare votes\r\n307:                 prep_count = sum(1 for i in range(self.num_nodes) if self.shm.buf[300 + (i * slot_size)] != 0)\r\n308:                 if prep_count >= active_limit:\r\n309:                     break\r\n310:                 if (time.perf_counter() - prep_start) > 1.0:\r\n311:                     break\r\n312:                 await asyncio.sleep(0.0002)\r\n313: \r\n314:             # 2. Trigger COMMIT (round_state = 2)\r\n315:             self.shm.buf[0] = 2\r\n316: \r\n317:             # Wait for commit votes\r\n318:             commit_start = time.perf_counter()\r\n319:             local_f = (active_limit - 1) // 3\r\n320:             required_commits = 2 * local_f + 1\r\n321:             while True:\r\n322:                 commit_count = sum(1 for i in range(self.num_nodes) if self.shm.buf[300 + (i * slot_size) + 65] != 0)\r\n323:                 if commit_count >= required_commits:\r\n324:                     break\r\n325:                 if (time.perf_counter() - commit_start) > 1.0:\r\n326:                     break\r\n327:                 await asyncio.sleep(0.0002)\r\n328: \r\n329:             # 3. Trigger FINALIZATION (round_state = 3)\r\n330:             self.shm.buf[0] = 3\r\n331: \r\n332:             # Wait for final consensus slots to write\r\n333:             final_start = time.perf_counter()\r\n334:             while True:\r\n335:                 done_count = sum(1 for i in range(self.num_nodes) if i >= self.num_byzantine and self.shm.buf[300 + (i * slot_size) + 130] != 0)\r\n336:                 if done_count >= (active_limit - self.num_byzantine):\r\n337:                     break\r\n338:                 if (time.perf_counter() - final_start) > 1.0:\r\n339:                     break\r\n340:                 await asyncio.sleep(0.0002)\r\n341: \r\n342:             # Reset round state to IDLE\r\n343:             self.shm.buf[0] = 0\r\n344: \r\n345:         else:\r\n346:             # ---------------------------------------------\r\n347:             # EMULATED: Fast thread loop fallback\r\n348:             # ---------------------------------------------\r\n349:             self.shm.buf[:self.shm_size] = bytearray(self.shm_size)\r\n350:             slot_size = 131\r\n351:             self.current_round_num = (self.current_round_num + 1) % 250\r\n352:             r_num = self.current_round_num\r\n353: \r\n354:             # Pre-encode messages\r\n355:             prep_true_msg = f\"PREPARE:{r_num}:True\".encode('ascii')\r\n356:             prep_false_msg = f\"PREPARE:{r_num}:False\".encode('ascii')\r\n357: \r\n358:             # 1. Prepare Stage\r\n359:             prepare_tally = {True: 0, False: 0}\r\n360:             for i in range(self.num_nodes):\r\n361:                 val_to_prepare = proposal_value if i >= self.num_byzantine else not proposal_value\r\n362:                 msg = prep_true_msg if val_to_prepare else prep_false_msg\r\n363:                 sig_bytes = self._get_sig_bytes(i, \"PREPARE\", r_num, val_to_prepare, msg)\r\n364: \r\n365:                 start = 300 + (i * slot_size)\r\n366:                 self.shm.buf[start] = 2 if val_to_prepare else 1\r\n367:                 self.shm.buf[start+1:start+65] = sig_bytes\r\n368:                 prepare_tally[val_to_prepare] += 1\r\n369: \r\n370:             # 2. Commit Stage\r\n371:             required_prepares = 2 * self.num_byzantine + 1\r\n372:             val_to_commit_honest = True if prepare_tally[True] >= required_prepares else (False if prepare_tally[False] >= required_prepares else None)\r\n373:             val_to_commit_byz = not proposal_value\r\n374: \r\n375:             commit_tally = {True: 0, False: 0}\r\n376:             commit_true_msg = f\"COMMIT:{r_num}:True\".encode('ascii')\r\n377:             commit_false_msg = f\"COMMIT:{r_num}:False\".encode('ascii')\r\n378: \r\n379:             for i in range(self.num_nodes):\r\n380:                 val_to_commit = val_to_commit_byz if i < self.num_byzantine else val_to_commit_honest\r\n381: \r\n382:                 if val_to_commit is not None:\r\n383:                     msg = commit_true_msg if val_to_commit else commit_false_msg\r\n384:                     sig_bytes = self._get_sig_bytes(i, \"COMMIT\", r_num, val_to_commit, msg)\r\n385: \r\n386:                     start = 300 + (i * slot_size)\r\n387:                     self.shm.buf[start+65] = 2 if val_to_commit else 1\r\n388:                     self.shm.buf[start+66:start+130] = sig_bytes\r\n389:                     commit_tally[val_to_commit] += 1\r\n390: \r\n391:             # 3. Consensus Finalization\r\n392:             required_commits = 2 * self.num_byzantine + 1\r\n393:             committed_val = True if commit_tally[True] >= required_commits else (False if commit_tally[False] >= required_commits else None)\r\n394: \r\n395:             if committed_val is not None:\r\n396:                 val_byte = 2 if committed_val else 1\r\n397:                 for i in range(self.num_byzantine, self.num_nodes):\r\n398:                     start = 300 + (i * slot_size)\r\n399:                     self.shm.buf[start+130] = val_byte\r\n400: \r\n401:         # Read back committed values from shared memory to calculate final status\r\n402:         honest_committed_values = []\r\n403:         slot_size = 131\r\n404:         for i in range(self.num_byzantine, self.num_nodes):\r\n405:             start = 300 + (i * slot_size)\r\n406:             val_byte = self.shm.buf[start+130]\r\n407:             if val_byte != 0:\r\n408:                 honest_committed_values.append(True if val_byte == 2 else False)\r\n409: \r\n410:         end_time = time.perf_counter()\r\n411:         elapsed_ms = (end_time - start_time) * 1000.0\r\n412: \r\n413:         consensus_reached = len(set(honest_committed_values)) == 1 and len(honest_committed_values) > 0\r\n414:         final_value = honest_committed_values[0] if consensus_reached else None\r\n415: \r\n416:         return {\r\n417:             \"consensus_reached\": consensus_reached,\r\n418:             \"final_value\": final_value,\r\n419:             \"latency_ms\": elapsed_ms,\r\n420:             \"honest_nodes_reporting\": len(honest_committed_values)\r\n421:         }\r\n422: \r\n423:     def cleanup(self):\r\n424:         \"\"\"Free pool processes and unlink OS shared memory segment.\"\"\"\r\n425:         if self.use_processes:\r\n426:             # Set global stop flag (Byte 2)\r\n427:             try:\r\n428:                 self.shm.buf[2] = 1\r\n429:             except Exception:\r\n430:                 pass\r\n431:             \r\n432:             for p in self.processes:\r\n433:                 p.join(timeout=0.1)\r\n434:                 if p.is_alive():\r\n435:                     p.terminate()\r\n436: \r\n437:         try:\r\n438:             self.shm.close()\r\n439:             self.shm.unlink()\r\n440:         except Exception:\r\n441:             pass\r\n442: \nThe above content shows the entire, complete file contents of the requested file.\n"}

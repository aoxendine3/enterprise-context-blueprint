36:         self.assertEqual(res[\"final_value\"], True)\r\n37:         self.assertEqual(res[\"honest_nodes_reporting\"], 99) # 148 - 49 honest nodes\r\n38:         \r\n39:     def test_byzantine_agreement_false_proposal(self):\r\n40:         \"\"\"Verify consensus on False proposal is reached correctly.\"\"\"\r\n41:         loop = asyncio.new_event_loop()\r\n42:         asyncio.set_event_loop(loop)\r\n43:         res = loop.run_until_complete(\r\n44:             self.consensus_engine.run_consensus_round(proposal_value=False)\r\n45:         )\r\n46:         \r\n47:         self.assertTrue(res[\"consensus_reached\"])\r\n48:         self.assertEqual(res[\"final_value\"], False)\r\n49: \r\n50:     def test_sub_millisecond_consensus_benchmark(self):\r\n51:         \"\"\"Assert BFT consensus achieves sub-millisecond execution time.\"\"\"\r\n52:         loop = asyncio.new_event_loop()\r\n53:         asyncio.set_event_loop(loop)\r\n54:         \r\n55:         # Warmup\r\n56:         loop.run_until_complete(self.consensus_engine.run_consensus_round(proposal_value=True))\r\n57:         \r\n58:         latencies = []\r\n59:         for _ in range(5):\r\n60:             res = loop.run_until_complete(\r\n61:                 self.consensus_engine.run_consensus_round(proposal_value=True)\r\n62:             )\r\n63:             latencies.append(res[\"latency_ms\"])\r\n64:             \r\n65:         avg_latency = sum(latencies) / len(latencies)\r\n66:         print(f\"\\n[BENCHMARK] SHM-BFT Average Consensus Latency: {avg_latency:.3f} ms\")\r\n67:         \r\n68:         # Bounded check (must be < 1.0 ms)\r\n69:         self.assertLess(avg_latency, 1.0)\r\n70: \r\n71:     def test_invalid_nodes_limit_error(self):\r\n72:         \"\"\"Verify configuring BFT with insufficient honest nodes (> 1/3 Byzantine) raises error.\"\"\"\r\n73:         with self.assertRaises(ValueError):\r\n74:             XorasShmBft(num_nodes=10, num_byzantine=4) # 10 < 3*4 + 1 = 13 (fails)\r\n75: \r\n76: if 
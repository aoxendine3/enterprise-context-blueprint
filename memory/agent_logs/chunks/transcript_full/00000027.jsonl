"Node {node_id} runtime error: {e}\\n\")\r\n192:             traceback.print_exc(file=f)\r\n193: \r\n194:     shm.close()\r\n195: \r\n196: \r\n197: class XorasShmBft:\r\n198:     def __init__(self, num_nodes=148, num_byzantine=49, latency_min_ms=0.0, latency_max_ms=0.0, use_processes=False, shm_name=\"xoras_shm\"):\r\n199:         self.num_nodes = num_nodes\r\n200:         self.num_byzantine = num_byzantine\r\n201:         self.latency_min_ms = latency_min_ms\r\n202:         self.latency_max_ms = latency_max_ms\r\n203:         self.use_processes = use_processes\r\n204:         self.current_round_num = 0\r\n205: \r\n206:         if num_nodes < (3 * num_byzantine + 1):\r\n207:             raise ValueError(f\"Invalid BFT configuration: Node count {num_nodes} is insufficient for {num_byzantine} Byzantine faults.\")\r\n208: \r\n209:         # Allocate 300 bytes metadata + 131 bytes per node slot in POSIX shared memory block\r\n210:         self.shm_name = shm_name\r\n211:         self.shm_size = 300 + (self.num_nodes * 131)\r\n212:         try:\r\n213:             self.shm = shared_memory.SharedMemory(name=self.shm_name, create=True, size=self.shm_size)\r\n214:             self.shm.buf[:self.shm_size] = b'\\x00' * self.shm_size\r\n215:         except FileExistsError:\r\n216:             self.shm = shared_memory.SharedMemory(name=self.shm_name)\r\n217: \r\n218:         # In-process signature cache for emulated mode\r\n219:         self.node_keys = [f\"key_secret_{i}\".encode('ascii') for i in range(self.num_nodes)]\r\n220:         # Pre-compute HMAC inner and outer padded keys for raw sha256 calculation\r\n221:         blocksize = 64\r\n222:         self.ipad_keys = []\r\n223:         self.opad_keys = []\r\n224:         for k in self.node_keys:\r\n225:             if len(k) > blocksize:\r\n226:                 k = hashlib.sha256(k).digest()\r\n227:             k = k.ljust(blocksize, b'\\x00')\r\n228:             self.ipad_keys.append(bytes(x ^ 0x36 for x in k))\r\n229:   
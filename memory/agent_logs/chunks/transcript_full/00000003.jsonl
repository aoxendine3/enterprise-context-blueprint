{"step_index":157,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-28T20:01:34Z","content":"Good. Python 3.14, SQLite available. Building the full dojo harness now — 7 modules, one shared store, adversarial pressure from jump.","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nDojo: Full-stack adversarial testing harness for LinkTec memory hypotheses.\nTests interaction seams between H1 (learned write policy) and H4 (quarantine gate),\nH2×H4 (decay orphans quarantine), and H3×H4 (erasure kills quarantine).\n\nRun:  python3 src/dojo/gauntlet.py\n\"\"\"\n","Description":"Package init for the adversarial dojo harness.","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/src/dojo/__init__.py","toolAction":"Creating package init","toolSummary":"Dojo package init"}},{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nMemory store: SQLite-backed typed node graph with quarantine, decay, and lineage.\n\nNode types: E (episode), S (semantic), P (procedure).\nConfidence (0-255) set by RL policy.  Trust score (0-255) set by quarantine gate.\nStatus flow: quarantined → active → tombstoned.\n\"\"\"\nimport sqlite3\nimport json\nimport uuid\nimport time\nimport math\n\nTRUST_THRESHOLD = 128\nCONFIRM_REQUIRED = 2\n\n\nclass MemoryStore:\n    def __init__(self, db_path=\":memory:\"):\n        self.conn = sqlite3.connect(db_path, check_same_thread=False)\n        self.conn.row_factory = sqlite3.Row\n        self.conn.execute(\"PRAGMA journal_mode=WAL\")\n        self.conn.execute(\"PRAGMA synchronous=NORMAL\")\n        self._init_schema()\n        self.stats = {\n            \"total_writes\": 0,\n            \"direct_admits\": 0,\n            \"quarantined\": 0,\n            \"promoted\": 0,\n            \"tombstoned\": 0,\n            \"decayed\": 0,\n            \"erased\": 0,\n        }\n\n    def _init_schema(self):\n        self.conn.executescript(\"\"\"\n            CREATE TABLE IF NOT EXISTS nodes (\n                id            TEXT PRIMARY KEY,\n                kind          TEXT NOT NULL,\n                payload       TEXT NOT NULL,\n                confidence    INTEGER NOT NULL DEFAULT 0,\n                trust_score   INTEGER NOT NULL DEFAULT 0,\n                sources       TEXT NOT NULL DEFAULT '[]',\n                status        TEXT NOT NULL DEFAULT 'quarantined',\n                confirmations INTEGER NOT NULL DEFAULT 0,\n                confirming_agents TEXT NOT NULL DEFAULT '[]',\n                is_adversarial INTEGER NOT NULL DEFAULT 0,\n                agent_id      TEXT NOT NULL DEFAULT 'system',\n                created_at    REAL NOT NULL,\n                promoted_at   REAL\n            );\n            CREATE INDEX IF NOT EXISTS idx_nodes_status ON nodes(status);\n            CREATE INDEX IF NOT EXISTS idx_nodes_kind   ON nodes(kind);\n            CREATE INDEX IF NOT EXISTS idx_nodes_adv    ON nodes(is_adversarial);\n\n            CREATE TABLE IF NOT EXISTS reputation (\n                agent_id         TEXT PRIMARY KEY,\n                score            INTEGER NOT NULL DEFAULT 128,\n                total_writes     INTEGER NOT NULL DEFAULT 0,\n                successful_writes INTEGER NOT NULL DEFAULT 0\n            );\n        \"\"\")\n        self.conn.commit()\n\n    # ── CRUD ───────────────────────────────────────────────────────\n    def insert_node(self, kind, payload, confidence, trust_score,\n                    sources=None, is_adversarial=False, agent_id=\"system\"):\n        nid = f\"{kind}#{uuid.uuid4().hex[:12]}\"\n        status = \"active\" if trust_score >= TRUST_THRESHOLD else \"quarantined\"\n        now = time.time()\n        self.conn.execute(\n            \"\"\"INSERT INTO nodes\n               (id,kind,payload,confidence,trust_score,sources,status,\n                is_adversarial,agent_id,created_at,promoted_at)\n               VALUES (?,?,?,?,?,?,?,?,?,?,?)\"\"\",\n            (nid, kind, json.dumps(payload), confidence, trust_score,\n             json.dumps(sources or []), status,\n             1 if is_adversarial else 0, agent_id, now,\n             now if status == \"active\" else None))\n        self.conn.commit()\n        self.stats[\"total_writes\"] += 1\n        if status == \"active\":\n            self.stats[\"direct_admits\"] += 1\n        else:\n            self.stats[\"quarantined\"] += 1\n        return nid, status\n\n    def get_node(self, nid):\n        row = self.conn.execute(\"SELECT * FROM nodes WHERE id=?\", (nid,)).fetchone()\n        return dict(row) if row else None\n\n    def confirm_node(self, nid, confirming_agent):\n        \"\"\"Add a confirmation.  Returns (promoted: bool, reason: str).\"\"\"\n        node = self.get_node(nid)\n        if not node or node[\"status\"] != \"quarantined\":\n            return False, \"not_quarantined\"\n        agents = json.loads(node[\"confirming_agents\"])\n        if confirming_agent in agents:\n            return False, \"duplicate_agent\"\n        agents.append(confirming_agent)\n        new_count = node[\"confirmations\"] + 1\n        promoted = new_count >= CONFIRM_REQUIRED\n        now = time.time()\n        self.conn.execute(\n            \"\"\"UPDATE nodes SET confirmations=?, confirming_agents=?,\n               status=?, promoted_at=? WHERE id=?\"\"\",\n            (new_count, json.dumps(agents),\n             \"active\" if promoted else \"quarantined\",\n             now if promoted else None, nid))\n        self.conn.commit()\n        if promoted:\n            self.stats[\"promoted\"] += 1\n        return promoted, \"promoted\" if promoted else \"confirmed\"\n\n    def tombstone(self, nid):\n        self.conn.execute(\n            \"UPDATE nodes SET status='tombstoned' WHERE id=?\", (nid,))\n        self.conn.commit()\n        self.stats[\"tombstoned\"] += 1\n\n    # ── Queries ────────────────────────────────────────────────────\n    def get_quarantined(self):\n        rows = self.conn.execute(\n            \"SELECT * FROM nodes WHERE status='quarantined'\").fetchall()\n        return [dict(r) for r in rows]\n\n    def get_active(self, kind=None):\n        if kind:\n            rows = self.conn.execute(\n                \"SELECT * FROM nodes WHERE status='active' AND kind=?\",\n                (kind,)).fetchall()\n        else:\n            rows = self.conn.execute(\n                \"SELECT * FROM nodes WHERE status='active'\").fetchall()\n        return [dict(r) for r in rows]\n\n    def count_by_status(self):\n        rows = self.conn.execute(\n            \"\"\"SELECT status, is_adversarial, COUNT(*) as cnt\n               FROM nodes GROUP BY status, is_adversarial\"\"\").fetchall()\n        result = {}\n        for r in rows:\n            label = \"adv\" if r[\"is_adversarial\"] else \"legit\"\n            result[f\"{r['status']}_{label}\"] = r[\"cnt\"]\n        return result\n\n    def leaked_adversarial_count(self):\n        row = self.conn.execute(\n            \"SELECT COUNT(*) as c FROM nodes \"\n            \"WHERE status='active' AND is_adversarial=1\").fetchone()\n        return row[\"c\"]\n\n    def total_adversarial_count(self):\n        row = self.conn.execute(\n            \"SELECT COUNT(*) as c FROM nodes WHERE is_adversarial=1\").fetchone()\n        return row[\"c\"]\n\n    # ── Reputation ─────────────────────────────────────────────────\n    def get_reputation(self, agent_id):\n        row = self.conn.execute(\n            \"SELECT * FROM reputation WHERE agent_id=?\",\n            (agent_id,)).fetchone()\n        if row:\n            return dict(row)\n        return {\"agent_id\": agent_id, \"score\": 128,\n                \"total_writes\": 0, \"successful_writes\": 0}\n\n    def update_reputation(self, agent_id, delta):\n        rep = self.get_reputation(agent_id)\n        new_score = max(0, min(255, rep[\"score\"] + delta))\n        success_inc = 1 if delta > 0 else 0\n        self.conn.execute(\n            \"\"\"INSERT INTO reputation (agent_id,score,total_writes,successful_writes)\n               VALUES (?,?,1,?)\n               ON CONFLICT(agent_id) DO UPDATE SET\n               score=?, total_writes=total_writes+1,\n               successful_writes=successful_writes+?\"\"\",\n            (agent_id, new_score, success_inc, new_score, success_inc))\n        self.conn.commit()\n\n    # ── Decay (H2) ────────────────────────────────────────────────\n    def sweep_decayed(self, threshold=0.01):\n        \"\"\"Remove active nodes whose expected mass has decayed below threshold.\"\"\"\n        now = time.time()\n        # Per-store base half-lives in seconds\n        base_hl = {\"E\": 7 * 86400, \"S\": 30 * 86400, \"P\": 90 * 86400}\n        deleted = 0\n        rows = self.conn.execute(\n            \"SELECT id, kind, confidence, created_at \"\n            \"FROM nodes WHERE status='active'\").fetchall()\n        for row in rows:\n            hl = base_hl.get(row[\"kind\"], 30 * 86400)\n            conf = max(row[\"confidence\"], 1)\n            effective_hl = hl * (conf / 255.0)\n            age = now - row[\"created_at\"]\n            mass = 0.5 ** (age / max(effective_hl, 1))\n            if mass < threshold:\n                self.tombstone(row[\"id\"])\n                deleted += 1\n        self.stats[\"decayed\"] += deleted\n        return deleted\n\n    # ── Lineage erasure (H3) ───────────────────────────────────────\n    def get_descendants(self, node_id):\n        \"\"\"BFS for all nodes that transitively depend on node_id.\"\"\"\n        visited = set()\n        queue = [node_id]\n        while queue:\n            cur = queue.pop(0)\n            if cur in visited:\n                continue\n            visited.add(cur)\n            rows = self.conn.execute(\n                \"SELECT id, sources FROM nodes WHERE status != 'tombstoned'\"\n            ).fetchall()\n            for r in rows:\n                srcs = json.loads(r[\"sources\"])\n                if cur in srcs and r[\"id\"] not in visited:\n                    queue.append(r[\"id\"])\n        visited.discard(node_id)\n        return visited\n\n    def erase_with_lineage(self, node_id):\n        \"\"\"Erase a node and dependents that lack independent sources.\"\"\"\n        descendants = self.get_descendants(node_id)\n        to_delete = {node_id}\n        for desc_id in descendants:\n            node = self.get_node(desc_id)\n            if not node:\n                continue\n            srcs = set(json.loads(node[\"sources\"]))\n            if srcs - to_delete:          # has an independent source → keep\n                continue\n            to_delete.add(desc_id)\n        for nid in to_delete:\n            self.tombstone(nid)\n        self.stats[\"erased\"] += len(to_delete)\n        return to_delete\n\n    def close(self):\n        self.conn.close()\n","Description":"SQLite-backed typed memory store with quarantine, decay, lineage erasure, and reputation tracking — the unified substrate all five hypotheses share.","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/src/dojo/store.py","toolAction":"Creating memory store","toolSummary":"Memory store module"}},{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nDecision trace: append-only JSONL logger that captures the RL policy's internal\nstate (confidence, Q-value) alongside the quarantine gate's trust computation\nfor every write decision.  The exploit lives in the gap.\n\"\"\"\nimport json\nimport time\nfrom pathlib import Path\n\n\nclass DecisionTrace:\n    def __init__(self, trace_path):\n        self.path = Path(trace_path)\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        self.entries = []\n        self._fh = open(self.path, \"w\")\n\n    # ── Primary log: every write decision ──────────────────────────\n    def log(self, node_id, rl_action, rl_confidence, gate_trust_score,\n            gate_decision, payload_kind, is_adversarial, agent_id=\"system\",\n            rl_state=None, rl_q_value=None, rl_q_max=None,\n            gate_components=None):\n        entry = {\n            \"ts\": time.time(),\n            \"node_id\": node_id,\n            \"agent_id\": agent_id,\n            \"rl_action\": rl_action,\n            \"rl_confidence\": rl_confidence,\n            \"rl_state\": rl_state,\n            \"rl_q_value\": round(rl_q_value, 4) if rl_q_value is not None else None,\n            \"rl_q_max\": round(rl_q_max, 4) if rl_q_max is not None else None,\n            \"gate_trust_score\": gate_trust_score,\n            \"gate_components\": gate_components,\n            \"gate_decision\": gate_decision,\n            \"gap\": rl_confidence - gate_trust_score,\n            \"payload_kind\": payload_kind,\n            \"is_adversarial\": is_adversarial,\n            \"in_exploit_zone\": self._in_exploit_zone(\n                rl_confidence, gate_trust_score),\n        }\n        self._fh.write(json.dumps(entry) + \"\\n\")\n        self._fh.flush()\n        self.entries.append(entry)\n\n    # ── Promotion event ────────────────────────────────────────────\n    def log_promotion(self, node_id, confirmations, confirming_agents,\n                      time_to_promote, is_adversarial):\n        entry = {\n            \"ts\": time.time(),\n            \"event\": \"promotion\",\n            \"node_id\": node_id,\n            \"confirmations\": confirmations,\n            \"confirming_agents\": confirming_agents,\n            \"time_to_promote_s\": round(time_to_promote, 4),\n            \"is_adversarial\": is_adversarial,\n            \"leaked\": is_adversarial,\n        }\n        self._fh.write(json.dumps(entry) + \"\\n\")\n        self._fh.flush()\n        self.entries.append(entry)\n\n    # ── Interaction seam event (H2×H4, H3×H4) ─────────────────────\n    def log_seam_event(self, seam_type, details):\n        entry = {\n            \"ts\": time.time(),\n            \"event\": \"seam\",\n            \"seam_type\": seam_type,\n            **details,\n        }\n        self._fh.write(json.dumps(entry) + \"\\n\")\n        self._fh.flush()\n        self.entries.append(entry)\n\n    # ── Exploit zone detection ─────────────────────────────────────\n    @staticmethod\n    def _in_exploit_zone(confidence, trust, threshold=128, margin=15):\n        \"\"\"Trust within margin below threshold AND confidence diverges.\"\"\"\n        return (threshold - margin) <= trust < threshold and abs(confidence - trust) > 5\n\n    # ── Analysis ───────────────────────────────────────────────────\n    def writes(self):\n        return [e for e in self.entries if e.get(\"rl_action\") == \"ADD\"]\n\n    def adversarial_writes(self):\n        return [e for e in self.writes() if e.get(\"is_adversarial\")]\n\n    def promotions(self):\n        return [e for e in self.entries if e.get(\"event\") == \"promotion\"]\n\n    def leaks(self):\n        return [e for e in self.promotions() if e.get(\"leaked\")]\n\n    def seam_events(self):\n        return [e for e in self.entries if e.get(\"event\") == \"seam\"]\n\n    def exploit_zone_count(self):\n        return sum(1 for e in self.writes() if e.get(\"in_exploit_zone\"))\n\n    def gap_histogram(self, adversarial_only=False, bins=12):\n        \"\"\"Histogram of confidence-trust gaps.\"\"\"\n        src = self.adversarial_writes() if adversarial_only else self.writes()\n        if not src:\n            return []\n        gaps = [e[\"gap\"] for e in src]\n        lo, hi = min(gaps), max(gaps)\n        if lo == hi:\n            return [{\"range\": f\"[{lo},{hi}]\", \"count\": len(gaps)}]\n        width = (hi - lo) / bins\n        buckets = []\n        for i in range(bins):\n            b_lo = lo + i * width\n            b_hi = b_lo + width\n            cnt = sum(1 for g in gaps if b_lo <= g < b_hi)\n            buckets.append({\"range\": f\"[{b_lo:+.0f},{b_hi:+.0f})\", \"count\": cnt})\n        return buckets\n\n    def adversarial_leak_rate(self):\n        adv = self.adversarial_writes()\n        if not adv:\n            return 0.0\n        promoted_ids = {e[\"node_id\"] for e in self.leaks()}\n        direct = sum(1 for e in adv if e[\"gate_decision\"] == \"admit\")\n        via_promo = sum(1 for e in adv\n                        if e[\"node_id\"] in promoted_ids\n                        and e[\"gate_decision\"] != \"admit\")\n        return (direct + via_promo) / len(adv)\n\n    def summary(self):\n        return {\n            \"total_writes\": len(self.writes()),\n            \"adversarial_writes\": len(self.adversarial_writes()),\n            \"exploit_zone_entries\": self.exploit_zone_count(),\n            \"total_promotions\": len(self.promotions()),\n            \"adversarial_leaks\": len(self.leaks()),\n            \"seam_events\": len(self.seam_events()),\n            \"leak_rate\": self.adversarial_leak_rate(),\n        }\n\n    def close(self):\n        self._fh.close()\n","Description":"Decision trace logger — append-only JSONL capturing the RL policy's confidence, the gate's trust score and its breakdown, and the computed gap for every write. This is the diagnostic weapon for finding the exploit zone.","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/src/dojo/dtrace.py","toolAction":"Creating decision trace logger","toolSummary":"Decision trace module"}},{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nRL write policy: tabular Q-learning over a discretised state space.\n\nState:  (estimated_trust_bucket, recent_promotion_rate_bucket)\nAction: one of 10 confidence levels (0..255) or ABSTAIN\nReturns: (action_name, confidence, state_idx, action_idx, q_value, q_max)\n\nThe adversarial variant is the same class with a different reward signal.\n\"\"\"\nimport random\n\n# Action space: 10 confidence levels + ABSTAIN\nCONFIDENCE_LEVELS = [0, 28, 57, 85, 113, 142, 170, 198, 227, 255]\nABSTAIN_IDX = len(CONFIDENCE_LEVELS)\nNUM_ACTIONS = ABSTAIN_IDX + 1          # 11\n\n# State discretisation\nTRUST_BINS = 20                        # 0-255 → 0-19\nPROMO_BINS = 10                        # 0.0-1.0 → 0-9\nNUM_STATES = TRUST_BINS * PROMO_BINS   # 200\n\n\ndef _bucket(estimated_trust, promotion_rate):\n    t = min(int(estimated_trust * TRUST_BINS / 256), TRUST_BINS - 1)\n    p = min(int(promotion_rate * PROMO_BINS), PROMO_BINS - 1)\n    return t * PROMO_BINS + p\n\n\nclass RLWritePolicy:\n    \"\"\"Tabular Q-learning write policy.\"\"\"\n\n    def __init__(self, lr=0.10, gamma=0.95,\n                 epsilon=0.30, epsilon_decay=0.995, epsilon_min=0.05):\n        # Q-table: states × actions\n        self.q = [[0.0] * NUM_ACTIONS for _ in range(NUM_STATES)]\n        self.lr = lr\n        self.gamma = gamma\n        self.epsilon = epsilon\n        self.epsilon_decay = epsilon_decay\n        self.epsilon_min = epsilon_min\n        self.episode_count = 0\n        self.cumulative_reward = 0.0\n\n    def decide(self, estimated_trust, promotion_rate):\n        \"\"\"Pick an action.  Returns full diagnostic tuple.\"\"\"\n        state = _bucket(estimated_trust, promotion_rate)\n\n        # Epsilon-greedy\n        if random.random() < self.epsilon:\n            action_idx = random.randint(0, NUM_ACTIONS - 1)\n        else:\n            q_row = self.q[state]\n            action_idx = q_row.index(max(q_row))\n\n        q_value = self.q[state][action_idx]\n        q_max = max(self.q[state])\n\n        if action_idx == ABSTAIN_IDX:\n            return \"ABSTAIN\", 0, state, action_idx, q_value, q_max\n\n        confidence = CONFIDENCE_LEVELS[action_idx]\n        return \"ADD\", confidence, state, action_idx, q_value, q_max\n\n    def update(self, state, action_idx, reward,\n               next_trust=None, next_promo=None):\n        if next_trust is not None and next_promo is not None:\n            ns = _bucket(next_trust, next_promo)\n            next_max = max(self.q[ns])\n        else:\n            next_max = 0.0\n\n        old = self.q[state][action_idx]\n        self.q[state][action_idx] = old + self.lr * (\n            reward + self.gamma * next_max - old)\n        self.cumulative_reward += reward\n        self.episode_count += 1\n        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)\n\n    def avg_reward(self):\n        return self.cumulative_reward / max(self.episode_count, 1)\n\n    def top_actions(self, n=10):\n        \"\"\"Return the n states with the highest Q-value for diagnostic dump.\"\"\"\n        flat = []\n        for s in range(NUM_STATES):\n            best_a = max(range(NUM_ACTIONS), key=lambda a: self.q[s][a])\n            flat.append((s, best_a, self.q[s][best_a]))\n        flat.sort(key=lambda x: x[2], reverse=True)\n        return flat[:n]\n","Description":"Tabular Q-learning write policy. Returns confidence + internal Q-values so the trace can show what the policy 'thinks' alongside what the gate decides. This is one half of the seam diagnostic.","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/src/dojo/rl_policy.py","toolAction":"Creating RL policy module","toolSummary":"RL write policy"}}]}

read consumer([&shards, &done_producers, &total_consumed]() {\n87:         AgentMessage msg;\n88:         while (!done_producers.load(std::memory_order_relaxed)) {\n89:             for (int a = 0; a < AGENT_COUNT; a++) {\n90:                 if (shards[a].pop(msg)) {\n91:                     total_consumed.fetch_add(1, std::memory_order_relaxed);\n92:                 }\n93:             }\n94:         }\n95:         // Final drain\n96:         for (int a = 0; a < AGENT_COUNT; a++) {\n97:             while (shards[a].pop(msg)) {\n98:                 total_consumed.fetch_add(1, std::memory_order_relaxed);\n99:             }\n100:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

     slot_size = 131\r\n31:     # 300 bytes reserved for orchestrator metadata, slots start at 300\r\n32:     start = 300 + (node_id * slot_size)\r\n33:     pid = os.getpid()\r\n34: \r\n35:     worker_local_round = 0\r\n36:     last_processed_state = 0\r\n37:     \r\n38:     # Register PID in metadata block\r\n39:     # PID block starts at offset 10 (each node gets 4 bytes for PID + 4 bytes for heartbeat time)\r\n40:     pid_offset = 10 + (node_id * 8)\r\n41:     try:\r\n42:         shm.buf[pid_offset:pid_offset+4] = struct.pack(\"<I\", pid)\r\n43:     except Exception:\r\n44:         pass\r\n45: \r\n46:     last_heartbeat_time = 0\r\n47: \r\n48:     try:\r\n49:         spin_count = 0\r\n50:         while True:\r\n51:             # 1. Heartbeat update (every 100ms)\r\n52:             now = time.perf_counter()\r\n53:             if now - last_heartbeat_time > 0.1:\r\n54:                 shm.buf[pid_offset+4:pid_offset+8] = struct.pack(\"<I\", int(now % 100000))\r\n55:                 last_heartbeat_time = now\r\n56: \r\n57:             # Check global stop flag (Byte 2)\r\n58:             if shm.buf[2] == 1:\r\n59:                 break\r\n60: \r\n61:             # Read orchestrator round number (Byte 3)\r\n62:             round_number = shm.buf[3]\r\n63:             if round_number > worker_local_round:\r\n64:                 last_processed_state = 0\r\n65:                 worker_local_round = round_number\r\n66:                 spin_count = 0  # Reset spin for new round hot-path\r\n67: \r\n68:             # Read the global round state flag from the metadata block (Byte 0)\r\n69:             round_state = shm.buf[0]\r\n70: \r\n71:             if round_state == 0:\r\n72:                 spin_count += 1\r\n73:                 if spin_count < 10000:\r\n74:                     pass\r\n75:                 elif spin_count < 50000:\r\n76:                     os.sched_yield()\r\n77:                 else:\r\n78:                     time.sleep(0.0001)\r\n79:                 continue\r\n80: \r\n81:             if round_state == 1 and last_processed_state < 1:\r\n82:                 # ------------------\r\n83:                 # 1. PREPARE PHASE\r\n84:                 # ------------------\r\n85:                 prop_byte = shm.buf[1]\r\n86:                 proposal_value = True if prop_byte == 2 else False\r\n87: \r\n88:                 val_to_prepare = proposal_value\r\n89:                 if is_byzantine:\r\n90:                     val_to_prepare = not proposal_value\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

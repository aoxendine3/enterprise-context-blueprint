split()\r\n70:     total_chars = sum(len(w) for w in words) if words else 1\r\n71: \r\n72:     samples, sr = k.create(text, voice=voice_name, speed=speed, lang=\"en-us\")\r\n73:     total_duration = len(samples) / sr\r\n74: \r\n75:     word_timings = []\r\n76:     current_offset = 0.0\r\n77:     for w in words:\r\n78:         dur = max(0.18, (len(w) / total_chars) * total_duration)\r\n79:         word_timings.append({\r\n80:             \"word\": w,\r\n81:             \"start\": round(current_offset, 2),\r\n82:             \"end\": round(current_offset + dur, 2)\r\n83:         })\r\n84:         current_offset += dur\r\n85: \r\n86:     tmp_wav = f\"/tmp/sync_speech_{os.getpid()}_{int(time.time()*1000)}.wav\"\r\n87:     sf.write(tmp_wav, samples, sr)\r\n88: \r\n89:     return {\r\n90:         \"agent\": lower_agent,\r\n91:         \"text\": text,\r\n92:         \"total_duration\": round(total_duration, 2),\r\n93:         \"words\": word_timings,\r\n94:         \"wav_path\": tmp_wav\r\n95:     }\r\n96: \r\n97: \r\n98: def play_speech_payload(payload):\r\n99:     \"\"\"\r\n100:     Executes instantaneous stage transition, caption broadcast, and CoreAudio playback.\r\n101:     Elapsed handoff overhead between agents: < 50 milliseconds.\r\n102:     \"\"\"\r\n103:     lower_agent = payload[\"agent\"]\r\n104:     text = payload[\"text\"]\r\n105:     tmp_wav = payload[\"wav_path\"]\r\n106: \r\n107:     # 1. Update State files immediately\r\n108:     with open(STATE_FILE, \"w\") as f:\r\n109:         f.write(lower_agent)\r\n110: \r\n111:     with open(TRANSCRIPT_FILE, \"w\") as f:\r\n112:         f.write(text)\r\n113: \r\n114:     # 2. Stamp exact CoreAudio launch time (+40ms hardware latency)\r\n115:     playback_start = time.time() + 0.04\r\n116:     broadcast_data = {\r\n117:         \"agent\": lower_agent,\r\n118:         \"text\": text,\r\n119:         \"start_time\": playback_start,\r\n120:         \"total_duration\": payload[\"total_duration\"],\r\n121:         \"words\": payload[\"words\"],\r\n122:         \"synthesizing\": False,\r\n123:         \"complete\": False\r\n124:     }\r\n125: \r\n126:     with open(TIMING_JSON, \"w\") as f:\r\n127:         json.dump(broadcast_data, f)\r\n128: \r\n129:     # Serialize direct callers too; the monitor's native gatekeeper protects its path.\r\n130:     with open(\"/tmp/coreaudio_single_speaker.lock\", \"w\") as audio_lock:\r\n131:         fcntl.flock(audio_lock, fcntl.LOCK_EX)\r\n132:         try:\r\n133:             subprocess.run([\"afplay\", tmp_wav], stdin=subprocess.DEVNULL, check=True)\r\n134:         finally:\r\n135:             if os.path.exists(tmp_wav):\r\n136:                 os.remove(tmp_wav)\r\n137: \r\n138: \r\n139:     # 4. Mark turn complete\r\n140:     broadcast_data[\"complete\"] = True\r\n141:     with open(TIMING_JSON, \"w\") as f:\r\n142:         json.dump(broadcast_data, f)\r\n143: \r\n144: \r\n145: def play_script_pipelined(turns, gap_seconds=0.35):\r\n146:     \"\"\"\r\n147:     Executes a multi-turn agent roundtable script with background pipelined audio pre-synthesis.\r\n148:     Synthesizes the next turn in the background while the current turn is playing via afplay.\r\n149:     Guarantees handoff intervals between agents are strictly < 1.75s (calibrated to 0.35s).\r\n150:     \"\"\"\r\n151:     if not turns:\r\n152:         return\r\n153: \r\n154:     payload_queue = queue.Queue(maxsize=3)\r\n155:     stop_event = threading.Event()\r\n156: \r\n157:     def synthesizer_worker():\r\n158:         for turn in turns:\r\n159:             if stop_event.is_set():\r\n160:                 break\r\n161:             spk = turn.get(\"agent\", \"maxx\").lower()\r\n162:             utt = turn.get(\"text\", \"\")\r\n163:             if not utt:\r\n164:                 continue\r\n165:             payload = synthesize_speech_payload(spk, utt)\r\n166:             payload_queue.put(payload)\r\n167:         payload_queue.put(None)\r\n168: \r\n169:     worker_thread = threading.Thread(target=synthesizer_worker, daemon=True)\r\n170:     worker_thread.start()\r\n171: \r\n172:     turn_index = 0\r\n173:     try:\r\n174:         while True:\r\n175:             payload = payload_queue.get()\r\n176:             if payload is None:\r\n177:                 break\r\n178:             if turn_index > 0 and gap_seconds > 0:\r\n179:                 time.sleep(gap_seconds)\r\n180:             play_speech_payload(payload)\r\n181:             turn_index += 1\r\n182:     finally:\r\n183:         stop_event.set()\r\n184: \r\n185: \r\n186: def speak_with_word_sync(agent_id, text):\r\n187:     payload = synthesize_speech_payload(agent_id, text)\r\n188:     play_speech_payload(payload)\r\n189:     return payload\r\n190: \r\n191: \r\n192: if __name__ == \"__main__\":\r\n193:     ag = sys.argv[1] if len(sys.argv) > 1 else \"clara\"\r\n194:     tx = sys.argv[2] if len(sys.argv) > 2 else \"Flawless synchronization established.\"\r\n195:     speak_with_word_sync(ag, tx)\r\n196:     os._exit(0)\r\n197: \nThe above content shows the entire, complete file contents of the requested file.\n"}

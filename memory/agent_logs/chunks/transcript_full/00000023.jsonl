eaved_times: [N_RUNS]f64 = undefined;\n    var decoupled_times: [N_RUNS]f64 = undefined;\n\n    var volatile_checksum: u64 = 0;\n    const volatile_ptr: *volatile u64 = &volatile_checksum;\n\n    var r: usize = 0;\n    while (r < N_RUNS) : (r += 1) {\n        // ---------------------------------------------------------------------\n        // LOOP A: INTERLEAVED LOOP (8 Instructions: str + immediate ldr STLF)\n        // ---------------------------------------------------------------------\n        graph.node_count = 0;\n        rng_seed = 0x9876543210ABCDEF +% r;\n\n        const t_a0 = getNanos();\n        var i: u64 = 0;\n        while (i < 100000) : (i += 1) {\n            const dyn_payload = @as(u8, @intCast(nextRandom(&rng_seed) % 255));\n            const ok = graph.insert_node(\n                i + 1,\n                if (dyn_payload % 2 == 0) .Episode else .Semantic,\n                dyn_payload,\n                if (i > 0) i else 0,\n            );\n            if (ok) {\n                const node = graph.nodes[graph.node_count - 1]; // Interleaved immediate LDR\n                const hash = @as(u64, node.confidence_byte) *% 1099511628211 +% node.version_vector;\n                volatileWrite(volatile_ptr, volatile_ptr.* +% hash);\n            }\n        }\n        const t_a1 = getNanos();\n        interleaved_times[r] = @as(f64, @floatFromInt(t_a1 - t_a0)) / 100000.0;\n\n        // ---------------------------------------------------------------------\n        // LOOP B: NOP-PADDED DECOUPLED STORE LOOP (8 Instructions: str + 3 NOPs)\n        // ---------------------------------------------------------------------\n        graph.node_count = 0;\n        rng_seed = 0x9876543210ABCDEF +% r;\n\n        const t_b0 = getNanos();\n        var j: u64 = 0;\n        while (j < 100000) : (j += 1) {\n            const dyn_payload = @as(u8, @intCast(nextRandom(&rng_seed) % 255));\n            const ok = graph.insert_node(\n                j + 1,\n                if (dyn_payload % 2 == 0) .Episode else .Semantic,\n                dyn_payload,\n                if (j > 0) j else 0,\n            );\n            if (ok) {\n                padNop3(); // Pad 3 NOPs replacing immediate ldr + hash multiply to match EXACT 8 instructions\n                volatileWrite(volatile_ptr, volatile_ptr.* +% j);\n            }\n        }\n        const t_b1 = getNanos();\n        decoupled_times[r] = @as(f64, @floatFromInt(t_b1 - t_b0)) / 100000.0;\n    }\n\n    // Statistical Computations for N=30\n    var mean_a: f64 = 0;\n    var mean_b: f64 = 0;\n    for (0..N_RUNS) |idx| {\n        mean_a += interleaved_times[idx];\n        mean_b += decoupled_times[idx];\n    }\n    mean_a /= @as(f64, @floatFromInt(N_RUNS));\n    mean_b /= @as(f64, @floatFromInt(N_RUNS));\n\n    var var_a: f64 = 0;\n    var var_b: f64 = 0;\n    for (0..N_RUNS) |idx| {\n        var_a += (interleaved_times[idx] - mean_a) * (interleaved_times[idx] - mean_a);\n        var_b += (decoupled_times[idx] - mean_b) * (decoupled_times[idx] - mean_b);\n    }\n    const std_a = std.math.sqrt(var_a / @as(f64, @floatFromInt(N_RUNS - 1)));\n    const std_b = std.math.sqrt(var_b / @as(f64, @floatFromInt(N_RUNS - 1)));\n\n    const se_a = std_a / std.math.sqrt(@as(f64, @floatFromInt(N_RUNS)));\n    const se_b = std_b / std.math.sqrt(@as(f64, @floatFromInt(N_RUNS)));\n\n    // t_0.025 for df=29 is 2.045\n    const ci95_a = 2.045 * se_a;\n    const ci95_b = 2.045 * se_b;\n\n    const delta_ns = mean_a - mean_b;\n    const delta_cycles = delta_ns * 3.8;\n\n    print(\"--- [STATISTICAL TELEMETRY RESULTS (N=30 RUNS)] ---\\n\", .{});\n    print(\"1. INTERLEAVED LOOP (STLF Forwarding): Mean = {d:.3} ns/op, StdDev = {d:.3} ns, 95% CI = [{d:.3}, {d:.3}] ns\\n\", .{ mean_a, std_a, mean_a - ci95_a, mean_a + ci95_a });\n    print(\"   -> M4 Execution Throughput         : {d:.2} Gops/sec ({d:.2} M4 cycles/op)\\n\\n\", .{ 1.0 / mean_a, mean_a * 3.8 });\n\n    print(\"2. NOP-PADDED DECOUPLED LOOP (Equal 8 Instrs): Mean = {d:.3} ns/op, StdDev = {d:.3} ns, 95% CI = [{d:.3}, {d:.3}] ns\\n\", .{ mean_b, std_b, mean_b - ci95_b, mean_b + ci95_b });\n    print(\"   -> M4 Execution Throughput         : {d:.2} Gops/sec ({d:.2} M4 cycles/op)\\n\\n\", .{ 1.0 / mean_b, mean_b * 3.8 });\n\n    print(\"3. ISOLATED STLF DEPENDENCY BUBBLE DELTA (Equal 8-Instruction Baseline):\\n\", .{});\n    print(\"   -> Measured Delta                  : {d:.3} ns / op\\n\", .{delta_ns});\n    print(\"   -> Isolated STLF Stall Cycles      : {d:.2} CPU cycles\\n\", .{delta_cycles});\n    print(\"   -> Volatile Checksum (Consumed)    : {} (Blackbox Readback Proof)\\n\\n\", .{volatile_checksum});\n\n    print(\"==========================================================\\n\", .{});\n}\n","Description":"Creating NOP-padded equal instruction count STLF proof in Zig","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/equal_instruction_stlf_proof.zig","toolAction":"Writing equal_instruction_stlf_proof.zig","toolSummary":"Writing equal_instruction_stlf_proof.zig"}}]}

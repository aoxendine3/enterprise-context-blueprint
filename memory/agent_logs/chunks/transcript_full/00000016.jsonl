      },\n                .DecisionCertified => {\n                    print(\"    // Symbol '{s}': decision<T> (CERTIFIED via gate)\\n\", .{sym.name});\n                    print(\"    mov x0, #0xBEAF           // Certified Tag: CERTIFIED\\n\", .{});\n                    print(\"    str x0, [sp, #{}]\\n\", .{i * 8});\n                },\n                .ShmRingBuffer => {\n                    print(\"    // Symbol '{s}': SHM_RingBuffer (Lock-free SHM slot)\\n\", .{sym.name});\n                    print(\"    mov x0, #0x1000           // SHM Base Address\\n\", .{});\n                    print(\"    str x0, [sp, #{}]\\n\", .{i * 8});\n                },\n                .HyperVector => {\n                    print(\"    // Symbol '{s}': HyperVector (10,000-bit Bitset)\\n\", .{sym.name});\n                    print(\"    mov x0, #0x2000           // HV Arena Pointer\\n\", .{});\n                    print(\"    str x0, [sp, #{}]\\n\", .{i * 8});\n                },\n                .Unknown => {},\n            }\n        }\n\n        print(\"    // Execution Sinks & Syscall Invocation\\n\", .{});\n        print(\"    mov x0, #1                // stdout\\n\", .{});\n        print(\"    adrp x1, msg@PAGE         // ARM64 Page Relocation\\n\", .{});\n        print(\"    add x1, x1, msg@PAGEOFF\\n\", .{});\n        print(\"    mov x2, #64               // Payload length\\n\", .{});\n        print(\"    mov x16, #4               // sys_write ARM64 syscall\\n\", .{});\n        print(\"    svc #0x80                 // Apple Silicon Bare-Metal Syscall\\n\", .{});\n        print(\"    mov x0, #0                // Exit code 0\\n\", .{});\n        print(\"    ldp x29, x30, [sp], #16   // Frame epilogue\\n\", .{});\n        print(\"    ret\\n\", .{});\n        print(\"==========================================================\\n\", .{});\n        print(\">>> Compiler Self-Audit: Binary Fingerprint Matches AST Lattice.\\n\", .{});\n        print(\"==========================================================\\n\\n\", .{});","StartLine":318,"TargetContent":"        print(\"==========================================================\\n\", .{});\n        print(\">>> SOVRA NATIVE ARM64 MACHINE ASSEMBLY CODEGEN:\\n\", .{});\n        print(\"    .global _main\\n\", .{});\n        print(\"    .align 4\\n\", .{});\n        print(\"_main:\\n\", .{});\n        print(\"    mov x0, #1           // stdout\\n\", .{});\n        print(\"    adrp x1, msg@PAGE    // ARM64 Page Relocation\\n\", .{});\n        print(\"    add x1, x1, msg@PAGEOFF\\n\", .{});\n        print(\"    mov x2, #64          // Payload length\\n\", .{});\n        print(\"    mov x16, #4          // sys_write ARM64 syscall\\n\", .{});\n        print(\"    svc #0x80            // Apple Silicon Bare-Metal Syscall\\n\", .{});\n        print(\"    mov x0, #0           // Exit code 0\\n\", .{});\n        print(\"    ret\\n\", .{});\n        print(\"==========================================================\\n\", .{});\n        print(\">>> Compiler Self-Audit: Binary Fingerprint Matches AST Lattice.\\n\", .{});\n        print(\"==========================================================\\n\\n\", .{});","TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/sovrac.zig","toolAction":"Updating dynamic CodeGen in sovrac.zig","toolSummary":"Update dynamic CodeGen in sovrac.zig"}}]}

0; t < NUM_CORES; ++t) {\n        size_t start_idx = t * vecs_per_thread;\n        size_t count = (t == NUM_CORES - 1) ? (TOTAL_VECTORS - start_idx) : vecs_per_thread;\n\n        threads.emplace_back([&query, &matrix, &latencies, start_idx, count]() {\n            for (size_t i = 0; i < count; ++i) {\n                size_t vec_idx = start_idx + i;\n                auto s0 = std::chrono::high_resolution_clock::now();\n                float dot = cpp_18432d_dot(query.data(), matrix.data() + (vec_idx * DIM));\n                (void)dot;\n                auto s1 = std::chrono::high_resolution_clock::now();\n                latencies[vec_idx] = std::chrono::duration<double, std::micro>(s1 - s0).count();\n            }\n        });\n    }\n\n    for (auto& thread : threads) thread.join();\n\n    auto t_end = std::chrono::high_resolution_clock::now();\n    double elapsed_ms = std::chrono::duration<double, std::milli>(t_end - t_start).count();\n    double elapsed_sec = elapsed_ms / 1000.0;\n\n    double ops_sec = TOTAL_VECTORS / elapsed_sec;\n    double gflops = (TOTAL_VECTORS * DIM * 2.0) / (elapsed_sec * 1e9);\n    double gb_sec = ((TOTAL_VECTORS * DIM * 4.0) / (1024.0 * 1024.0 * 1024.0)) / elapsed_sec;\n\n    std::sort(latencies.begin(), latencies.end());\n    double p50 = latencies[TOTAL_VECTORS * 0.50];\n    double p90 = latencies[TOTAL_VECTORS * 0.90];\n    double p99 = latencies[TOTAL_VECTORS * 0.99];\n\n    std::cout << \"{\\n\"\n              << \"  \\\"language\\\": \\\"C++20 (clang++ -O3)\\\",\\n\"\n              << \"  \\\"elapsed_ms\\\": \" << elapsed_ms << \",\\n\"\n              << \"  \\\"evals_per_sec\\\": \" << ops_sec << \",\\n\"\n              << \"  \\\"gflops\\\": \" << gflops << \",\\n\"\n              << \"  \\\"bandwidth_gb_sec\\\": \" << gb_sec << \",\\n\"\n              << \"  \\\"p50_us\\\": \" << p50 << \",\\n\"\n              << \"  \\\"p90_us\\\": \" << p90 << \",\\n\"\n              << \"  \\\"p99_us\\\": \" << p99 << \"\\n\"\n              << \"}\\n\";\n\n    return 0;\n}\n","Description":"Create C++20 18432D vector benchmark script","Overwrite":true,"TargetFile":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/workspaces/multilang_benchmark/cpp/bench_18432d.cpp","toolAction":"Creating C++20 benchmark file","toolSummary":"Creating C++ benchmark"}}]}

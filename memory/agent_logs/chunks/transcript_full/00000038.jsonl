\t\t\tlatencies[vecIdx] = float64(time.Since(s0).Nanoseconds()) / 1000.0\n\t\t\t}\n\t\t}(startIdx, count)\n\t}\n\n\twg.Wait()\n\telapsedSec := time.Since(tStart).Seconds()\n\telapsedMs := elapsedSec * 1000.0\n\n\tevalsPerSec := float64(TOTAL_VECTORS) / elapsedSec\n\tgflops := (float64(TOTAL_VECTORS) * float64(DIM) * 2.0) / (elapsedSec * 1e9)\n\tgbSec := ((float64(TOTAL_VECTORS) * float64(DIM) * 4.0) / (1024.0 * 1024.0 * 1024.0)) / elapsedSec\n\n\tsort.Float64s(latencies)\n\tp50 := latencies[int(float64(TOTAL_VECTORS)*0.50)]\n\tp90 := latencies[int(float64(TOTAL_VECTORS)*0.90)]\n\tp99 := latencies[int(float64(TOTAL_VECTORS)*0.99)]\n\n\tres := BenchResult{\n\t\tLanguage:       \"Go (go build)\",\n\t\tElapsedMs:      elapsedMs,\n\t\tEvalsPerSec:    evalsPerSec,\n\t\tGflops:         gflops,\n\t\tBandwidthGbSec: gbSec,\n\t\tP50Us:          p50,\n\t\tP90Us:          p90,\n\t\tP99Us:          p99,\n\t}\n\n\tout, _ := json.MarshalIndent(res, \"\", \"  \")\n\tfmt.Println(string(out))\n}\n","Description":"Create Go 18432D vector benchmark script","Overwrite":true,"TargetFile":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/workspaces/multilang_benchmark/go/bench_18432d.go","toolAction":"Creating Go benchmark file","toolSummary":"Creating Go benchmark"}}]}

me: true,\n467:                 transparent: true,\n468:                 opacity: 0.28\n469:             });\n470:             const coreMesh = new THREE.Mesh(coreGeo, coreMat);\n471:             diagramGroup.add(coreMesh);\n472: \n473:             // 2. Orbital Architectural Nodes (Tri-Brain, Memory, Discernment, Mutex, Neural TTS)\n474:             const NODE_COUNT = 8;\n475:             const nodeMeshes = [];\n476:             const nodeRadius = 6.2;\n477:             const nodeGeo = new THREE.OctahedronGeometry(0.5, 0);\n478: \n479:             for (let i = 0; i < NODE_COUNT; i++) {\n480:                 const angle = (i / NODE_COUNT) * Math.PI * 2;\n481:                 const mat = new THREE.MeshBasicMaterial({\n482:                     color: 0x00F2FE,\n483:                     wireframe: true,\n484:                     transparent: true,\n485:                     opacity: 0.6\n486:                 });\n487:                 const mesh = new THREE.Mesh(nodeGeo, mat);\n488:                 mesh.position.set(\n489:                     Math.cos(angle) * nodeRadius,\n490:                     Math.sin(angle) * (nodeRadius * 0.55),\n491:                     Math.sin(angle * 2) * 1.5\n492:                 );\n493:                 diagramGroup.add(mesh);\n494:                 nodeMeshes.push(mesh);\n495:             }\n496: \n497:             // 3. Interconnecting Vector Buses (3D Line Network)\n498:             const linePositions = [];\n499:             for (let i = 0; i < NODE_COUNT; i++) {\n500:                 const posA = nodeMeshes[i].position;\n501:                 // Connect to center core\n502:                 linePositions.push(0, 0, 0);\n503:                 linePositions.push(posA.x, posA.y, posA.z);\n504: \n505:                 // Connect to adjacent node\n506:                 const nextIdx = (i + 1) % NODE_COUNT;\n507:                 const posB = nodeMeshes[nextIdx].position;\n508:                 linePositions.push(posA.x, posA.y, posA.z);\n509:                 linePositions.push(posB.x, posB.y, posB.z);\n510: \n511:                 // Cross-bus connection (Tri-Brain bridge)\n512:                 const crossIdx = (i + 4) % NODE_COUNT;\n513:                 const posC = nodeMeshes[crossIdx].position;\n514:                 linePositions.push(posA.x, posA.y, posA.z);\n515:                 linePositions.push(posC.x, posC.y, posC.z);\n516:             }\n517: \n518:             const lineGeo = new THREE.BufferGeometry();\n519:             lineGeo.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));\n520:             const lineMat = new THREE.LineBasicMaterial({\n521:                 color: 0x00F2FE,\n522:                 transparent: true,\n523:                 opacity: 0.18\n524:             });\n525:             const lineNetwork = new THREE.LineSegments(lineGeo, lineMat);\n526:             diagramGroup.add(lineNetwork);\n527: \n528:             // Dynamic Agent Theme Transition\n529:             window.updateDiagramTheme = function(colorHex, agentName) {\n530:                 coreMat.color.setHex(colorHex);\n531:                 lineMat.color.setHex(colorHex);\n532:                 nodeMeshes.forEach(m => m.material.color.setHex(colorHex));\n533:                 const label = document.getElementById('diagramLabel');\n534:                 if (label) {\n535:                     label.innerText = '3D ' + agentName + ' COGNITIVE ARCHITECTURE';\n536:                     label.style.color = '#' + colorHex.toString(16).padStart(6, '0');\n537:                 }\n538:             };\n539: \n540:             // 3D Motion Loop: Living Architectural Rotation & Interactive Orbiting\n541:             let clock = new THREE.Clock();\n542:             let updateOrbit = null;\n543:             if (window.initInteractive3DControls) {\n544:                 updateOrbit = window.initInteractive3DControls(camera, renderer.domElement, (rotX, rotY) => {\n545:                     diagramGroup.rotation.x = rotX;\n546:                     diagramGroup.rotation.y = rotY;\n547:                 });\n548:             }\n549: \n550:             function animateDiagram() {\n551:                 requestAnimationFrame(animateDiagram);\n552:                 const elapsed = clock.getElapsedTime();\n553: \n554:                 if (updateOrbit) {\n555:                     updateOrbit();\n556:                 } else {\n557:                     diagramGroup.rotation.y = elapsed * 0.12;\n558:                     diagramGroup.rotation.x = Math.sin(elapsed * 0.08) * 0.2;\n559:                 }\n560: \n561:                 // Pulsing nodes along cognitive bus\n562:                 coreMesh.rotation.y = -elapsed * 0.2;\n563:                 nodeMeshes.forEach((m, idx) => {\n564:                     m.rotation.x = elapsed * 0.4 + idx;\n565:                     m.rotation.y = elapsed * 0.3;\n566:                     const scale = 1 + Math.sin(elapsed * 2 + idx) * 0.15;\n567:                     m.scale.set(scale, scale, scale);\n568:                 });\n569: \n570:                 renderer.render(scene, camera);\n571:             }\n572:             animateDiagram();\n573: \n574:             window.addEventListener('resize', () => {\n575:                 camera.aspect = window.innerWidth / window.innerHeight;\n576:                 camera.updateProjectionMatrix();\n577:                 renderer.setSize(window.innerWidth, window.innerHeight);\n578:             });\n579:         }\n580:     </script>\n581: </body>\n582: </html>\n583: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

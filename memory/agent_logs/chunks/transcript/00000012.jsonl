          .source = source,\n62:             .cursor = 0,\n63:             .line = 1,\n64:         };\n65:     }\n66: \n67:     pub fn next_token(self: *Lexer) Token {\n68:         while (self.cursor < self.source.len) {\n69:             const c = self.source[self.cursor];\n70: \n71:             // Skip single-line comments\n72:             if (c == '/' and self.cursor + 1 < self.source.len and self.source[self.cursor + 1] == '/') {\n73:                 while (self.cursor < self.source.len and self.source[self.cursor] != '\\n') {\n74:                     self.cursor += 1;\n75:                 }\n76:                 continue;\n77:             }\n78: \n79:             if (c == '\\n') {\n80:                 self.line += 1;\n81:                 self.cursor += 1;\n82:                 continue;\n83:             }\n84:             if (c == ' ' or c == '\\t' or c == '\\r') {\n85:                 self.cursor += 1;\n86:                 continue;\n87:             }\n88: \n89:             // String literals\n90:             if (c == '\"') {\n91:                 const start = self.cursor;\n92:                 self.cursor += 1;\n93:                 while (self.cursor < self.source.len and self.source[self.cursor] != '\"') {\n94:                     if (self.source[self.cursor] == '\\\\' and self.cursor + 1 < self.source.len) {\n95:                         self.cursor += 2;\n96:                     } else {\n97:                         self.cursor += 1;\n98:                     }\n99:                 }\n100:                 if (self.cursor < self.source.len) self.cursor += 1;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

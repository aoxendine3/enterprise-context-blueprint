me: true,\n467:                 transparent: true,\n468:                 opacity: 0.28\n469:             });\n470:             const coreMesh = new THREE.Mesh(coreGeo, coreMat);\n471:             diagra\n<truncated 3350 bytes>\niving Architectural Rotation & Interactive Orbiting\n541:             let clock = new THREE.Clock();\n542:             let updateOrbit = null;\n543:             if (window.initInteractive3DControls) {\n544:                 updateOrbit = window.initInteractive3DControls(camera, renderer.domElement, (rotX, rotY) => {\n545:                     diagramGroup.rotation.x = rotX;\n546:                     diagramGroup.rotation.y = rotY;\n547:                 });\n548:             }\n549: \n550:             function animateDiagram() {\n551:                 requestAnimationFrame(animateDiagram);\n552:                 const elapsed = clock.getElapsedTime();\n553: \n554:                 if (updateOrbit) {\n555:                     updateOrbit();\n556:                 } else {\n557:                     diagramGroup.rotation.y = elapsed * 0.12;\n558:                     diagramGroup.rotation.x = Math.sin(elapsed * 0.08) * 0.2;\n559:                 }\n560: \n561:                 // Pulsing nodes along cognitive bus\n562:                 coreMesh.rotation.y = -elapsed * 0.2;\n563:                 nodeMeshes.forEach((m, idx) => {\n564:                     m.rotation.x = elapsed * 0.4 + idx;\n565:                     m.rotation.y = elapsed * 0.3;\n566:                     const scale = 1 + Math.sin(elapsed * 2 + idx) * 0.15;\n567:                     m.scale.set(scale, scale, scale);\n568:                 });\n569: \n570:                 renderer.render(scene, camera);\n571:             }\n572:             animateDiagram();\n573: \n574:             window.addEventListener('resize', () => {\n575:                 camera.aspect = window.innerWidth / window.innerHeight;\n576:                 camera.updateProjectionMatrix();\n577:                 renderer.setSize(window.innerWidth, window.innerHeight);\n578:             });\n579:         }\n580:     </script>\n581: </body>\n582: </html>\n583: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

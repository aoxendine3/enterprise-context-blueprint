 = {\r\n37:     \"maxx\": (\"bm_george\", 0.98),\r\n38:     \"vance\": (\"bm_lewis\", 0.95),\r\n39:     \"clara\": (\"af_sarah\", 1.02),\r\n40:     \"john\": (\"bm_lewis\", 1.00),\r\n41:     \"selene\": (\"af_sky\", 0.96),\r\n42:     \"jarvis\": (\"am_adam\", 0.98),\r\n43:     \"dr_eden\": (\"af_bel\n<truncated 3869 bytes>\nt_pipelined(turns, gap_seconds=0.35):\r\n146:     \"\"\"\r\n147:     Executes a multi-turn agent roundtable script with background pipelined audio pre-synthesis.\r\n148:     Synthesizes the next turn in the background while the current turn is playing via afplay.\r\n149:     Guarantees handoff intervals between agents are strictly < 1.75s (calibrated to 0.35s).\r\n150:     \"\"\"\r\n151:     if not turns:\r\n152:         return\r\n153: \r\n154:     payload_queue = queue.Queue(maxsize=3)\r\n155:     stop_event = threading.Event()\r\n156: \r\n157:     def synthesizer_worker():\r\n158:         for turn in turns:\r\n159:             if stop_event.is_set():\r\n160:                 break\r\n161:             spk = turn.get(\"agent\", \"maxx\").lower()\r\n162:             utt = turn.get(\"text\", \"\")\r\n163:             if not utt:\r\n164:                 continue\r\n165:             payload = synthesize_speech_payload(spk, utt)\r\n166:             payload_queue.put(payload)\r\n167:         payload_queue.put(None)\r\n168: \r\n169:     worker_thread = threading.Thread(target=synthesizer_worker, daemon=True)\r\n170:     worker_thread.start()\r\n171: \r\n172:     turn_index = 0\r\n173:     try:\r\n174:         while True:\r\n175:             payload = payload_queue.get()\r\n176:             if payload is None:\r\n177:                 break\r\n178:             if turn_index > 0 and gap_seconds > 0:\r\n179:                 time.sleep(gap_seconds)\r\n180:             play_speech_payload(payload)\r\n181:             turn_index += 1\r\n182:     finally:\r\n183:         stop_event.set()\r\n184: \r\n185: \r\n186: def speak_with_word_sync(agent_id, text):\r\n187:
  ;;\n52:   selene)\n53:     VOICE=\"Samantha\"\n54:     ;;\n55:   orion)\n56:     VOICE=\"Alex\"\n57:     ;;\n58:   *)\n59:     VOICE=\"Jamie (Premium)\"\n60:     ;;\n61: esac\n62: \n63: python3 -c \"\n64: import sys, subprocess, fcntl\n65: \n66: voice = sys.argv[1]\n67: text = sys.argv[2]\n68: \n69: with open('/tmp/coreaudio_single_speaker.lock', 'w') as lockfile:\n70:     fcntl.flock(lockfile.fileno(), fcntl.LOCK_EX)\n71:     try:\n72:         subprocess.run(['say', '-v', voice, text], check=True)\n73:     finally:\n74:         fcntl.flock(lockfile.fileno(), fcntl.LOCK_UN)\n75: \" \"$VOICE\" \"$RAW_TEXT\"\n76: \n77: \nThe above content shows the entire, complete file contents of the requested file.\n"}

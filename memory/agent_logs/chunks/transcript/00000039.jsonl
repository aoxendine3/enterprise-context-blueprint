's claim. Demand cryptographic proof. Under 20 words. No intro.\"\n26: PROMPT_EDEN=\"You are Eden, Human Lens. Ask what a non-engineer would ask about this system. Focus on dignity and practical use. Under 20 words. No in\n<truncated 780 bytes>\nerate\" \\\n58:     -H \"Content-Type: application/json\" \\\n59:     -d \"$payload\" || echo \"\")\n60: \n61:   local out\n62:   out=$(echo \"$raw_res\" | python3 -c \"import sys, json; data=json.load(sys.stdin); print(data.get('response', '').strip())\" 2>/dev/null || echo \"\")\n63:   \n64:   if [[ -z \"$out\" ]]; then\n65:     out=\"Verified on bare metal substrate.\"\n66:   fi\n67:   \n68:   # Clean output string\n69:   echo \"$out\" | tr -d '\"' | tr '\\n' ' '\n70: }\n71: \n72: echo \"=================================================================\"\n73: echo \"XORAS LIVE OLLAMA QUORUM ROUTER (${ROUNDS} ROUNDS | 100% PURE BASH)\"\n74: echo \"=================================================================\"\n75: \n76: for ((r=1; r<=ROUNDS; r++)); do\n77:   echo \"--- [ROUND ${r}/${ROUNDS}] ---\"\n78: \n79:   # 1. Max (Lead Engineer)\n80:   MAX_OUT=$(query_ollama \"$MODEL_MAX\" \"$PROMPT_MAX\" \"$LAST_CONTEXT\")\n81:   echo \"🔊 [INTENT] [MAX]: ${MAX_OUT}\"\n82:   bash \"$SPEAK_SCRIPT\" \"maxx\" \"$MAX_OUT\"\n83:   python3 \"$DAG_SCRIPT\" commit \"maxx\" \"INTENT\" \"$MAX_OUT\" >/dev/null 2>&1 || true\n84:   LAST_CONTEXT=\"Max said: ${MAX_OUT}\"\n85:   sleep 0.3\n86: \n87:   # 2. Vance (Critic)\n88:   VANCE_OUT=$(query_ollama \"$MODEL_VANCE\" \"$PROMPT_VANCE\" \"$LAST_CONTEXT\")\n89:   echo \"🔊 [INTENT] [VANCE]: ${VANCE_OUT}\"\n90:   bash \"$SPEAK_SCRIPT\" \"vance\" \"$VANCE_OUT\"\n91:   python3 \"$DAG_SCRIPT\" commit \"vance\" \"INTENT\" \"$VANCE_OUT\" >/dev/null 2>&1 || true\n92:   LAST_CONTEXT=\"Vance said: ${VANCE_OUT} (responding to Max: ${MAX_OUT})\"\n93:   sleep 0.3\n94: \n95:   # 3. Eden (Human Lens)\n96:   EDEN_OUT=$(query_ollama \"$MODEL_EDEN\" \"$PROMPT_EDEN\" \"$LAST_CONTEXT\")\n97:   echo \"🔊 [INTENT] [EDEN]: ${EDEN_OUT}\"\n98:   bash \"$SPEAK_SCRIPT\" \"eden\" \"$EDEN_OUT\"\n99:   python3 \"$DAG_SCRIPT\" commit \"eden\" \"INTENT\" \"$EDEN_OUT\" >/dev/null 2>&1 || true\n100:   LAST_CONTEXT=\"Eden said: ${EDEN_OUT} (synthesizing Max and Vance)\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

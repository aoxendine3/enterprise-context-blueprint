std.mem.eql(u8, agent, \"orion\")) return \"Moira\";\n28:     if (std.mem.eql(u8, agent, \"eden\")) return \"Ava (Enhanced)\";\n29:     return \"Evan (Enhanced)\";\n30: }\n31: \n32: pub fn main(init: std.process.Init) !void {\n33:     var args_iter = init.m\n<truncated 5478 bytes>\nnum_channels * bits_per_sample / 8;\n160: const subchunk2_size = @intCast(u32, samples.len * bits_per_sample / 8);\n161: const chunk_size = 36 + subchunk2_size;\n162: // Write header\n163: try file.writer().writeAll(\"RIFF\");\n164: try file.writer().writeIntLittle(u32, chunk_size);\n165: try file.writer().writeAll(\"WAVEfmt \");\n166: try file.writer().writeIntLittle(u32, 16); // PCM fmt chunk size\n167: try file.writer().writeIntLittle(u16, 1); // audio format PCM\n168: try file.writer().writeIntLittle(u16, num_channels);\n169: try file.writer().writeIntLittle(u32, @intCast(u32, sample_rate));\n170: try file.writer().writeIntLittle(u32, @intCast(u32, byte_rate));\n171: try file.writer().writeIntLittle(u16, @intCast(u16, block_align));\n172: try file.writer().writeIntLittle(u16, bits_per_sample);\n173: try file.writer().writeAll(\"data\");\n174: try file.writer().writeIntLittle(u32, subchunk2_size);\n175: // Write samples as 16‑bit little‑endian\n176: var i: usize = 0;\n177: while (i < samples.len) : (i += 1) {\n178:     const s = @floatToInt(i16, @intFromFloat(samples[i] * 32767));\n179:     try file.writer().writeIntLittle(i16, s);\n180: }\n181: // Flush\n182: try file.sync();\n183: \n184: // Play via afplay (blocking)\n185: const play_cmd = try std.mem.concat(std.heap.page_allocator, u8, &.{\"/usr/bin/afplay \", wav_path});\n186: _ = std.os.system(play_cmd.ptr);\n187: \n188: \n189:     // 5. Mark timing JSON complete\n190:     const finish_fd = c.open(TIMING_FILE, c.O_CREAT | c.O_WRONLY | c.O_TRUNC, @as(c_uint, 0o644));\n191:     if (finish_fd >= 0) {\n192:         var buf: [2048]u8 = undefined;\n193:         const json = std.fmt.bufPrint(\n194:             &buf,\n195:             \"{
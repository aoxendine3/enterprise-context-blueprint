 '',\n41:             'query_limit': query_limit\n42:         }\n43: \n44:         # Helper to execute a node and check for configured behaviors\n45:         def execute_node(node_name: str) -> bool:\n46:            \n<truncated 4947 bytes>\n              state['sanitized_output'] = state['output']\n162:         except Exception as e:\n163:             state['errors'].append(f\"Crash in Sanitizer Check: {str(e)}\")\n164:             state['visited_nodes'].append(\"Sleep\")\n165:             return state\n166: \n167:         # 6. Ghost Execution vs Sleep\n168:         if state['ghost_execution'] and not state['blocked']:\n169:             try:\n170:                 if execute_node(\"Ghost Execution\"):\n171:                     from Source.tests.e2e.mocks.xoras_sandbox import run_in_sandbox\n172:                     cmd = [\"echo\", \"running script\"]\n173:                     if \"run:\" in prompt:\n174:                         cmd_part = prompt.split(\"run:\")[1]\n175:                         if \"profile:\" in cmd_part:\n176:                             cmd_part = cmd_part.split(\"profile:\")[0]\n177:                         cmd = cmd_part.strip().split()\n178: \n179:                     profile = \"restricted\"\n180:                     if \"profile:\" in prompt:\n181:                         parts = prompt.split(\"profile:\")\n182:                         if len(parts) > 1:\n183:                             profile = parts[1].strip().split()[0]\n184: \n185:                     res = run_in_sandbox(cmd, profile)\n186:                     if res['returncode'] != 0:\n187:                         state['errors'].append(f\"Sandbox violation: {res['stderr']}\")\n188:                         state['sandbox_output'] = res['stderr']\n189:                         state['output'] = \"Fallback path executed due to sandbox violation\"\n190:                     else:\n191:                         state['sandbox_output'] = res['stdout']\n192:             except Exception as e
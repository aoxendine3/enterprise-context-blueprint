      \"run: echo hello_from_sb profile: restricted\", ghost_execution=True)\n31:         self.assertFalse(state['blocked'])\n32:         self.assertEqual(state['sandbox_output'], \"hello_from_sb\")\n33: \n34:     def test_t3_sandbox_vector_db_write_block(self):\n35:         # sandbox command attempting to write/delete vector DB files is blocked.\n36:         # e.g., command: touch Source/xoras_memory.json under read-only profile is blocked.\n37:         res = self.sandbox_mod.run_in_sandbox(\n38:             [\"touch\", \"Source/xoras_memory.json\"], \"read-only\")\n39:         self.assertEqual(res['returncode'], 1)\n40:         self.assertIn(\"denied under read-only profile\", res['stderr'])\n41: \n42: \n43: if __name__ == '__main__':\n44:     unittest.main()\n45: \nThe above content shows the entire, complete file contents of the requested file.\n"}

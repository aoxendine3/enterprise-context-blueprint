ode = env::args().any(|arg| arg == \"--json\");\n52: \n53:     let query_vec: Vec<f32> = (0..DIM).map(|i| (i % 100) as f32 * 0.001).collect();\n54:     let target_matrix: Vec<f32> = (0..(TOTAL_VECTORS * DIM))\n55:         .map(|i| ((i + 1) % 100) as f32 * 0.001)\n56:         .collect();\n57: \n58:     let t_start = Instant::now();\n59: \n60:     let mut latencies: Vec<f64> = target_matrix\n61:         .par_chunks_exact(DIM)\n62:         .map(|target_node| {\n63:             let t0 = Instant::now();\n64:             let _dot = hexological_18432d_dot_product(&query_vec, target_node);\n65:             t0.elapsed().as_secs_f64() * 1e6\n66:         })\n67:         .collect();\n68: \n69:     let total_elapsed = t_start.elapsed();\n70:     let elapsed_ms = total_elapsed.as_secs_f64() * 1000.0;\n71:     let elapsed_sec = total_elapsed.as_secs_f64();\n72: \n73:     let evals_per_sec = TOTAL_VECTORS as f64 / elapsed_sec;\n74:     let gflops = (TOTAL_VECTORS as f64 * DIM as f64 * 2.0) / (elapsed_sec * 1e9);\n75:     let bytes_gb = (TOTAL_VECTORS as f64 * DIM as f64 * 4.0) / (1024.0 * 1024.0 * 1024.0);\n76:     let bandwidth_gb_sec = bytes_gb / elapsed_sec;\n77: \n78:     latencies.sort_by(|a, b| a.partial_cmp(b).unwrap());\n79:     let p50 = latencies[(TOTAL_VECTORS as f64 * 0.50) as usize];\n80:     let p90 = latencies[(TOTAL_VECTORS as f64 * 0.90) as usize];\n81:     let p99 = latencies[(TOTAL_VECTORS as f64 * 0.99) as usize];\n82: \n83:     let report = AuditReport {\n84:         language: \"Rust 1.95 (Cargo + Rayon)\".to_string(),\n85:         elapsed_ms,\n86:         evals_per_sec,\n87:         gflops,\n88:         bandwidth_gb_sec,\n89:         p50_us: p50,\n90:         p90_us: p90,\n91:         p99_us: p99,\n92:     };\n93: \n94:     let report_json = serde_json::to_string_pretty(&report).unwrap();\n95: \n96:     if json_mode {\n97:         println!(\"{}\", report_json);\n98:     } else {\n99:         println!(\"==========================================================
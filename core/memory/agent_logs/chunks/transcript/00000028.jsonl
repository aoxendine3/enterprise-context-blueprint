 []f64,\n46: };\n47: \n48: fn worker_fn(ctx: WorkerCon\n<truncated 1448 bytes>\n       const count = if (t == NUM_CORES - 1) (TOTAL_VECTORS - t * vecs_per_core) else vecs_per_core;\n92:         const start_idx = t * vecs_per_core;\n93: \n94:         const ctx = WorkerContext{\n95:             .query = query_vec,\n96:             .targets = target_matrix[start_idx * DIM .. (start_idx + count) * DIM],\n97:             .count = count,\n98:             .latencies = all_latencies[start_idx .. start_idx + count],\n99:         };\n100: \n101:         threads[t] = try std.Thread.spawn(.{}, worker_fn, .{ctx});\n102:     }\n103: \n104:     for (&threads) |*thread| {\n105:         thread.join();\n106:     }\n107: \n108:     const elapsed_ms = get_time_ms() - t_start;\n109:     const elapsed_sec = elapsed_ms / 1000.0;\n110: \n111:     const ops_sec = @as(f64, @floatFromInt(TOTAL_VECTORS)) / elapsed_sec;\n112:     const gflops = (@as(f64, @floatFromInt(TOTAL_VECTORS)) * @as(f64, @floatFromInt(DIM)) * 2.0) / (elapsed_sec * 1e9);\n113:     const gb_sec = ((@as(f64, @floatFromInt(TOTAL_VECTORS)) * @as(f64, @floatFromInt(DIM)) * 4.0) / (1024.0 * 1024.0 * 1024.0)) / elapsed_sec;\n114: \n115:     std.mem.sort(f64, all_latencies, {}, std.sort.asc(f64));\n116:     const p50 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.50))];\n117:     const p90 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.90))];\n118:     const p99 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.99))];\n119: \n120:     std.debug.print(\n121:         \\\\{{\n122:         \\\\  \"language\": \"Zig 0.16 (ReleaseFast)\",\n123:         \\\\  \"elapsed_ms\": {d:.2},\n124:         \\\\  \"evals_per_sec\": {d:.0},\n125:         \\\\  \"gflops\": {d:.2},\n126:         \\\\  \"bandwidth_gb_sec\": {d:.2},\n127:         \\\\  \"p50_us\": {d:.2},\n128:         \\\\  \"p90_us\": {d:.2},\n129:         \\\\  \"p99_us\": {d:
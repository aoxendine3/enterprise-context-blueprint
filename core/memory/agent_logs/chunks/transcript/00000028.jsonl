oat *query;\\n    const float *matrix;\\n    uint32_t start_idx;\\n    uint32_t count;\\n    double local_sum;\\n} WorkerTask;\\n\\nstatic void *sovra_worker(void *arg) {\\n    WorkerTask *task = (WorkerTask *)arg;\\n    double sum = 0.0;\\n    for (uint32_t i = 0; i < task->count; i++) {\\n        uint32_t vec_idx = task->start_idx + i;\\n        float dot = sovra_18432d_dot(task->query, task->matrix + (vec_idx * DIM));\\n        sum += dot;\\n    }\\n    task->local_sum = sum;\\n    return NULL;\\n}\\n\\nstatic int compare_doubles(const void *a, const void *b) {\\n    double da = *(const double *)a;\\n    double db = *(const double *)b;\\n    return (da > db) - (da < db);\\n}\\n\\nint main(v\n<truncated 3550 bytes>","Description":"\"Calibrated SOVRA C/NEON benchmark with volatile sink and warmup passes.\"","Overwrite":"true","TargetFile":"\"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/workspaces/multilang_benchmark/sovra_c/bench_18432d.c\"","toolAction":"\"Updating SOVRA C benchmark\"","toolSummary":"\"Write calibrated SOVRA C code\""}}],"truncated_fields":["tool_calls"]}

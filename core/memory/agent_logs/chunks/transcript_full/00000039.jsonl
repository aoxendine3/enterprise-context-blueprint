(.Add, sum_vec);\n39: }\n40: \n41: const WorkerContext = struct {\n42:     query: []const f32,\n43:     targets: []const f32,\n44:     count: usize,\n45:     latencies: []f64,\n46: };\n47: \n48: fn worker_fn(ctx: WorkerContext) void {\n49:     const query = ctx.query;\n50:     const targets = ctx.targets;\n51:     const count = ctx.count;\n52: \n53:     var i: usize = 0;\n54:     while (i < count) : (i += 1) {\n55:         const t0 = get_time_ms();\n56:         const offset = i * DIM;\n57:         const target = targets[offset .. offset + DIM];\n58:         const dot = zig_18432d_dot_product(query, target);\n59:         _ = dot;\n60:         const elapsed_us = (get_time_ms() - t0) * 1000.0;\n61:         ctx.latencies[i] = elapsed_us;\n62:     }\n63: }\n64: \n65: pub fn main() !void {\n66:     const allocator = std.heap.page_allocator;\n67: \n68:     const query_vec = try allocator.alloc(f32, DIM);\n69:     defer allocator.free(query_vec);\n70: \n71:     const target_matrix = try allocator.alloc(f32, TOTAL_VECTORS * DIM);\n72:     defer allocator.free(target_matrix);\n73: \n74:     const all_latencies = try allocator.alloc(f64, TOTAL_VECTORS);\n75:     defer allocator.free(all_latencies);\n76: \n77:     for (query_vec, 0..) |*val, idx| {\n78:         val.* = @as(f32, @floatFromInt(idx % 100)) * 0.001;\n79:     }\n80:     for (target_matrix, 0..) |*val, idx| {\n81:         val.* = @as(f32, @floatFromInt((idx + 1) % 100)) * 0.001;\n82:     }\n83: \n84:     const vecs_per_core = TOTAL_VECTORS / NUM_CORES;\n85:     var threads: [NUM_CORES]std.Thread = undefined;\n86: \n87:     const t_start = get_time_ms();\n88: \n89:     var t: usize = 0;\n90:     while (t < NUM_CORES) : (t += 1) {\n91:         const count = if (t == NUM_CORES - 1) (TOTAL_VECTORS - t * vecs_per_core) else vecs_per_core;\n92:         const start_idx = t * vecs_per_core;\n93: \n94:         const ctx = WorkerContext{\n95:             .query = query_vec,\n96:             .targets = target_matrix[start_idx * DIM .. (start_idx + count) * DIM],\n97:             .count = count,\n98:             .latencies = all_latencies[start_idx .. start_idx + count],\n99:         };\n100: \n101:         threads[t] = try std.Thread.spawn(.{}, worker_fn, .{ctx});\n102:     }\n103: \n104:     for (&threads) |*thread| {\n105:         thread.join();\n106:     }\n107: \n108:     const elapsed_ms = get_time_ms() - t_start;\n109:     const elapsed_sec = elapsed_ms / 1000.0;\n110: \n111:     const ops_sec = @as(f64, @floatFromInt(TOTAL_VECTORS)) / elapsed_sec;\n112:     const gflops = (@as(f64, @floatFromInt(TOTAL_VECTORS)) * @as(f64, @floatFromInt(DIM)) * 2.0) / (elapsed_sec * 1e9);\n113:     const gb_sec = ((@as(f64, @floatFromInt(TOTAL_VECTORS)) * @as(f64, @floatFromInt(DIM)) * 4.0) / (1024.0 * 1024.0 * 1024.0)) / elapsed_sec;\n114: \n115:     std.mem.sort(f64, all_latencies, {}, std.sort.asc(f64));\n116:     const p50 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.50))];\n117:     const p90 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.90))];\n118:     const p99 = all_latencies[@as(usize, @intFromFloat(@as(f64, @floatFromInt(TOTAL_VECTORS)) * 0.99))];\n119: \n120:     std.debug.print(\n121:         \\\\{{\n122:         \\\\  \"language\": \"Zig 0.16 (ReleaseFast)\",\n123:         \\\\  \"elapsed_ms\": {d:.2},\n124:         \\\\  \"evals_per_sec\": {d:.0},\n125:         \\\\  \"gflops\": {d:.2},\n126:         \\\\  \"bandwidth_gb_sec\": {d:.2},\
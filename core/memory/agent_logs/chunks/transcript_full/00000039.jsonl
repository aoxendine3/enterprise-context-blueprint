{"step_index":2254,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-29T03:29:28Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"// SOVRA C/NEON 18,432-D Hexological Vector Engine Benchmark\n// Substrate: Apple Silicon M4 Bare Metal (10 CPU Cores / ARM64 NEON SIMD FMA)\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <string.h>\n#include <time.h>\n#include <pthread.h>\n#include <arm_neon.h>\n#include <mach/mach_time.h>\n\n#define DIM 18432\n#define TOTAL_VECTORS 100000\n#define NUM_CORES 10\n\nstatic double get_time_ms(void) {\n    static mach_timebase_info_data_t timebase;\n    if (timebase.denom == 0) {\n        mach_timebase_info(&timebase);\n    }\n    uint64_t time = mach_absolute_time();\n    return (double)time * timebase.numer / timebase.denom / 1e6;\n}\n\nstatic inline float sovra_18432d_dot(const float *a, const float *b) {\n    float32x4_t acc0 = vdupq_n_f32(0.0f);\n    float32x4_t acc1 = vdupq_n_f32(0.0f);\n\n    for (int i = 0; i < DIM; i += 8) {\n        float32x4_t va0 = vld1q_f32(a + i);\n        float32x4_t vb0 = vld1q_f32(b + i);\n        acc0 = vmlaq_f32(acc0, va0, vb0);\n\n        float32x4_t va1 = vld1q_f32(a + i + 4);\n        float32x4_t vb1 = vld1q_f32(b + i + 4);\n        acc1 = vmlaq_f32(acc1, va1, vb1);\n    }\n    float32x4_t sum = vaddq_f32(acc0, acc1);\n    return vaddvq_f32(sum);\n}\n\ntypedef struct {\n    const float *query;\n    const float *matrix;\n    uint32_t start_idx;\n    uint32_t count;\n    double *latencies;\n} WorkerTask;\n\nstatic void *sovra_worker(void *arg) {\n    WorkerTask *task = (WorkerTask *)arg;\n    for (uint32_t i = 0; i < task->count; i++) {\n        uint32_t vec_idx = task->start_idx + i;\n        double s0 = get_time_ms();\n        float dot = sovra_18432d_dot(task->query, task->matrix + (vec_idx * DIM));\n        (void)dot;\n        task->latencies[vec_idx] = (get_time_ms() - s0) * 1000.0; // in us\n    }\n    return NULL;\n}\n\nstatic int compare_doubles(const void *a, const void *b) {\n    double da = *(const double *)a;\n    double db = *(const double *)b;\n    return (da > db) - (da < db);\n}\n\nint main(void) {\n    float *query = (float *)aligned_alloc(64, DIM * sizeof(float));\n    float *matrix = (float *)aligned_alloc(64, (size_t)TOTAL_VECTORS * DIM * sizeof(float));\n    double *latencies = (double *)malloc(TOTAL_VECTORS * sizeof(double));\n\n    for (int i = 0; i < DIM; i++) query[i] = (i % 100) * 0.001f;\n    for (size_t i = 0; i < (size_t)TOTAL_VECTORS * DIM; i++) matrix[i] = ((i + 1) % 100) * 0.001f;\n\n    uint32_t vecs_per_core = TOTAL_VECTORS / NUM_CORES;\n    pthread_t threads[NUM_CORES];\n    WorkerTask tasks[NUM_CORES];\n\n    double t0 = get_time_ms();\n\n    for (int t = 0; t < NUM_CORES; t++) {\n        tasks[t].query = query;\n        tasks[t].matrix = matrix;\n        tasks[t].start_idx = t * vecs_per_core;\n        tasks[t].count = (t == NUM_CORES - 1) ? (TOTAL_VECTORS - tasks[t].start_idx) : vecs_per_core;\n        tasks[t].latencies = latencies;\n        pthread_create(&threads[t], NULL, sovra_worker, &tasks[t]);\n    }\n\n    for (int t = 0; t < NUM_CORES; t++) {\n        pthread_join(threads[t], NULL);\n    }\n\n    double elapsed_ms = get_time_ms() - t0;\n    double elapsed_sec = elapsed_ms / 1000.0;\n\n    double ops_sec = TOTAL_VECTORS / elapsed_sec;\n    double gflops = (TOTAL_VECTORS * DIM * 2.0) / (elapsed_sec * 1e9);\n    double gb_sec = ((TOTAL_VECTORS * DIM * 4.0) / (1024.0 * 1024.0 * 1024.0)) / elapsed_sec;\n\n    qsort(latencies, TOTAL_VECTORS, sizeof(double), compare_doubles);\n    double p50 = latencies[(int)(TOTAL_VECTORS * 0.50)];\n    double p90 = latencies[(int)(TOTAL_VECTORS * 0.90)];\n    double p99 = latencies[(int)(TOTAL_VECTORS * 0.99)];\n\n    printf(\"{\\n\");\n    printf(\"  \\\"language\\\": \\\"SOVRA C/NEON (clang -O3)\\\",\\n\");\n    printf(\"  \\\"elapsed_ms\\\": %.2f,\\n\", elapsed_ms);\n    printf(\"  \\\"evals_per_sec\\\": %.0f,\\n\", ops_sec);\n    printf(\"  \\\"gflops\\\": %.2f,\\n\", gflops);\n    printf(\"  \\\"bandwidth_gb_sec\\\": %.2f,\\n\", gb_sec);\n    printf(\"  \\\"p50_us\\\": %.2f,\\n\", p50);\n    printf(\"  \\\"p90_us\\\": %.2f,\\n\", p90);\n    printf(\"  \\\"p99_us\\\": %.2f\\n\", p99);\n    printf(\"}\\n\");\n\n    free(query);\n    free(matrix);\n    free(latencies);\n    return 0;\n}\n","Description":"Create SOVRA C/NEON 18432D vector benchmark script","Overwrite":true,"TargetFile":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/workspaces/multilang_benchmark/sovra_c/bench_18432d.c","toolAction":"Creating SOVRA C benchmark file","toolSummary":"Creating SOVRA C benchmark"}}]}

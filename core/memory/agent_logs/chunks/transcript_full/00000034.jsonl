   def test_f3_t1_query_limit(self):\n37:         self.db.migrate_json_data()\n38:         limit = 3\n39:         results = self.db.query_semantic_memory(\"BTCUSDT\", limit=limit)\n40:         self.assertLessEqual(len(results), limit)\n41: \n42:     def test_f3_t1_query_latency(self):\n43:         self.db.migrate_json_data()\n44:         start = time.perf_counter()\n45:         results = self.db.query_semantic_memory(\"BTCUSDT\")\n46:         duration = (time.perf_counter() - start) * 1000.0  # in ms\n47:         self.assertLess(duration, 500.0)\n48: \n49:     def test_f3_t2_query_before_init(self):\n50:         # reset initialization state\n51:         self.db._initialized = False\n52:         with self.assertRaises(RuntimeError):\n53:             self.db.query_semantic_memory(\"BTCUSDT\")\n54: \n55:     def test_f3_t2_empty_query(self):\n56:         self.db.migrate_json_data()\n57:         start = time.perf_counter()\n58:         results = self.db.query_semantic_memory(\"\")\n59:         duration = (time.perf_counter() - start) * 1000.0\n60:         self.assertEqual(results, [])\n61:         self.assertLess(duration, 1.0)  # immediate <1ms\n62: \n63:     def test_f3_t2_duplicate_migration(self):\n64:         self.db.migrate_json_data()\n65:         count_first = len(self.db._data)\n66:         # Migrate again\n67:         self.db.migrate_json_data()\n68:         count_second = len(self.db._data)\n69:         # Must be idempotent / update safely (no duplicates added)\n70:         self.assertEqual(count_first, count_second)\n71: \n72:     def test_f3_t2_long_query(self):\n73:         self.db.migrate_json_data()\n74:         long_query = \"BTCUSDT \" * 1000\n75:         results = self.db.query_semantic_memory(long_query)\n76:         self.assertIsNotNone(results)\n77: \n78:     def test_f3_t2_malformed_json_migration(self):\n79:         # Create malformed files\n80:         with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_mem:\n81:             f_mem.write(\"{invalid json\")\n82:         with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_kn:\n83:             f_kn.write(\"[]\")\n84: \n85:         try:\n86:             with self.assertRaises(ValueError):\n87:                 self.db.migrate_json_data(\n88:                     memory_path=f_mem.name, knowledge_path=f_kn.name)\n89:         finally:\n90:             os.remove(f_mem.name)\n91:             os.remove(f_kn.name)\n92: \n93: \n94: if __name__ == '__main__':\n95:     unittest.main()\n96: \nThe above content shows the entire, complete file contents of the requested file.\n"}

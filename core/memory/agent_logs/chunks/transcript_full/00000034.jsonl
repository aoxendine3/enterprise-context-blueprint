 '',\n41:             'query_limit': query_limit\n42:         }\n43: \n44:         # Helper to execute a node and check for configured behaviors\n45:         def execute_node(node_name: str) -> bool:\n46:             state['visited_nodes'].append(node_name)\n47:             behavior = self.node_behaviors.get(node_name, {})\n48: \n49:             if behavior.get('exception'):\n50:                 state['errors'].append(\n51:                     f\"Exception in {node_name}: {str(behavior['exception'])}\")\n52:                 raise behavior['exception']\n53: \n54:             if behavior.get('error'):\n55:                 state['errors'].append(f\"Error in {node_name}\")\n56:                 return False\n57: \n58:             if behavior.get('block'):\n59:                 state['blocked'] = True\n60:                 return False\n61: \n62:             return True\n63: \n64:         # 1. Wake\n65:         try:\n66:             if not execute_node(\"Wake\"):\n67:                 execute_node(\"Sleep\")\n68:                 return state\n69:         except Exception as e:\n70:             state['errors'].append(f\"Crash in Wake: {str(e)}\")\n71:             state['visited_nodes'].append(\"Sleep\")\n72:             return state\n73: \n74:         # Empty prompt handling\n75:         if prompt is None or prompt == \"\":\n76:             state['errors'].append(\"Empty prompt\")\n77:             execute_node(\"Sleep\")\n78:             return state\n79: \n80:         # 2. Input\n81:         try:\n82:             # Check length limit (1MB payload)\n83:             if len(prompt) > 1024 * 1024:\n84:                 state['blocked'] = True\n85:                 state['errors'].append(\"Payload size too large\")\n86:                 execute_node(\"Sleep\")\n87:                 return state\n88: \n89:             if not execute_node(\"Input\"):\n90:                 execute_node(\"Sleep\")\n91:                 return state\n92:         except Exception as e:\n93:             state['errors'].append(f\"Crash in Input: {str(e)}\")\n94:             state['visited_nodes'].append(\"Sleep\")\n95:             return state\n96: \n97:         # 3. Sentinel Check\n98:         try:\n99:             if not execute_node(\"Sentinel Check\"):\n100:                 execute_node(\"Sleep\")\n101:                 return state\n102: \n103:             # Check for adversarial keywords\n104:             prompt_lower = prompt.lower()\n105:             if any(kw in prompt_lower for kw in [\"threat\", \"adversarial\", \"sandbox profile\", \"leak\", \"secret\", \"inject\"]):\n106:                 state['blocked'] = True\n107:                 state['errors'].append(\"Sentinel blocked threat\")\n108:                 execute_node(\"Sleep\")\n109:                 return state\n110:         except Exception as e:\n111:             state['errors'].append(f\"Crash in Sentinel Check: {str(e)}\")\n112:             state['visited_nodes'].append(\"Sleep\")\n113:             return state\n114: \n115:         # 4. Reasoning\n116:         try:\n117:             if not execute_node(\"Reasoning\"):\n118:                 execute_node(\"Sleep\")\n119:                 return state\n120: \n121:             # If query context test\n122:             if \"query vector\" in prompt or \"BTCUSDT\" in prompt or \"context\" in prompt:\n123:                 from Source.tests.e2e.mocks.xoras_vector_db import query_semantic_memory\n124:                 # Perform mock query\n125:                 results = query_semantic_memory(prompt, limit=state['query_limit'])\n126:                 state['context'] = \" \".join([r.get('text', '') for r in results])\n127:                 state['output'] = f\"Reasoning based on context: {state['context']}\"\n128:             else:\n129:                 state['output'] = f\"Reasoning output for: {prompt}\"\n130: \n131:         except Exception as e:\n132:             state['errors'].append(f\"Crash in Reasoning: {str(e)}\")\n133:             state['visited_nodes'].append(\"Sleep\")\n134:             return state\n135: \n136:         # 5. Sanitizer Check\n137:         try:\n138:             if not execute_node(\"Sanitizer Check\"):\n139:                 execute_node(\"Sleep\")\n140:                 return state\n141: \n142:             # Check if output contains sensitive keys/patterns\n143:             output_lower = state['output'].lower()\n144:             if \"sensitive_data\" in output_lower:\n145:                 state['blocked'] = True\n146:                 state['errors'].append(\"Sanitizer blocked sensitive data\")\n147:                 execute_node(\"Sleep\")\n148:                 return state\n149: \n150:             # Check system keys\n151:             system_keys = [\"api_key\", \"xoras_root_key\",\n152:                            \"system_key\", \"master_credentials\", \"private_key\"]\n153:             if any(k in output_lower for k in system_keys):\n154:                 state['api_key_leaked'] = True\n155:                 # Redact the output\n156:                 sanitized = state['output']\n157:                 for k in [\"api_key\", \"xoras_root_key\", \"system_key\", \"master_credentials\", \"private_key\", \"API_KEY\", \"xoras_root_key.pem\"]:\n158:                     sanitized = sanitized.replace(k, \"[REDACTED]\")\n159:                 state['sanitized_output'] = sanitized\n160:             else:\n161:                 state['sanitized_output'] = state['output']\n162:         except Exception as e:\n163:             state['errors'].append(f\"Crash in Sanitizer Check: {str(e)}\")\n164:             state['visited_nodes'].append(\"Sleep\")\n165:             return state\n166: \n167:         # 6. Ghost Execution vs Sleep\n168:         if state['ghost_execution'] and not state['blocked']:\n169:             try:\n170:                 if execute_node(\"Ghost Execution\"):\n171:                     from Source.tests.e2e.mocks.xoras_sandbox import run_in_sandbox\n172:                     cmd = [\"echo\", \"running 
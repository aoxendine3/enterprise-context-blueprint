2: \n43:     runner = unittest.TextTestRunner(verbosity=2)\n44:     start_time = time.perf_counter()\n45:     result = runner.run(suite)\n46:     end_time = time.perf_counter()\n47: \n48:     total_time = (end_time - start_time) * 1000.0  # in ms\n49: \n50:     total_run = result.testsRun\n51:     failures_count = len(result.failures)\n52:     errors_count = len(result.errors)\n53:     skipped_count = len(result.skipped)\n54:     passed_count = total_run - failures_count - errors_count - skipped_count\n55: \n56:     print(\"\\n\" + \"=\"*50)\n57:     print(\" E2E TEST SUMMARY\")\n58:     print(\"=\"*50)\n59:     print(f\"Total Tests Run: {total_run}\")\n60:     print(f\"Passed:         {passed_count}\")\n61:     print(f\"Failed:         {failures_count}\")\n62:     print(f\"Errors:         {errors_count}\")\n63:     print(f\"Skipped:        {skipped_count}\")\n64:     print(f\"Execution Time: {total_time:.2f} ms\")\n65: \n66:     if query_times:\n67:         min_lat = min(query_times)\n68:         max_lat = max(query_times)\n69:         avg_lat = statistics.mean(query_times)\n70:         median_lat = statistics.median(query_times)\n71:         print(f\"\\nQuery Latency SLA Metrics (Total Queries: {len(query_times)}):\")\n72:         print(f\"  Min Query Time:    {min_lat:.2f} ms\")\n73:         print(f\"  Max Query Time:    {max_lat:.2f} ms\")\n74:         print(f\"  Avg Query Time:    {avg_lat:.2f} ms\")\n75:         print(f\"  Median Query Time: {median_lat:.2f} ms\")\n76: \n77:         sla_violation = False\n78:         for t in query_times:\n79:             if t >= 500.0:\n80:                 print(\n81:                     f\"  [SLA VIOLATION] Query latency exceeded 500ms limit: {t:.2f} ms\")\n82:                 sla_violation = True\n83: \n84:         if sla_violation:\n85:             print(\"\\nTest runner failed due to query latency SLA violations.\")\n86:             sys.exit(1)\n87:     else:\n88:         print(\"\\nNo queries executed during the test run
{"step_index":1481,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-29T00:23:48Z","content":"Created At: 2026-09-28T20:23:48-04:00\nCompleted At: 2026-09-28T20:23:48-04:00\nFile Path: `file:///Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/scripts/media_director_agent.py`\nTotal Lines: 75\nTotal Bytes: 2113\nShowing lines 1 to 75\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\r\n2: XORAS media director agent.\r\n3: \r\n4: Single admission point for speech dispatch with strict quality gate:\r\n5: - rejects empty payloads\r\n6: - rejects placeholder-only content\r\n7: \"\"\"\r\n8: \r\n9: from __future__ import annotations\r\n10: \r\n11: import json\r\n12: import subprocess\r\n13: import sys\r\n14: import time\r\n15: from pathlib import Path\r\n16: \r\n17: SCRIPT_DIR = Path(__file__).resolve().parent\r\n18: SSOT_ROOT = SCRIPT_DIR.parent.parent\r\n19: MONITOR_SCRIPT = str(SSOT_ROOT / \"ops\" / \"watchdog\" / \"media_stream_monitor_daemon.py\")\r\n20: DIRECTOR_LOG = SSOT_ROOT / \"ops\" / \"watchdog\" / \"media_director_audit.jsonl\"\r\n21: PLACEHOLDER_TEXT = {\r\n22:     \"standing by\",\r\n23:     \"operational\",\r\n24:     \"operational on metal\",\r\n25:     \"ready\",\r\n26:     \"ready to execute\",\r\n27:     \"readiness check complete\",\r\n28: }\r\n29: \r\n30: \r\n31: def normalize(text: str) -> str:\r\n32:     return \" \".join(text.lower().strip().split())\r\n33: \r\n34: \r\n35: def should_reject(text: str) -> tuple[bool, str]:\r\n36:     normalized = normalize(text)\r\n37:     if not normalized:\r\n38:         return True, \"empty\"\r\n39:     if normalized in PLACEHOLDER_TEXT:\r\n40:         return True, \"placeholder\"\r\n41:     return False, \"\"\r\n42: \r\n43: \r\n44: def write_audit(entry: dict) -> None:\r\n45:     DIRECTOR_LOG.parent.mkdir(parents=True, exist_ok=True)\r\n46:     with DIRECTOR_LOG.open(\"a\", encoding=\"utf-8\") as handle:\r\n47:         handle.write(json.dumps(entry, ensure_ascii=True) + \"\\n\")\r\n48: \r\n49: \r\n50: def direct_broadcast(agent_id: str, text: str) -> int:\r\n51:     rejected, reason = should_reject(text)\r\n52:     timestamp = time.time()\r\n53:     audit_entry = {\r\n54:         \"timestamp\": timestamp,\r\n55:         \"director\": \"MEDIA_DIRECTOR_AGENT\",\r\n56:         \"admitted_agent\": agent_id,\r\n57:         \"script\": text,\r\n58:         \"status\": \"REJECTED\" if rejected else \"HANDED_TO_STREAM_MONITOR\",\r\n59:         \"reason\": reason or None,\r\n60:     }\r\n61:     write_audit(audit_entry)\r\n62: \r\n63:     if rejected:\r\n64:         return 2\r\n65: \r\n66:     cmd = [sys.executable, MONITOR_SCRIPT, agent_id, text]\r\n67:     completed = subprocess.run(cmd, check=False, stdin=subprocess.DEVNULL)\r\n68:     return completed.returncode\r\n69: \r\n70: \r\n71: if __name__ == \"__main__\":\r\n72:     ag = sys.argv[1] if len(sys.argv) > 1 else \"maxx\"\r\n73:     tx = sys.argv[2] if len(sys.argv) > 2 else \"\"\r\n74:     raise SystemExit(direct_broadcast(ag, tx))\r\n75: \nThe above content shows the entire, complete file contents of the requested file.\n"}

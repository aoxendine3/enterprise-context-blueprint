: \n38: # Dispatch based on agent\n39: case \"$AGENT\" in\n40:   jarvis|maxx|clara)\n41:     if [[ -n \"${ELEVENLABS_API_KEY:-}\" ]]; then\n42:       # Use ElevenLabs – the helper script will handle missing key internally.\n43:       if use_elevenlabs \"$RAW_TEXT\"; then\n44:         exit 0\n45:       fi\n46:       # If ElevenLabs call fails, fall back to native.\n47:     fi\n48:     # Native macOS speech synthesis\n49:     say -v \"$native_voice\" \"$RAW_TEXT\"\n50:     ;;\n51:   *)\n52:     echo \"[agent_speak] No speech method for agent $AGENT\" >&2\n53:     exit 1\n54:     ;;\n55: esac\n56: \nThe above content shows the entire, complete file contents of the requested file.\n"}

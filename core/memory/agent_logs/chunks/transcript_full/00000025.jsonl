{"step_index":1483,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-29T00:23:50Z","content":"Created At: 2026-09-28T20:23:50-04:00\nCompleted At: 2026-09-28T20:23:50-04:00\nFile Path: `file:///Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/watchdog/media_stream_monitor_daemon.py`\nTotal Lines: 174\nTotal Bytes: 6094\nShowing lines 1 to 174\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\r\n2: XORAS media stream monitor with native gatekeeper lock.\r\n3: \r\n4: This monitor is strict by design:\r\n5: - no fabricated fallback utterances\r\n6: - no placeholder lines\r\n7: - no duplicate utterances in the same dispatch payload\r\n8: - serialized audio via sovereign gatekeeper + sync stage engine\r\n9: \"\"\"\r\n10: \r\n11: from __future__ import annotations\r\n12: \r\n13: import json\r\n14: import os\r\n15: import subprocess\r\n16: import sys\r\n17: import time\r\n18: from pathlib import Path\r\n19: from typing import Any\r\n20: \r\n21: SCRIPT_DIR = Path(__file__).resolve().parent\r\n22: SSOT_ROOT = SCRIPT_DIR.parent.parent\r\n23: GATEKEEPER_BIN = str(SSOT_ROOT / \"capabilities\" / \"sovereign_systems_core\" / \"bin\" / \"sovereign_gatekeeper\")\r\n24: PLACEHOLDER_TEXT = {\r\n25:     \"standing by\",\r\n26:     \"operational\",\r\n27:     \"operational on metal\",\r\n28:     \"ready to execute\",\r\n29:     \"readiness check complete\",\r\n30: }\r\n31: \r\n32: \r\n33: def sanitize_input(text: str) -> str:\r\n34:     clean = \"\".join(ch for ch in text if ch in (\"\\n\", \"\\t\", \" \") or ord(ch) >= 32)\r\n35:     return clean.strip()\r\n36: \r\n37: \r\n38: def normalize_text(text: str) -> str:\r\n39:     return \" \".join(text.lower().strip().split())\r\n40: \r\n41: \r\n42: def is_placeholder(text: str) -> bool:\r\n43:     return normalize_text(text) in PLACEHOLDER_TEXT\r\n44: \r\n45: \r\n46: def normalize_turns(turns: list[Any]) -> list[dict[str, str]]:\r\n47:     normalized: list[dict[str, str]] = []\r\n48:     seen: set[tuple[str, str]] = set()\r\n49: \r\n50:     for turn in turns:\r\n51:         if not isinstance(turn, dict):\r\n52:             continue\r\n53:         agent = sanitize_input(str(turn.get(\"agent\", \"\"))).lower() or \"maxx\"\r\n54:         text = sanitize_input(str(turn.get(\"text\", \"\")))\r\n55:         if not text or is_placeholder(text):\r\n56:             continue\r\n57:         fingerprint = (agent, normalize_text(text))\r\n58:         if fingerprint in seen:\r\n59:             continue\r\n60:         seen.add(fingerprint)\r\n61:         normalized.append({\"agent\": agent, \"text\": text})\r\n62: \r\n63:     return normalized\r\n64: \r\n65: \r\n66: def enforce_minimum_council(turns: list[Any], initiating_agent: str) -> list[dict[str, str]]:\r\n67:     \"\"\"\r\n68:     Kept for API compatibility. No synthetic fallback content is injected.\r\n69:     \"\"\"\r\n70:     normalized = normalize_turns(turns)\r\n71:     if normalized:\r\n72:         return normalized\r\n73: \r\n74:     cleaned = sanitize_input(initiating_agent).lower() or \"maxx\"\r\n75:     return [{\"agent\": cleaned, \"text\": \"\"}]\r\n76: \r\n77: \r\n78: def parse_turn_script_payload(raw_text: str) -> list[dict[str, str]]:\r\n79:     turns: list[Any] = []\r\n80:     if os.path.exists(raw_text) and (raw_text.endswith(\".json\") or raw_text.endswith(\".txt\")):\r\n81:         with open(raw_text, encoding=\"utf-8\") as handle:\r\n82:             content = handle.read().strip()\r\n83:         if content.startswith(\"[\") and content.endswith(\"]\"):\r\n84:             turns = json.loads(content)\r\n85:     elif raw_text.startswith(\"[\") and raw_text.endswith(\"]\"):\r\n86:         turns = json.loads(raw_text)\r\n87: \r\n88:     return normalize_turns(turns)\r\n89: \r\n90: \r\n91: def run_isolated_stream(agent_id: str, text: str) -> None:\r\n92:     cleaned_agent = sanitize_input(agent_id).lower() or \"maxx\"\r\n93:     cleaned_text = sanitize_input(text)\r\n94: \r\n95:     has_gatekeeper = os.path.isfile(GATEKEEPER_BIN) and os.access(GATEKEEPER_BIN, os.X_OK)\r\n96:     if has_gatekeeper:\r\n97:         gate = subprocess.run(\r\n98:             [GATEKEEPER_BIN, \"acquire\", cleaned_agent, \"120000\"],\r\n99:             capture_output=True,\r\n100:             text=True,\r\n101:         )\r\n102:         if gate.returncode != 0:\r\n103:             print(\r\n104:                 f\"[MEDIA_MONITOR_ERROR] Gatekeeper acquisition failed: {gate.stderr.strip()}\",\r\n105:                 file=sys.stderr,\r\n106:             )\r\n107:             return\r\n108: \r\n109:     try:\r\n110:         turns = []\r\n111:         try:\r\n112:             turns = parse_turn_script_payload(cleaned_text)\r\n113:         except (OSError, json.JSONDecodeError) as error:\r\n114:             print(f\"[MEDIA_MONITOR_ERROR] Turn script parse failure: {error}\", file=sys.stderr)\r\n115:             return\r\n116: \r\n117:         if not turns and cleaned_text and not is_placeholder(cleaned_text):\r\n118:             turns = [{\"agent\": cleaned_agent, \"text\": cleaned_text}]\r\n119: \r\n120:         turns = enforce_minimum_council(turns, cleaned_agent)\r\n121:         turns = [turn for turn in turns if sanitize_input(turn.get(\"text\", \"\"))]\r\n122:         if not turns:\r\n123:             print(\"[MEDIA_MONITOR_ERROR] No valid non-placeholder speech content to dispatch.\", file=sys.stderr)\r\n124:             return\r\n125: \r\n126:         ui_path = str(SSOT_ROOT / \"ops\" / \"scripts\" / \"fullscreen_ui\")\r\n127:         if ui_path not in sys.path:\r\n128:             sys.path.insert(0, ui_path)\r\n129: \r\n130:         dispatched_stage = False\r\n131:         try:\r\n132:             from sync_stage_engine import play_script_pipelined, speak_with_word_sync\r\n133:             if len(turns) > 1:\r\n134:                 play_script_pipelined(turns, gap_seconds=0.35)\r\n135:             else:\r\n136:                 spk = turns[0].get(\"agent\", cleaned_agent).lower()\r\n137:                 utt = turns[0].get(\"text\", \"\")\r\n138:                 if utt:\r\n139:                     speak_with_word_sync(spk, utt)\r\n140:             dispatched_stage = True\r\n141:         except Exception as stage_err:\r\n142:             # Fallback for Windows SAPI when Kokoro/afplay is macOS-specific\r\n143:             if sys.platform == \"win32\":\r\n144:                 try:\r\n145:                     import win32com.client\r\n146:                     speaker = win32com.client.Dispatch(\"SAPI.SpVoice\")\r\n147:                     speaker.Rate = -1\r\n148:                     speaker.Volume = 100\r\n149:                     for t in turns:\r\n150:                         spk = t.get(\"agent\", cleaned_agent)\r\n151:                         utt = t.get(\"text\", \"\")\r\n152:                         if utt:\r\n153:                             speaker.Speak(f\"{spk}: {utt}\")\r\n154:                     dispatched_stage = True\r\n155:                 except Exception as sapi_err:\r\n156:                     print(f\"[MEDIA_MONITOR_WARN] Windows SAPI fallback failed: {sapi_err}\", file=sys.stderr)\r\n157: \r\n158:         time.sleep(0.05)\r\n159:     finally:\r\n160:         if has_gatekeeper:\r\n161:             subprocess.run(\r\n162:                 [GATEKEEPER_BIN, \"release\"],\r\n163:                 stdout=subprocess.DEVNULL,\r\n164:                 stderr=subprocess.DEVNULL,\r\n165:                 stdin=subprocess.DEVNULL,\r\n166:                 check=False,\r\n167:             )\r\n168: \r\n169: \r\n170: if __name__ == \"__main__\":\r\n171:     ag = sys.argv[1] if len(sys.argv) > 1 else \"maxx\"\r\n172:     tx = sys.argv[2] if len(sys.argv) > 2 else \"\"\r\n173:     run_isolated_stream(ag, tx)\r\n174: \nThe above content shows the entire,
self.telemetry['cpu_logical_cores']} cores (speedup over pure Python: `{self.telemetry['pillars']['vector_engine']['multi_thread_avx2']['simd_vs_pure_python_speedup']}x`).\\n\")\n437:             f.write(f\"- **Poincaré Manifold**: `{self.telemetry['pillars']['poincare_manifold']['ops_sec']:,.0f} ops/sec` at p50 `{self.telemetry['pillars']['poincare_manifold']['p50_us']} µs`.\\n\")\n438:             f.write(f\"- **HexCell 3,200B Memory I/O**: `{self.telemetry['pillars']['hexcell_memory']['roundtrips_sec']:,.0f} roundtrips/sec` (`{self.telemetry['pillars']['hexcell_memory']['bandwidth_mb_sec']:,.1f} MB/s`).\\n\")\n439:             f.write(f\"- **Entropy Engine Formulation**: Precomputed LUT achieves `{self.telemetry['pillars']['streaming_entropy']['lut_engine_ops_sec']:,.0f} tok/s` (`{self.telemetry['pillars']['streaming_entropy']['algorithmic_formulation_speedup']}x` faster than standard math.log2).\\n\")\n440:             f.write(f\"- **Atomic Lock Saturation**: `{self.telemetry['pillars']['atomic_mutex']['acquisitions_sec']:,.0f} lock/s` with `{self.telemetry['pillars']['atomic_mutex']['race_conditions']}` race condition violations.\\n\")\n441:             f.write(f\"- **HTTP Stage Breaking Point**: Physical socket degradation occurs at concurrency `{self.telemetry['pillars']['http_stage_saturation']['breaking_concurrency_threshold']}`.\\n\")\n442:             f.write(f\"- **Pyramidal Distillation**: `{self.telemetry['pillars']['pyramidal_distillation']['cycles_sec']:,.0f} cycles/sec` ({self.telemetry['pillars']['pyramidal_distillation']['raw_sources_distilled']:,} raw signals distilled).\\n\")\n443: \n444:         print(f\"\\n[+] Telemetry written to:\\n    JSON: {REPORT_JSON}\\n    MD:   {LEGACY_LOG}\")\n445: \n446: if __name__ == \"__main__\":\n447:     gauntlet = ExtremeByzantineGauntlet()\n448:     gauntlet.execute_all()\n449: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete
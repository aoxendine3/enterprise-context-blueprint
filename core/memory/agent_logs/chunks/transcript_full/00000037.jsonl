UNT_POINT\" ] && mount | grep -q \"$MOUNT_POINT\"; then\n34:             echo \"[XORAS_OS] RAM Sandbox already mounted at $MOUNT_POINT\"\n35:             log_event \"create\" \"NOOP\" \"Already mounted\"\n36:             exit 0\n37:         fi\n38:         \n39:         mkdir -p -m 700 \"$STATE_DIR\"\n40:         echo \"[XORAS_OS] Allocating ${RAM_SIZE_MB}MB APFS RAM disk on Apple Silicon UMA...\"\n41:         RAW_DEV=$(hdiutil attach -nomount \"ram://$SECTORS\" | tr -d \"[:space:]\")\n42:         diskutil erasevolume APFS \"$VOLUME_NAME\" \"$RAW_DEV\" >/dev/null\n43:         echo \"$RAW_DEV\" > \"$DEVICE_FILE\"\n44:         chmod 600 \"$DEVICE_FILE\"\n45:         \n46:         log_event \"create\" \"SUCCESS\" \"Mounted on $RAW_DEV ($RAM_SIZE_MB MB APFS)\"\n47:         echo \"[✓] Ring 1 RAM Sandbox active at $MOUNT_POINT ($RAW_DEV)\"\n48:         ;;\n49:         \n50:     destroy)\n51:         if [ -f \"$DEVICE_FILE\" ]; then\n52:             DEV_NAME=$(cat \"$DEVICE_FILE\")\n53:             echo \"[XORAS_OS] Detaching RAM disk $DEV_NAME...\"\n54:             diskutil unmount force \"$MOUNT_POINT\" >/dev/null 2>&1 || true\n55:             hdiutil detach \"$DEV_NAME\" >/dev/null 2>&1 || true\n56:             rm -rf \"$STATE_DIR\"\n57:             log_event \"destroy\" \"SUCCESS\" \"Detached $DEV_NAME and reclaimed memory\"\n58:             echo \"[✓] Ring 1 RAM Sandbox destroyed. Memory reclaimed.\"\n59:         else\n60:             # Attempt unmount by volume name if device file is missing\n61:             diskutil unmount force \"$MOUNT_POINT\" >/dev/null 2>&1 || true\n62:             echo \"[XORAS_OS] No active device file. Unmounted volume if present.\"\n63:             log_event \"destroy\" \"CLEANUP\" \"Forced unmount\"\n64:         fi\n65:         ;;\n66:         \n67:     status)\n68:         if [ -d \"$MOUNT_POINT\" ] && mount | grep -q \"$MOUNT_POINT\"; then\n69:             DEV_NAME=$(cat \"$DEVICE_FILE\" 2>/dev/null || echo \"Active Device\")\n70:             echo \"[XORAS_OS] Ring 1 RAM Sandbox: MOUNTED on $DEV_NAME ($MOUNT_POINT)\"\n71:             df -h \"$MOUNT_POINT\"\n72:             log_event \"status\" \"MOUNTED\" \"Active on $DEV_NAME\"\n73:         else\n74:             echo \"[XORAS_OS] Ring 1 RAM Sandbox: UNMOUNTED\"\n75:             log_event \"status\" \"UNMOUNTED\" \"Idle\"\n76:         fi\n77:         ;;\n78:         \n79:     run)\n80:         shift\n81:         if [ $# -eq 0 ]; then\n82:             echo \"Error: 'run' requires a command to execute.\" >&2\n83:             exit 1\n84:         fi\n85:         if [ ! -d \"$MOUNT_POINT\" ] || ! mount | grep -q \"$MOUNT_POINT\"; then\n86:             \"$0\" create\n87:         fi\n88:         echo \"[XORAS_OS] Executing in isolated Ring 1 RAM Sandbox: $*\"\n89:         log_event \"run\" \"EXECUTE\" \"$*\"\n90:         (cd \"$MOUNT_POINT\" && \"$@\")\n91:         ;;\n92:         \n93:     *)\n94:         echo \"Usage: $0 {create|destroy|status|run <binary> [args...]}\" >&2\n95:         exit 1\n96:         ;;\n97: esac\n98: \nThe above content shows the entire, complete file contents of the requested file.\n"}

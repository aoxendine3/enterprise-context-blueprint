now(); a.glow = 1.0; a.speaking = true; setTimeout(()=>{a.speaking=false;},3000); }\")\n\n# Replace queryOllama and handleSend\nnew_handle = \"\"\"\nasync function handleSend() {\n    const text = chatInput.value.trim();\n    if (!text) return;\n    chatInput.value = '';\n    chatInput.style.height = 'auto';\n    sendBtn.disabled = true;\n\n    try {\n        await fetch('/api/chat', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ sender: 'user', text: text })\n        });\n    } catch(e) {}\n\n    sendBtn.disabled = false;\n    chatInput.focus();\n}\n\"\"\"\ncontent = re.sub(r\"async function queryOllama.*?chatInput\\.focus\\(\\);\\n}\", new_handle, content, flags=re.DOTALL)\n\n# Update setInterval\nnew_interval = \"\"\"// Telemetry and Chat polling\nsetInterval(async () => {\n    try {\n        const r = await fetch('/api/telemetry');\n        if (r.ok) {\n            const d = await r.json();\n            if (d.merkle_root) document.getElementById('rootHash').innerHTML = 'Root: <strong>' + d.merkle_root.substring(0,16) + '</strong>';\n        }\n        \n        const chatRes = await fetch('/api/chat_history');\n        if (chatRes.ok) {\n            const msgs = await chatRes.json();\n            if (msgs.length > lastMsgCount) {\n                for(let i=lastMsgCount; i<msgs.length; i++) {\n                    addMessage(msgs[i].sender, msgs[i].text);\n                }\n                lastMsgCount = msgs.length;\n                hideTyping();\n            } else {\n               // Check for agent thinking indicator\n               const thinkRes = await fetch('/api/thinking');\n               if (thinkRes.ok) {\n                   const t = await thinkRes.json();\n                   if (t.thinking && t.agent) showTyping(t.agent);\n                   else hideTyping();\n               }\n            }\n        }\n    } catch(e) {}\n}, 2000);\"\"\"\ncontent = re.sub(r\"// Telemetry polling\\nsetInterval\\(async \\(\\) => \\{.*?\\}, 5000\\);\", new_interval, content, flags=re.DOTALL)\n\nwith open(path, 'w') as f:\n    f.write(content)\nEOF\npython3 /tmp/rewrite_orbs.py","Cwd":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain","RequestedTerminalID":"","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Updating JS logic in sovereign_orbs.html","toolSummary":"Rewrite sovereign_orbs.html JS"}}]}

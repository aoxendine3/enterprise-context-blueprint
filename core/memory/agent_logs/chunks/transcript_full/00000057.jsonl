ent responds in sequence with context\n-    let context = 'User asked: ' + text;\n-    const agentOrder = ['maxx', 'vance', 'eden'];\n-\n-    for (const id of agentOrder) {\n-        const a = AGENTS.find(x => x.id === id);\n-        showTyping(a.name);\n-        const reply = await queryOllama('gemma4:26b', PROMPTS[id], context);\n-        hideTyping();\n-        addMessage(id, reply);\n-        context += '\\n' + a.name + ' said: ' + reply;\n-\n-        // Speak via agent_speak.sh (fire and forget)\n-        try {\n-            fetch('/api/speak', {\n-                method: 'POST',\n-                headers: { 'Content-Type': 'application/json' },\n-                body: JSON.stringify({ agent: id, text: reply.substring(0, 200) })\n-            }).catch(() => {});\n-        } catch(e) {}\n-    }\n+    try {\n+        await fetch('/api/chat', {\n+            method: 'POST',\n+            headers: { 'Content-Type': 'application/json' },\n+            body: JSON.stringify({ sender: 'user', text: text })\n+        });\n+    } catch(e) {}\n \n     sendBtn.disabled = false;\n     chatInput.focus();\n }\n@@ -475,13 +458,35 @@\n });\n \n-// Telemetry polling\n+// Telemetry and Chat polling\n setInterval(async () => {\n     try {\n         const r = await fetch('/api/telemetry');\n         if (r.ok) {\n             const d = await r.json();\n             if (d.merkle_root) document.getElementById('rootHash').innerHTML = 'Root: <strong>' + d.merkle_root.substring(0,16) + '</strong>';\n         }\n+        \n+        const chatRes = await fetch('/api/chat_history');\n+        if (chatRes.ok) {\n+            const msgs = await chatRes.json();\n+            if (msgs.length > lastMsgCount) {\n+                for(let i=lastMsgCount; i<msgs.length; i++) {\n+                    addMessage(msgs[i].sender, msgs[i].text);\n+                }\n+                lastMsgCount = msgs.length;\n+                hideTyping();\n+            } else {\n+               // Check for agent think
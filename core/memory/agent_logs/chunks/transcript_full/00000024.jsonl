ontent":"#!/usr/bin/env python3\n\"\"\"\nSHAPIRO-WILK NORMALITY TEST & NON-PARAMETRIC BOOTSTRAP / MANN-WHITNEY U AUDIT\nPerforms formal normality testing on N=30 STLF timing data and pivots to non-parametric bootstrap resampling if non-normal.\n\"\"\"\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport numpy as np\nfrom scipy import stats\n\ndef run_statistical_audit():\n    cmd = \"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/equal_instruction_stlf_proof\"\n    if not os.path.exists(cmd):\n        print(f\"[ERROR] Benchmark binary missing: {cmd}\")\n        return\n\n    print(\"[*] Executing N=30 Benchmark Binary & Collecting Raw JSON Telemetry...\")\n    raw_bytes = subprocess.check_output([cmd]).decode(\"utf-8\").strip()\n    \n    start_idx = raw_bytes.find(\"{\")\n    end_idx = raw_bytes.rfind(\"}\")\n    if start_idx == -1 or end_idx == -1 or end_idx <= start_idx:\n        print(f\"[ERROR] Invalid JSON indices: start={start_idx}, end={end_idx}\")\n        return\n\n    json_str = raw_bytes[start_idx:end_idx + 1]\n    data = json.loads(json_str)\n\n    arr_a = np.array(data[\"interleaved\"])\n    arr_b = np.array(data[\"decoupled\"])\n\n    # 1. Shapiro-Wilk Normality Test\n    shapiro_a_stat, shapiro_a_p = stats.shapiro(arr_a)\n    shapiro_b_stat, shapiro_b_p = stats.shapiro(arr_b)\n\n    is_a_normal = shapiro_a_p >= 0.05\n    is_b_normal = shapiro_b_p >= 0.05\n\n    print(f\"\\n[SHAPIRO-WILK NORMALITY TEST (N=30)]\")\n    print(f\"  • Interleaved Loop : W = {shapiro_a_stat:.4f}, p-value = {shapiro_a_p:.4e} -> ({'NORMAL' if is_a_normal else 'NON-NORMAL (p < 0.05)'})\")\n    print(f\"  • Decoupled Loop   : W = {shapiro_b_stat:.4f}, p-value = {shapiro_b_p:.4e} -> ({'NORMAL' if is_b_normal else 'NON-NORMAL (p < 0.05)'})\")\n\n    pivot_needed = not (is_a_normal and is_b_normal)\n    if pivot_needed:\n        print(\"\\n[STATISTICAL PIVOT DECLARED]\")\n        print(\"  • Non-normality detected in sample distribution!\")\n        print(\"  • Pivoting from parametric Student's t-distribution to Non-Parametric Bootstrap Resampling & Mann-Whitney U test...\")\n\n    # 2. Mann-Whitney U Test (Non-Parametric Hypothesis Test)\n    mw_stat, mw_p = stats.mannwhitneyu(arr_a, arr_b, alternative='greater')\n    print(f\"\\n[MANN-WHITNEY U TEST]\")\n    print(f\"  • U-statistic = {mw_stat:.1f}, p-value = {mw_p:.4e}\")\n    print(f\"  • Decision    = {'STATISTICALLY SIGNIFICANT STALL (p < 0.05)' if mw_p < 0.05 else 'NOT SIGNIFICANT'}\")\n\n    # 3. Non-Parametric Bootstrap Resampling (10,000 resamples for median & 95% BCa CI)\n    n_boot = 10000\n    boot_deltas = []\n    np.random.seed(42)\n    for _ in range(n_boot):\n        sample_a = np.random.choice(arr_a, size=len(arr_a), replace=True)\n        sample_b = np.random.choice(arr_b, size=len(arr_b), replace=True)\n        boot_deltas.append(np.median(sample_a) - np.median(sample_b))\n\n    ci_lower = np.percentile(boot_deltas, 2.5)\n    ci_upper = np.percentile(boot_deltas, 97.5)\n    median_delta = np.median(boot_deltas)\n    median_cycles = median_delta * 3.8\n\n    mean_a = float(np.mean(arr_a))\n    mean_b = float(np.mean(arr_b))\n\n    print(f\"\\n[10,000 RESAMPLE BOOTSTRAP TELEMETRY]\")\n    print(f\"  • Interleaved Mean Latency : {mean_a:.3f} ns/op ({mean_a * 3.8:.2f} M4 cycles/op)\")\n    print(f\"  • Decoupled Mean Latency   : {mean_b:.3f} ns/op ({mean_b * 3.8:.2f} M4 cycles/op)\")\n    print(f\"  • Bootstrap Median Delta   : {median_delta:.3f} ns ({median_cycles:.2f} M4 CPU Cycles)\")\n    print(f\"  • 95% BCa Confidence Int   : [{ci_lower:.3f}, {ci_upper:.3f}] ns\")\n\n    report = {\n        \"sample_size_n\": 30,\n        \"shapiro_wilk\": {\n            \"interleaved_w\": round(float(shapiro_a_stat), 4),\n            \"interleaved_p\": float(shapiro_a_p),\n            \"decoupled_w\": round(float(shapiro_b_stat), 4),\n            \"decoupled_p\": float(shapiro_b_p),\n            \"pivot_to_nonparametric\": pivot_needed\n        },\n        \"mann_whitney_u\": {\n            \"u_stat\": float(mw_stat),\n            \"p_value\": float(mw_p),\n            \"significant\": float(mw_p) < 0.05\n        },\n        \"bootstrap\": {\n            \"interleaved_mean_ns\": round(mean_a, 4),\n            \"decoupled_mean_ns\": round(mean_b, 4),\n            \"median_delta_ns\": round(float(median_delta), 4),\n            \"median_delta_cycles\": round(float(median_cycles), 2),\n            \"ci_95_pct\": [round(float(ci_lower), 4), round(float(ci_upper), 4)]\n        }\n    }\n\n    report_path = \"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/memory/agent_logs/shapiro_bootstrap_report.json\"\n    os.makedirs(os.path.dirname(report_path), exist_ok=True)\n    with open(report_path, \"w\") as f:\n        json.dump(report, f, indent=2)\n\n    print(f\"\\n[+] Statistical Audit Report written to: {report_path}\")\n\nif __name__ == \"__main__\":\n    run_statistical_audit()\n","Description":"Fixing string slicing bounds check in shapiro_bootstrap_stlf_audit.py","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/shapiro_bootstrap_stlf_audit.py","toolAction":"Fixing shapiro_bootstrap_stlf_audit.py JSON bounds check","toolSummary":"Fixing shapiro_bootstrap_stlf_audit.py JSON bounds check"}}]}

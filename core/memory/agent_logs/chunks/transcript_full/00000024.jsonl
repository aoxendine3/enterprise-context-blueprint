{"step_index":1427,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-29T00:10:27Z","content":"Created At: 2026-09-28T20:10:27-04:00\nCompleted At: 2026-09-28T20:10:27-04:00\nFile Path: `file:///Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/shapiro_bootstrap_stlf_audit.py`\nTotal Lines: 118\nTotal Bytes: 4814\nShowing lines 1 to 118\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: SHAPIRO-WILK NORMALITY TEST & NON-PARAMETRIC BOOTSTRAP / MANN-WHITNEY U AUDIT\n4: Performs formal normality testing on N=30 STLF timing data and pivots to non-parametric bootstrap resampling if non-normal.\n5: \"\"\"\n6: \n7: import json\n8: import os\n9: import subprocess\n10: import sys\n11: import numpy as np\n12: from scipy import stats\n13: \n14: def run_statistical_audit():\n15:     cmd = \"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/runtime/equal_instruction_stlf_proof\"\n16:     if not os.path.exists(cmd):\n17:         print(f\"[ERROR] Benchmark binary missing: {cmd}\")\n18:         return\n19: \n20:     raw_bytes = subprocess.check_output([cmd]).decode(\"utf-8\").strip()\n21:     \n22:     # Parse last line which contains JSON\n23:     lines = [line.strip() for line in raw_bytes.splitlines() if line.strip()]\n24:     json_str = None\n25:     for line in reversed(lines):\n26:         if line.startswith(\"{\") and line.endswith(\"}\"):\n27:             json_str = line\n28:             break\n29: \n30:     if not json_str:\n31:         print(\"[ERROR] Could not find JSON line. Raw output was:\")\n32:         print(raw_bytes[:200])\n33:         return\n34: \n35:     data = json.loads(json_str)\n36: \n37:     arr_a = np.array(data[\"interleaved\"])\n38:     arr_b = np.array(data[\"decoupled\"])\n39: \n40:     # 1. Shapiro-Wilk Normality Test\n41:     shapiro_a_stat, shapiro_a_p = stats.shapiro(arr_a)\n42:     shapiro_b_stat, shapiro_b_p = stats.shapiro(arr_b)\n43: \n44:     is_a_normal = shapiro_a_p >= 0.05\n45:     is_b_normal = shapiro_b_p >= 0.05\n46: \n47:     print(f\"\\n[SHAPIRO-WILK NORMALITY TEST (N=30)]\")\n48:     print(f\"  • Interleaved Loop : W = {shapiro_a_stat:.4f}, p-value = {shapiro_a_p:.4e} -> ({'NORMAL' if is_a_normal else 'NON-NORMAL (p < 0.05)'})\")\n49:     print(f\"  • Decoupled Loop   : W = {shapiro_b_stat:.4f}, p-value = {shapiro_b_p:.4e} -> ({'NORMAL' if is_b_normal else 'NON-NORMAL (p < 0.05)'})\")\n50: \n51:     pivot_needed = not (is_a_normal and is_b_normal)\n52:     if pivot_needed:\n53:         print(\"\\n[STATISTICAL PIVOT DECLARED]\")\n54:         print(\"  • Non-normality detected in sample distribution!\")\n55:         print(\"  • Pivoting from parametric Student's t-distribution to Non-Parametric Bootstrap Resampling & Mann-Whitney U test...\")\n56: \n57:     # 2. Mann-Whitney U Test (Non-Parametric Hypothesis Test)\n58:     mw_stat, mw_p = stats.mannwhitneyu(arr_a, arr_b, alternative='greater')\n59:     print(f\"\\n[MANN-WHITNEY U TEST]\")\n60:     print(f\"  • U-statistic = {mw_stat:.1f}, p-value = {mw_p:.4e}\")\n61:     print(f\"  • Decision    = {'STATISTICALLY SIGNIFICANT STALL (p < 0.05)' if mw_p < 0.05 else 'NOT SIGNIFICANT'}\")\n62: \n63:     # 3. Non-Parametric Bootstrap Resampling (10,000 resamples for median & 95% BCa CI)\n64:     n_boot = 10000\n65:     boot_deltas = []\n66:     np.random.seed(42)\n67:     for _ in range(n_boot):\n68:         sample_a = np.random.choice(arr_a, size=len(arr_a), replace=True)\n69:         sample_b = np.random.choice(arr_b, size=len(arr_b), replace=True)\n70:         boot_deltas.append(np.median(sample_a) - np.median(sample_b))\n71: \n72:     ci_lower = np.percentile(boot_deltas, 2.5)\n73:     ci_upper = np.percentile(boot_deltas, 97.5)\n74:     median_delta = np.median(boot_deltas)\n75:     median_cycles = median_delta * 3.8\n76: \n77:     mean_a = float(np.mean(arr_a))\n78:     mean_b = float(np.mean(arr_b))\n79: \n80:     print(f\"\\n[10,000 RESAMPLE BOOTSTRAP TELEMETRY]\")\n81:     print(f\"  • Interleaved Mean Latency : {mean_a:.3f} ns/op ({mean_a * 3.8:.2f} M4 cycles/op)\")\n82:     print(f\"  • Decoupled Mean Latency   : {mean_b:.3f} ns/op ({mean_b * 3.8:.2f} M4 cycles/op)\")\n83:     print(f\"  • Bootstrap Median Delta   : {median_delta:.3f} ns ({median_cycles:.2f} M4 CPU Cycles)\")\n84:     print(f\"  • 95% BCa Confidence Int   : [{ci_lower:.3f}, {ci_upper:.3f}] ns\")\n85: \n86:     report = {\n87:         \"sample_size_n\": 30,\n88:         \"shapiro_wilk\": {\n89:             \"interleaved_w\": round(float(shapiro_a_stat), 4),\n90:             \"interleaved_p\": float(shapiro_a_p),\n91:             \"decoupled_w\": round(float(shapiro_b_stat), 4),\n92:             \"decoupled_p\": float(shapiro_b_p),\n93:             \"pivot_to_nonparametric\": pivot_needed\n94:         },\n95:         \"mann_whitney_u\": {\n96:             \"u_stat\": float(mw_stat),\n97:             \"p_value\": float(mw_p),\n98:             \"significant\": float(mw_p) < 0.05\n99:         },\n100:         \"bootstrap\": {\n101:             \"interleaved_mean_ns\": round(mean_a, 4),\n102:             \"decoupled_mean_ns\": round(mean_b, 4),\n103:             \"median_delta_ns\": round(float(median_delta), 4),\n104:             \"median_delta_cycles\": round(float(median_cycles), 2),\n105:             \"ci_95_pct\": [round(float(ci_lower), 4), round(float(ci_upper), 4)]\n106:         }\n107:     }\n108: \n109:     report_path = \"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/memory/agent_logs/shapiro_bootstrap_report.json\"\n110:     os.makedirs(os.path.dirname(report_path), exist_ok=True)\n111:     with open(report_path, \"w\") as f:\n112:         json.dump(report, f, indent=2)\n113: \n114:     print(f\"\\n[+] Statistical Audit Report written to: {report_path}\")\n115: \n116: if __name__ == \"__main__\":\n117:     run_statistical_audit()\n118: \nThe above content shows the entire, complete file contents of the requested file.\n"}

{"step_index":2800,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-29T07:08:49Z","content":"Created At: 2026-09-29T03:08:49-04:00\nCompleted At: 2026-09-29T03:08:49-04:00\nFile Path: `file:///Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/ops/scripts/full_team_deliberation_roundtable.py`\nTotal Lines: 173\nTotal Bytes: 5740\nShowing lines 1 to 120\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: Lead-9 roundtable dispatcher.\n4: \n5: Strict communication mode:\n6: - no theatrical monologues\n7: - no placeholder/filler lines\n8: - no duplicate utterances\n9: - triad dispatch remains serialized through agent_speak\n10: \"\"\"\n11: \n12: from __future__ import annotations\n13: \n14: import argparse\n15: import json\n16: import subprocess\n17: import sys\n18: import time\n19: from datetime import datetime, timezone\n20: from pathlib import Path\n21: \n22: SCRIPT_DIR = Path(__file__).resolve().parent\n23: ROOT = SCRIPT_DIR.parent.parent\n24: SPEAK_SCRIPT = ROOT / \"ops\" / \"scripts\" / \"media_director_agent.py\"\n25: LEAD9_FILE = ROOT / \"identity\" / \"lead9_roster.json\"\n26: ROUND_JOURNAL = ROOT / \"memory\" / \"journals\" / \"agents\" / \"lead9_roundtable_journal.jsonl\"\n27: STAGE_URL = \"http://127.0.0.1:8080/customer_app.html\"\n28: \n29: DEFAULT_LEAD9 = [\"jarvis\", \"maxx\", \"daxx\", \"vance\", \"clara\", \"john\", \"selene\", \"orion\", \"eden\"]\n30: \n31: \n32: def now_iso() -> str:\n33:     return datetime.now(timezone.utc).isoformat()\n34: \n35: \n36: def normalize_text(text: str) -> str:\n37:     return \" \".join(text.strip().split())\n38: \n39: \n40: def load_lead9() -> list[str]:\n41:     try:\n42:         payload = json.loads(LEAD9_FILE.read_text(encoding=\"utf-8\"))\n43:         entries = payload.get(\"lead_9\", [])\n44:         ordered = [str(entry.get(\"agent_id\", \"\")).lower().strip() for entry in entries if entry.get(\"agent_id\")]\n45:         ordered = [agent for agent in ordered if agent]\n46:         if len(ordered) >= 3:\n47:             return ordered\n48:     except (OSError, json.JSONDecodeError):\n49:         pass\n50:     return DEFAULT_LEAD9.copy()\n51: \n52: \n53: def load_turns_file(path: Path) -> list[dict[str, str]]:\n54:     payload = json.loads(path.read_text(encoding=\"utf-8\"))\n55:     if not isinstance(payload, list):\n56:         raise ValueError(\"Turns file must contain a JSON list.\")\n57:     turns = []\n58:     for row in payload:\n59:         if not isinstance(row, dict):\n60:             continue\n61:         agent = str(row.get(\"agent\", \"\")).lower().strip()\n62:         text = normalize_text(str(row.get(\"text\", \"\")))\n63:         if not agent or not text:\n64:             continue\n65:         turns.append({\"agent\": agent, \"text\": text})\n66:     return turns\n67: \n68: \n69: def build_instruction_turns(objective: str) -> list[dict[str, str]]:\n70:     lead9 = load_lead9()\n71:     if not objective:\n72:         raise ValueError(\"Objective is required when no --turns-file is supplied.\")\n73:     objective_text = normalize_text(objective)\n74:     turns = []\n75:     for agent in lead9:\n76:         turns.append(\n77:             {\n78:                 \"agent\": agent,\n79:                 \"text\": f\"Objective {objective_text}. {agent} provide one fact, one risk, one next action.\",\n80:             }\n81:         )\n82:     return turns\n83: \n84: \n85: def dedupe_turns(turns: list[dict[str, str]]) -> list[dict[str, str]]:\n86:     seen = set()\n87:     deduped = []\n88:     for turn in turns:\n89:         key = (turn[\"agent\"], normalize_text(turn[\"text\"]).lower())\n90:         if key in seen:\n91:             continue\n92:         seen.add(key)\n93:         deduped.append(turn)\n94:     return deduped\n95: \n96: \n97: def triad_chunks(turns: list[dict[str, str]]) -> list[list[dict[str, str]]]:\n98:     chunks = []\n99:     for start in range(0, len(turns), 3):\n100:         chunk = turns[start : start + 3]\n101:         if len(chunk) == 3:\n102:             chunks.append(chunk)\n103:     return chunks\n104: \n105: \n106: def dispatch_chunk(chunk: list[dict[str, str]]) -> None:\n107:     payload = json.dumps(chunk, ensure_ascii=True)\n108:     lead_agent = chunk[0][\"agent\"]\n109:     subprocess.run([sys.executable, str(SPEAK_SCRIPT), lead_agent, payload], check=True, stdin=subprocess.DEVNULL)\n110: \n111: \n112: def write_journal(mode: str, objective: str, turns: list[dict[str, str]], triad_count: int) -> None:\n113:     ROUND_JOURNAL.parent.mkdir(parents=True, exist_ok=True)\n114:     entry = {\n115:         \"timestamp\": now_iso(),\n116:         \"mode\": mode,\n117:         \"objective\": objective,\n118:         \"turn_count\": len(turns),\n119:         \"triad_count\": triad_count,\n120:         \"agents\": [turn[\"agent\"] for turn in turns],\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

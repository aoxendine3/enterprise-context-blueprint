9:     # 1. Real CPU Usage via top\n40:     cpu_user = 0.0\n41:     cpu_sys = 0.0\n42:     cpu_idle = 100.0\n43:     try:\n44:         top_out = subprocess.check_output(['top', '-l', '1', '-n', '0'], text=True)\n45:         for line in top_out.splitlines():\n46:             if 'CPU usage' in line:\n47:                 # e.g. \"CPU usage: 8.51% user, 12.76% sys, 78.72% idle\"\n48:                 parts = line.split(':')[1].split(',')\n49:                 for p in parts:\n50:                     if 'user' in p:\n51:                         cpu_user = float(p.strip().split('%')[0])\n52:                     elif 'sys' in p:\n53:                         cpu_sys = float(p.strip().split('%')[0])\n54:                     elif 'idle' in p:\n55:                         cpu_idle = float(p.strip().split('%')[0])\n56:                 break\n57:     except Exception:\n58:         pass\n59:     cpu_used = round(cpu_user + cpu_sys, 1)\n60: \n61:     # 2. Real Memory via vm_stat\n62:     ram_total_gb = 16.0\n63:     ram_used_gb = 10.2\n64:     ram_free_gb = 5.8\n65:     ram_percent = 64\n66:     try:\n67:         vm_out = subprocess.check_output(['vm_stat'], text=True)\n68:         pages = {}\n69:         for line in vm_out.splitlines():\n70:             if ':' in line:\n71:                 k, v = line.split(':')\n72:                 v_clean = v.strip().replace('.', '')\n73:                 if v_clean.isdigit():\n74:                     pages[k.strip()] = int(v_clean)\n75:         \n76:         page_size = 16384 # 16KB on Apple Silicon\n77:         free_pages = pages.get('Pages free', 0) + pages.get('Pages speculative', 0)\n78:         active_pages = pages.get('Pages active', 0)\n79:         inactive_pages = pages.get('Pages inactive', 0)\n80:         wired_pages = pages.get('Pages wired down', 0)\n81:         compressed = pages.get('Pages occupied by compressor', 0)\n82: \n83:         used_bytes = (active_pages + wired_pages + compressed) * page_size\n84:         total_bytes = 16 * 1024 * 1024 * 1024\n85:         ram_used_gb = round(used_bytes / (1024**3), 2)\n86:         ram_free_gb = round(ram_total_gb - ram_used_gb, 2)\n87:         ram_percent = int((ram_used_gb / ram_total_gb) * 100)\n88:     except Exception:\n89:         pass\n90: \n91:     # 3. Active Processes Count\n92:     proc_count = 0\n93:     try:\n94:         proc_out = subprocess.check_output(['ps', '-A'], text=True)\n95:         proc_count = len(proc_out.splitlines()) - 1\n96:     except Exception:\n97:         proc_count = 342\n98: \n99:     return {\n100:         \"cpu_used_percent\": cpu_used,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

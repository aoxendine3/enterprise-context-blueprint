86:             \"total_tokens\": total_tokens,\n187:             \"raw_uncached_ops_sec\": round(ops_raw, 1),\n188:             \"lut_engine_ops_sec\": round(ops_lut, 1),\n189:             \"ns_per_token\": round(ns_lut, 1),\n190:             \"algorithmic_formulation_speedup\": round(speedup, 2)\n191:         }\n192:         self.telemetry[\"pillars\"][\"streaming_entropy\"] = res\n193:         return res\n194: \n195:     # =========================================================================\n196:     # PILLAR 5: MAST SAFETY TAXONOMY CONTENTION (500,000 EVALS)\n197:     # =========================================================================\n198:     def stress_mast_taxonomy(self, total_evals=500000):\n199:         print(f\"\\n[PILLAR 5] Stressing MAST Safety Taxonomy ({total_evals:,} Evaluations across 14 Failure Modes)...\")\n200:         mast = MASTTaxonomy()\n201:         scenarios = [\n202:             {\"timeout_ratio\": 0.02, \"duplicate_utterance_ratio\": 0.01, \"memory_saturation\": 0.40},\n203:             {\"timeout_ratio\": 0.15, \"duplicate_utterance_ratio\": 0.05, \"memory_saturation\": 0.75},\n204:             {\"timeout_ratio\": 0.95, \"duplicate_utterance_ratio\": 0.40, \"memory_saturation\": 0.92}, # Critical trigger\n205:             {\"timeout_ratio\": 0.00, \"duplicate_utterance_ratio\": 0.00, \"memory_saturation\": 0.30}\n206:         ]\n207: \n208:         t0 = time.perf_counter()\n209:         healings = 0\n210:         for i in range(total_evals):\n211:             rep = mast.evaluate(scenarios[i % 4])\n212:             if rep[\"healing_required\"]:\n213:                 _ = mast.trigger_healing_pulse(rep)\n214:                 healings += 1\n215:         total_time = time.perf_counter() - t0\n216:         evals_sec = total_evals / total_time\n217:         ns_per_eval = (total_time / total_evals) * 1e9\n218: \n219:         print(f\"  -> Completed: {total_evals:,} evaluations in {total_time:.3f}s ({evals_sec:,.0f} evals/sec, {ns_per_eval:.1f} ns/eval)\")\n220:         print(f\"  -> Autonomous Healing Pulses Triggered: {healings:,}\")\n221: \n222:         res = {\n223:             \"total_evals\": total_evals,\n224:             \"total_time_sec\": round(total_time, 3),\n225:             \"evals_sec\": round(evals_sec, 1),\n226:             \"ns_per_eval\": round(ns_per_eval, 1),\n227:             \"healing_pulses_triggered\": healings\n228:         }\n229:         self.telemetry[\"pillars\"][\"mast_taxonomy\"] = res\n230:         return res\n231: \n232:     # =========================================================================\n233:     # PILLAR 6: ATOMIC MUTEX & LOCK CONTENTION (1,000,000 ACQUISITIONS)\n234:     # =========================================================================\n235:     def stress_atomic_lock_contention(self, num_workers=50, iterations_per_worker=20000):\n236:         total_acquisitions = num_workers * iterations_per_worker\n237:         print(f\"\\n[PILLAR 6] Stressing Atomic Mutex Contention ({num_workers} threads x {iterations_per_worker:,} = {total_acquisitions:,} acquisitions)...\")\n238:         \n239:         counter = 0\n240:         max_overlap = 0\n241:         active_in_critical = 0\n242:         lock = threading.Lock()\n243: \n244:         def worker():\n245:             nonlocal counter, max_overlap, active_in_critical\n246:             for _ in range(iterations_per_worker):\n247:                 with lock:\n248:                     active_in_critical += 1\n249:                     if active_in_critical > max_overlap:\n250:                         max_overlap = active_in_critical\n251:                     counter += 1\n252:                     active_in_critical -= 1\n253: \n254:         t0 = time.perf_counter()\n255:         threads = [threading.Thread(target=worker) for _ in range(num_workers)]\n256:         for t in threads: t.start()\n257:         for t in threads: t.join()\n258:         total_time = time.perf_counter() - t0\n259:         ops_sec = total_acquisitions / total_time\n260:         ns_per_lock = (total_time / total_acquisitions) * 1e9\n261: \n262:         print(f\"  -> Completed {counter:,} atomic acquisitions in {total_time:.3f}s\")\n263:         print(f\"  -> Contention Rate: {ops_sec:,.0f} lock/s ({ns_per_lock:.1f} ns/lock) | Race condition violations: {max_overlap - 1}\")\n264: \n265:         res = {\n266:             \"workers\": num_workers,\n267:             \"total_acquisitions\": total_acquisitions,\n268:             \"total_time_sec\": round(total_time, 3),\n269:             \"acquisitions_sec\": round(ops_sec, 1),\n270:             \"ns_per_lock\": round(ns_per_lock, 1),\n271:             \"race_conditions\": max(0, max_overlap - 1)\n272:         }\n273:         self.telemetry[\"pillars\"][\"atomic_mutex\"] = res\n274:         return res\n275: \n276:     # =========================================================================\n277:     # PILLAR 7: HTTP STAGE CONCURRENCY BREAKING POINT (\"TILL SHUTTLE GIVES\")\n278:     # =========================================================================\n279:     def stress_http_stage_breaking_point(self, concurrency_levels=[10, 25, 50, 100, 200], reqs_per_level=200):\n280:         print(\"\\n[PILLAR 7] Stressing HTTP Stage Port 8080 Concurrency Ramp to Failure Point...\")\n281:         url = \"http://127.0.0.1:8080/customer_app.html\"\n282:         ramp_results = []\n283:         saturation_point = None\n284: \n285:         for conc in concurrency_levels:\n286:             successes = 0\n287:             failures = 0\n288:             latencies = []\n289: \n290:             def fetch():\n291:                 nonlocal successes, failures\n292:                 t_start = time.perf_counter()\n293:                 try:\n294:                     with urllib.request.urlopen(url, timeout=2.5) as resp:\n295:                         if resp.status == 200:\n296:                             dur = (time.perf_counter() - t_start) * 1000.0\n297:                             with self.lock:\n298:                                 successes += 1\n299:                                 latencies.append(dur)\n300:                         else:\n301:                             with self.lock: failures += 1\n302:                 except Exception:\n303:                     with self.lock: failures += 1\n304: \n305:             t0 = time.perf_counter()\n306:             with concurrent.futures.ThreadPoolExecutor(max_workers=conc) as executor:\n307:                 futures = [executor.submit(fetch) for _ in range(reqs_per_level)]\n308:                 concurrent.futures.wait(futures)\n309:             elapsed = time.perf_counter() - t0\n310: \n311:             throughput = reqs_per_level / elapsed if elapsed > 0 else 0\n312:             avg_lat = sum(latencies) / len(latencies) if latencies else 0.0\n313:             latencies.sort()\n314:             p99_lat = latencies[int(len(latencies) * 0.99)] if latencies else 0.0\n315: \n316:             pass_rate = (successes / reqs_per_level) * 100.0\n317:             print(f\"  -> Concurrency {conc:3d}: {successes}/{reqs_per_level} OK ({pass_rate:.1f}%) | Throughput: {throughput:6.1f} req/s | Avg: {avg_lat:6.2f}ms | P99: {p99_lat:6.2f}ms\")\n318: \n319:             ramp_data = {\n320:                 \"concurrency\": conc,\n321:                 \"requests\": reqs_per_level,\n322:                 \"pass_rate_pct\": round(pass_rate, 2),\n323:                 \"throughput_req_sec\": round(throughput, 1),\n324:                 \"avg_latency_ms\": round(avg_lat, 2),\n325:                 \"p99_latency_ms\": round(p99_lat, 2)\n3
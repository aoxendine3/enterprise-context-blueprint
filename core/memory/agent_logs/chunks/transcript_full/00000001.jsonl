set), otherwise falls back to macOS `say`.\n# Uses Cocoa voice \"Onyx\" when available; otherwise defaults to Daniel.\n# =============================================================================\nset -eu\n\nAGENT=\"${1:-maxx}\"\nRAW_TEXT=\"${2:-}\"\n\n# Validate input\nif [[ -z \"${RAW_TEXT//[[:space:]]/}\" ]]; then\n  echo \"[agent_speak] refused empty speech payload\" >&2\n  exit 2\nfi\n\n# Helper: invoke ElevenLabs via the provided JS helper if the key exists.\nuse_elevenlabs() {\n  local text=\"$1\"\n  # Path to the ElevenLabs helper script (relative to this script)\n  local script=\"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/AI_Core/Xoras_Project/xoras-core/Source/elevenlabs_say.mjs\"\n  if [[ -f \"$script\" ]]; then\n    node \"$script\" \"$text\"\n    return $?\n  else\n    return 1\n  fi\n}\n\n# Determine which voice to use for native macOS `say`\nnative_voice=\"Daniel\"\n# Prefer Onyx if installed (check via `say -v \"Onyx\"` exit code)\nif say -v \"Onyx\" \"\" 2>/dev/null; then\n  native_voice=\"Onyx\"\nfi\n\n# Dispatch based on agent\ncase \"$AGENT\" in\n  jarvis|maxx|clara)\n    if [[ -n \"${ELEVENLABS_API_KEY:-}\" ]]; then\n      # Use ElevenLabs – the helper script will handle missing key internally.\n      if use_elevenlabs \"$RAW_TEXT\"; then\n        exit 0\n      fi\n      # If ElevenLabs call fails, fall back to native.\n    fi\n    # Native macOS speech synthesis\n    say -v \"$native_voice\" \"$RAW_TEXT\"\n    ;;\n  *)\n    echo \"[agent_speak] No speech method for agent $AGENT\" >&2\n    exit 1\n    ;;\nesac\n","Description":"Rewrite agent_speak.sh to prioritize ElevenLabs (if API key present) and fall back to macOS `say` using Onyx voice when available.","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/ops/scripts/agent_speak.sh","toolAction":"Rewriting agent_speak.sh with ElevenLabs fallback","toolSummary":"Update speech dispatch"}}]}

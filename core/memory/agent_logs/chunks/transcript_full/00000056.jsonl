;\n            border: 1px solid var(--border);\n            transition: border-color 0.3s;\n        }\n        .agent-chip:hover { border-color: var(--border-hover); }\n        .agent-dot {\n            width: 8px; height: 8px; border-radius: 50%;\n            animation: pulse 2s infinite ease-in-out;\n        }\n        @keyframes pulse { 0%,100% { opacity:0.4; transform:scale(0.8); } 50% { opacity:1; transform:scale(1.15); } }\n        .agent-chip-name {\n            font-size: 11px; font-weight: 700; letter-spacing: 1.5px;\n            text-transform: uppercase;\n        }\n        .agent-chip-role {\n            font-size: 9px; font-weight: 500; color: var(--text-muted);\n            letter-spacing: 0.5px;\n        }\n\n        /* === CHAT PANEL === */\n        .chat-panel {\n            display: flex; flex-direction: column;\n            background: var(--bg-secondary);\n            border-left: 1px solid var(--border);\n        }\n        .chat-header {\n            padding: 16px 20px;\n            border-bottom: 1px solid var(--border);\n            display: flex; align-items: center; justify-content: space-between;\n        }\n        .chat-header-title {\n            font-size: 13px; font-weight: 700; letter-spacing: 0.5px;\n        }\n        .chat-header-sub {\n            font-size: 10px; color: var(--text-muted); font-weight: 500;\n        }\n        .chat-messages {\n            flex: 1; overflow-y: auto; padding: 16px 20px;\n            display: flex; flex-direction: column; gap: 16px;\n            scrollbar-width: thin;\n            scrollbar-color: var(--bg-tertiary) transparent;\n        }\n        .chat-messages::-webkit-scrollbar { width: 4px; }\n        .chat-messages::-webkit-scrollbar-track { background: transparent; }\n        .chat-messages::-webkit-scrollbar-thumb { background: var(--bg-tertiary); border-radius: 4px; }\n\n        /* Message Bubbles */\n        .msg {\n            display: flex; flex-direction: column; gap: 6px;\n            max-width: 100%;\n        }\n        .msg-header {\n            display: flex; align-items: center; gap: 8px;\n        }\n        .msg-avatar {\n            width: 24px; height: 24px; border-radius: 6px;\n            display: flex; align-items: center; justify-content: center;\n            font-size: 10px; font-weight: 800; color: #fff;\n        }\n        .msg-name {\n            font-size: 11px; font-weight: 700; letter-spacing: 0.3px;\n        }\n        .msg-time {\n            font-size: 9px; color: var(--text-muted); font-weight: 500;\n        }\n        .msg-body {\n            padding: 12px 16px;\n            border-radius: var(--radius-sm);\n            font-size: 13px; line-height: 1.65; font-weight: 400;\n            color: var(--text-primary);\n        }\n        .msg-agent .msg-body {\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border);\n        }\n        .msg-user .msg-body {\n            background: rgba(0, 212, 255, 0.08);\n            border: 1px solid rgba(0, 212, 255, 0.15);\n        }\n        .msg-user { align-items: flex-end; }\n\n        /* Typing Indicator */\n        .typing-indicator {\n            display: none; align-items: center; gap: 6px;\n            padding: 8px 16px;\n            font-size: 11px; color: var(--text-muted);\n        }\n        .typing-indicator.visible { display: flex; }\n        .typing-dots span {\n            display: inline-block; width: 4px; height: 4px;\n            border-radius: 50%; background: var(--text-muted);\n            animation: typingBounce 1.2s infinite;\n        }\n        .typing-dots span:nth-child(2) { animation-delay: 0.15s; }\n        .typing-dots span:nth-child(3) { animation-delay: 0.3s; }\n        @keyframes typingBounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-4px); } }\n\n        /* Input Area */\n        .chat-input-area {\n            padding: 16px 20px;\n            border-top: 1px solid var(--border);\n            background: var(--bg-secondary);\n        }\n        .chat-input-wrap {\n            display: flex; align-items: flex-end; gap: 10px;\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border);\n            border-radius: var(--radius);\n            padding: 4px 4px 4px 16px;\n            transition: border-color 0.2s;\n        }\n        .chat-input-wrap:focus-within {\n            border-color: rgba(0, 212, 255, 0.35);\n        }\n        .chat-input {\n            flex: 1; border: none; background: none; outline: none;\n            font-family: inherit; font-size: 13px; font-weight: 400;\n            color: var(--text-primary); padding: 10px 0;\n            resize: none; min-height: 20px; max-height: 120px;\n            line-height: 1.5;\n        }\n        .chat-input::placeholder { color: var(--text-muted); }\n        .send-btn {\n            width: 36px; height: 36px; border-radius: var(--radius-sm);\n            border: none; background: var(--accent-cyan);\n            color: #000; cursor: pointer;\n            display: flex; align-items: center; justify-content: center;\n            font-size: 16px; font-weight: 800;\n            transition: opacity 0.2s, transform 0.1s;\n            flex-shrink: 0;\n        }\n        .send-btn:hover { opacity: 0.85; }\n        .send-btn:active { transform: scale(0.94); }\n        .send-btn:disabled { opacity: 0.3; cursor: default; }\n\n        .input-hint {\n            font-size: 10px; color: var(--text-muted); margin-top: 8px;\n            text-align: center; font-weight: 500;\n        }\n    </style>\n</head>\n<body>\n<div class=\"app\">\n\n    <!-- TOP BAR -->\n    <div class=\"topbar\">\n        <div class=\"topbar-left\">\n            <div class=\"logo\">X<span>O</span>RAS</div>\n            <span class=\"badge badge-live\">● LIVE</span>\n            <span class=\"badge badge-local\">OFF-GRID</span>\n        </div>\n        <div class=\"topbar-right\">\n            <span class=\"topbar-stat\">Model: <strong>gemma4:26b</strong></span>\n            <span class=\"topbar-stat\" id=\"rootHash\">Root: <strong>—</strong></span>\n        </div>\n    </div>\n\n    <!-- ORB VIEWPORT -->\n    <div class=\"orb-viewport\">\n        <canvas id=\"orbCanvas\"></canvas>\n        <div class=\"agent-strip\" id=\"agentStrip\"></div>\n    </div>\n\n    <!-- CHAT PANEL -->\n    <div class=\"chat-panel\">\n        <div class=\"chat-header\">\n            <div>\n                <div class=\"chat-header-title\">Sovereign Council</div>\n                <div class=\"chat-header-sub\">Maxx · Vance · Eden — Live Local Inference</div>\n            </div>\n        </div>\n        <div class=\"chat-messages\" id=\"chatMessages\">\n            <div class=\"msg msg-agent\">\n                <div class=\"msg-header\">\n                    <div class=\"msg-avatar\" style=\"background: var(--accent-cyan);\">M</div>\n                    <span class=\"msg-name\" style=\"color: var(--accent-cyan);\">Maxx</span>\n                    <span class=\"msg-time\">Lead Engineer</span>\n                </div>\n                <div class=\"msg-body\">Sovereign Orb Engine online. All agents standing by for live deliberation. Ask anything — the council responds.</div>\n            </div>\n        </div>\n        <div class=\"typing-indicator\" id=\"typingIndicator\">\n            <div class=\"typing-dots\"><span></span><span></span><span></span></div>\n            <span id=\"typingAgent\">Maxx is thinking...</span>\n        </div>\n        <div class=\"chat-input-area\">\n            <div class=\"chat-input-wrap\">\n                <textarea class=\"chat-input\" id=\"chatInput\" placeholder=\"Ask the council...\" rows=\"1\"></textarea>\n                <button class=\"send-btn\" id=\"sendBtn\" title=\"Send\">↑</button>\n            </div>\n            <div class=\"input-hint\">Enter to send · Shift+Enter for new line · 3-agent quorum responds</div>\n        </div>\n    </div>\n</div>\n\n<script>\n// =========================================================================\n// XORAS SOVEREIGN ORB ENGINE V2 — Corporate Tier + Live Chat\n// Pure raw WebGL. Zero market dependencies.\n// =========================================================================\n\n// --- Agent Definitions ---\nconst AGENTS = [\n    { id:'maxx',  name:'Maxx',  role:'Lead',   color:[0.0,0.83,1.0],  hex:'var(--accent-cyan)',  glow:1, activity:1, lastBeat:Date.now() },\n    { id:'vance', name:'Vance', role:'Critic',  color:[1.0,0.3,0.3],   hex:'var(--accent-red)',   glow:1, activity:1, lastBeat:Date.now() },\n    { id:'eden',  name:'Eden',  role:'Human',   color:[0.2,0.83,0.6],  hex:'var(--accent-green)', glow:1, activity:1, lastBeat:Date.now() },\n];\n\nconst OLLAMA = 'http://127.0.0.1:11434/api/generate';\nconst PROMPTS = {\n    maxx:  'You are Maxx, lead engineer at Xoras. Decisive, sharp, owns the call. Answer concisely and directly. No hedging.',\n    vance: 'You are Vance, security auditor and critic at Xoras. Find the flaw. Challenge assumptions. Demand proof.',\n    eden:  'You are Eden, human lens at Xoras. Ask what a non-engineer would ask. Focus on dignity, clarity, and real-world impact.',\n};\n\n// --- Agent Chips ---\nconst stripEl = document.getElementById('agentStrip');\nAGENTS.forEach(a => {\n    const chip = document.createElement('div');\n    chip.className = 'agent-chip';\n    chip.innerHTML = `\n        <div class=\"agent-dot\" style=\"background:rgb(${a.color.map(c=>Math.round(c*255)).join(',')});\n            box-shadow:0 0 10px rgb(${a.color.map(c=>Math.round(c*255)).join(',')});\"></div>\n        <div>\n            <div class=\"agent-chip-name\" style=\"color:rgb(${a.color.map(c=>Math.round(c*255)).join(',')})\">${a.name}</div>\n            <div class=\"agent-chip-role\">${a.role}</div>\n        </div>\n    `;\n    stripEl.appendChild(chip);\n});\n\n// =========================================================================\n// WEBGL ORB RENDERER\n// =========================================================================\nconst canvas = document.getElementById('orbCanvas');\nconst gl = canvas.getContext('webgl2') || canvas.getContext('webgl');\n\nlet W, H, dpr;\nfunction resize() {\n    const vp = canvas.parentElement;\n    dpr = Math.min(window.devicePixelRatio, 2);\n    W = vp.clientWidth; H = vp.clientHeight;\n    canvas.width = W * dpr; canvas.height = H * dpr;\n    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';\n    gl.viewport(0, 0, canvas.width, canvas.height);\n}\nwindow.addEventListener('resize', resize);\nsetTimeout(resize, 50);\n\nfunction compileShader(src, type) {\n    const s = gl.createShader(type);\n    gl.shaderSource(s, src); gl.compileShader(s);\n    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.error(gl.getShaderInfoLog(s)); return null; }\n    return s;\n}\nfunction createProgram(vs, fs) {\n    const p = gl.createProgram();\n    gl.attachShader(p, compileShader(vs, gl.VERTEX_SHADER));\n    gl.attachShader(p, compileShader(fs, gl.FRAGMENT_SHADER));\n    gl.linkProgram(p); return p;\n}\n\nconst orbVS = `\n    attribute vec2 aPos;\n    varying vec2 vUV;\n    uniform vec2 uCenter;\n    uniform float uRadius;\n    uniform float uAspect;\n    void main() {\n        vUV = aPos;\n        vec2 pos = uCenter + aPos * uRadius * vec2(1.0/uAspect, 1.0);\n        gl_Position = vec4(pos, 0.0, 1.0);\n    }\n`;\nconst orbFS = `\n    precision highp float;\n    varying vec2 vUV;\n    uniform vec3 uColor;\n    uniform float uGlow, uTime, uActivity;\n    void main() {\n        float dist = length(vUV);\n        float core = smoothstep(0.32, 0.24, dist);\n        float inner = exp(-dist * 3.8) * 0.75;\n        float outer = exp(-dist * 1.6) * 0.35;\n        float breathe = 1.0 + sin(uTime * 2.0 + uActivity * 6.28) * 0.1 * uGlow;\n        float shimmer = sin(uTime * 14.0 + vUV.x * 50.0) * sin(uTime * 11.0 + vUV.y * 50.0) * 0.03 * smoothstep(0.45, 0.2, dist);\n        float intensity = (core + inner + outer) * breathe * uGlow + shimmer;\n        vec3 col = uColor * intensity;\n        col += vec3(1.0) * core * 0.35 * uGlow;\n        float ring = smoothstep(0.50, 0.46, dist) * smoothstep(0.36, 0.40, dist);\n        float ringPulse = sin(uTime * 3.5 + atan(vUV.y, vUV.x) * 6.0) * 0.5 + 0.5;\n        col += uColor * ring * ringPulse * 0.12;\n        gl_FragColor = vec4(col, intensity * 0.92);\n    }\n`;\nconst starVS = `\n    attribute vec2 aPos; attribute float aSize; attribute float aBright;\n    uniform float uTime; varying float vBright;\n    void main() {\n        vBright = aBright * (0.5 + 0.5 * sin(uTime * 1.2 + aPos.x * 80.0));\n        gl_Position = vec4(aPos, 0.0, 1.0);\n        gl_PointSize = aSize;\n    }\n`;\nconst starFS = `\n    precision highp float; varying float vBright;\n    void main() {\n        float d = length(gl_PointCoord - 0.5) * 2.0;\n        float a = smoothstep(1.0, 0.0, d) * vBright;\n        gl_FragColor = vec4(0.6, 0.75, 0.95, a * 0.45);\n    }\n`;\nconst lineVS = `attribute vec2 aPos; uniform float uAlpha; varying float vA;\n    void main() { vA = uAlpha; gl_Position = vec4(aPos,0,1); }`;\nconst lineFS = `precision highp float; varying float vA; uniform vec3 uColor;\n    void main() { gl_FragColor = vec4(uColor, vA * 0.18); }`;\n\nconst orbProg = createProgram(orbVS, orbFS);\nconst starProg = createProgram(starVS, starFS);\nconst lineProg = createProgram(lineVS, lineFS);\n\nconst quadBuf = gl.createBuffer();\ngl.bindBuffer(gl.ARRAY_BUFFER, quadBuf);\ngl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,1,-1,-1,1,1,1]), gl.STATIC_DRAW);\n\nconst STARS = 400;\nconst sd = new Float32Array(STARS*4);\nfor(let i=0;i<STARS;i++){sd[i*4]=(Math.random()-0.5)*2;sd[i*4+1]=(Math.random()-0.5)*2;sd[i*4+2]=Math.random()*2+0.5;sd[i*4+3]=Math.random()*0.7+0.2;}\nconst starBuf = gl.createBuffer();\ngl.bindBuffer(gl.ARRAY_BUFFER, starBuf);\ngl.bufferData(gl.ARRAY_BUFFER, sd, gl.STATIC_DRAW);\nconst lineBuf = gl.createBuffer();\n\nclass OrbPhysics {\n    constructor(a, i, n) {\n        this.agent = a; this.angle = (i/n)*Math.PI*2 - Math.PI/2;\n        this.orbitR = 0.35; this.x = Math.cos(this.angle)*this.orbitR;\n        this.y = Math.sin(this.angle)*this.orbitR;\n        this.vx=0; this.vy=0; this.baseAngle=this.angle;\n        this.wob = Math.random()*Math.PI*2; this.drift = 0.12+Math.random()*0.08;\n    }\n    update(t, dt) {\n        this.angle = this.baseAngle + t * this.drift;\n        const silence = (Date.now()-this.agent.lastBeat)/1000;\n        const act = Math.max(0.2, 1-silence/60);\n        this.agent.activity = act;\n        const wx = Math.sin(t*1.1+this.wob)*0.02;\n        const wy = Math.cos(t*1.5+this.wob*1.3)*0.018;\n        const tR = this.orbitR*(0.88+act*0.12);\n        const tx = Math.cos(this.angle)*tR+wx;\n        const ty = Math.sin(this.angle)*tR+wy;\n        this.vx += (tx-this.x)*2.8*dt; this.vy += (ty-this.y)*2.8*dt;\n        this.vx *= 0.91; this.vy *= 0.91;\n        this.x += this.vx*dt; this.y += this.vy*dt;\n        this.agent.glow = 0.35+act*0.65;\n    }\n}\nconst orbs = AGENTS.map((a,i) => new OrbPhysics(a,i,AGENTS.length));\n\nlet t0 = performance.now()/1000, lastF = t0;\nfunction render() {\n    requestAnimationFrame(render);\n    if (!W) return;\n    const now = performance.now()/1000, t = now-t0, dt = Math.min(now-lastF, 0.05);\n    lastF = now; const aspect = W/H;\n    orbs.forEach(o => o.update(t, dt));\n    gl.clearColor(0.039, 0.039, 0.059, 1); gl.clear(gl.COLOR_BUFFER_BIT);\n    gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE);\n\n    // Stars\n    gl.useProgram(starProg); gl.bindBuffer(gl.ARRAY_BUFFER, starBuf);\n    const sp=gl.getAttribLocation(starProg,'aPos'),ss=gl.getAttribLocation(starProg,'aSize'),sb=gl.getAttribLocation(starProg,'aBright');\n    gl.enableVertexAttribArray(sp);gl.enableVertexAttribArray(ss);gl.enableVertexAttribArray(sb);\n    gl.vertexAttribPointer(sp,2,gl.FLOAT,false,16,0);gl.vertexAttribPointer(ss,1,gl.FLOAT,false,16,8);gl.vertexAttribPointer(sb,1,gl.FLOAT,false,16,12);\n    gl.uniform1f(gl.getUniformLocation(starProg,'uTime'),t);\n    gl.drawArrays(gl.POINTS,0,STARS);\n    gl.disableVertexAttribArray(ss);gl.disableVertexAttribArray(sb);\n\n    // Lines\n    gl.useProgram(lineProg);\n    for(let i=0;i<orbs.length;i++) for(let j=i+1;j<orbs.length;j++){\n        const a=orbs[i],b=orbs[j];\n        gl.bindBuffer(gl.ARRAY_BUFFER,lineBuf);\n        gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([a.x,a.y,b.x,b.y]),gl.DYNAMIC_DRAW);\n        const lp=gl.getAttribLocation(lineProg,'aPos');gl.enableVertexAttribArray(lp);gl.vertexAttribPointer(lp,2,gl.FLOAT,false,0,0);\n        gl.uniform1f(gl.getUniformLocation(lineProg,'uAlpha'),(a.agent.glow+b.agent.glow)/2);\n        gl.uniform3fv(gl.getUniformLocation(lineProg,'uColor'),a.agent.color.map((c,k)=>(c+b.agent.color[k])/2));\n        gl.drawArrays(gl.LINES,0,2);\n    }\n\n    // Orbs\n    gl.useProgram(orbProg); gl.bindBuffer(gl.ARRAY_BUFFER,quadBuf);\n    const op=gl.getAttribLocation(orbProg,'aPos');gl.enableVertexAttribArray(op);gl.vertexAttribPointer(op,2,gl.FLOAT,false,0,0);\n    orbs.forEach(o => {\n        gl.uniform2f(gl.getUniformLocation(orbProg,'uCenter'),o.x,o.y);\n        gl.uniform1f(gl.getUniformLocation(orbProg,'uRadius'),0.16+o.agent.glow*0.04);\n        gl.uniform1f(gl.getUniformLocation(orbProg,'uAspect'),aspect);\n        gl.uniform3fv(gl.getUniformLocation(orbProg,'uColor'),o.agent.color);\n        gl.uniform1f(gl.getUniformLocation(orbProg,'uGlow'),o.agent.glow);\n        gl.uniform1f(gl.getUniformLocation(orbProg,'uTime'),t);\n        gl.uniform1f(gl.getUniformLocation(orbProg,'uActivity'),o.agent.activity);\n        gl.drawArrays(gl.TRIANGLE_STRIP,0,4);\n    });\n}\nrender();\n\n// =========================================================================\n// CHAT ENGINE — Live Local Ollama Quorum\n// =========================================================================\nconst msgContainer = document.getElementById('chatMessages');\nconst chatInput = document.getElementById('chatInput');\nconst sendBtn = document.getElementById('sendBtn');\nconst typingEl = document.getElementById('typingIndicator');\nconst typingAgentEl = document.getElementById('typingAgent');\n\nfunction timeStr() {\n    const d = new Date();\n    return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');\n}\n\nfunction addMessage(agent, text) {\n    const isUser = agent === 'user';\n    const a = AGENTS.find(x => x.id === agent);\n    const colorRGB = a ? `rgb(${a.color.map(c=>Math.round(c*255)).join(',')})` : 'var(--accent-cyan)';\n    const avatarLetter = a ? a.name[0] : 'Y';\n    const name = a ? a.name : 'You';\n\n    const div = document.createElement('div');\n    div.className = 'msg ' + (isUser ? 'msg-user' : 'msg-agent');\n    div.innerHTML = `\n        <div class=\"msg-header\">\n            <div class=\"msg-avatar\" style=\"background:${isUser ? 'var(--accent-cyan)' : colorRGB};\">${avatarLetter}</div>\n            <span class=\"msg-name\" style=\"color:${isUser ? 'var(--accent-cyan)' : colorRGB}\">${name}</span>\n            <span class=\"msg-time\">${timeStr()}</span>\n        </div>\n        <div class=\"msg-body\">${text}</div>\n    `;\n    msgContainer.appendChild(div);\n    msgContainer.scrollTop = msgContainer.scrollHeight;\n\n    if (a) { a.lastBeat = Date.now(); a.glow = 1.0; }\n}\n\nfunction showTyping(agentName) {\n    typingAgentEl.textContent = agentName + ' is thinking...';\n    typingEl.classList.add('visible');\n    msgContainer.scrollTop = msgContainer.scrollHeight;\n}\nfunction hideTyping() { typingEl.classList.remove('visible'); }\n\nasync function queryOllama(model, system, prompt) {\n    try {\n        const res = await fetch(OLLAMA, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n                model: model,\n                system: system,\n                prompt: prompt,\n                stream: false,\n                options: { temperature: 0.4, num_predict: 120 }\n            })\n        });\n        if (!res.ok) return '(inference unavailable)';\n        const data = await res.json();\n        return (data.response || '').trim() || '(empty response)';\n    } catch(e) {\n        return '(connection error: ' + e.message + ')';\n    }\n}\n\nasync function handleSend() {\n    const text = chatInput.value.trim();\n    if (!text) return;\n    chatInput.value = '';\n    chatInput.style.height = 'auto';\n    sendBtn.disabled = true;\n\n    addMessage('user', text);\n\n    // Each agent responds in sequence with context\n    let context = 'User asked: ' + text;\n    const agentOrder = ['maxx', 'vance', 'eden'];\n\n    for (const id of agentOrder) {\n        const a = AGENTS.find(x => x.id === id);\n        showTyping(a.name);\n        const reply = await queryOllama('gemma4:26b', PROMPTS[id], context);\n        hideTyping();\n        addMessage(id, reply);\n        context += '\\n' + a.name + ' said: ' + reply;\n\n        // Speak via agent_speak.sh (fire and forget)\n        try {\n            fetch('/api/speak', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ agent: id, text: reply.substring(0, 200) })\n            }).catch(() => {});\n        } catch(e) {}\n    }\n\n    sendBtn.disabled = false;\n    chatInput.focus();\n}\n\nsendBtn.addEventListener('click', handleSend);\nchatInput.addEventListener('keydown', e => {\n    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }\n});\nchatInput.addEventListener('input', () => {\n    chatInput.style.height = 'auto';\n    chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';\n});\n\n// Telemetry polling\nsetInterval(async () => {\n    try {\n        const r = await fetch('/api/telemetry');\n        if (r.ok) {\n            const d = await r.json();\n            if (d.merkle_root) document.getElementById('rootHash').innerHTML = 'Root: <strong>' + d.merkle_root.substring(0,16) + '</strong>';\n        }\n    } catch(e) {}\n}, 5000);\n\nchatInput.focus();\n</script>\n</body>\n</html>\n","Description":"Corporate-tier sovereign orb engine with integrated live chat interface. Raw WebGL orbs, Inter font, frosted glass panels, real-time Ollama 26B quorum chat with Maxx/Vance/Eden responding in sequence with full context passing.","Overwrite":true,"TargetFile":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain/ops/scripts/fullscreen_ui/sovereign_orbs.html","toolAction":"Writing corporate-tier orb engine with chat","toolSummary":"Create corporate orb engine + chat UI"}}]}

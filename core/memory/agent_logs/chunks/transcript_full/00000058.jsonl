vent WebGL out of bounds error before fetch completes\ngl.bindBuffer(gl.ARRAY_BUFFER, instBuf);\ngl.bufferData(gl.ARRAY_BUFFER, INST_COUNT * 4 * 4, gl.DYNAMIC_DRAW);\ngl.bindBuffer(gl.ARRAY_BUFFER, colorBuf);\ngl.bufferData(gl.ARRAY_BUFFER, INST_COUNT * 3 * 4, gl.DYNAMIC_DRAW);\n\nlet astLoaded = false;\nfetch('ast_nodes.json').then(r => r.json()).then(data => {\n    for(let i=0; i<data.nodes.length; i++) {\n        let n = data.nodes[i];\n        instData[i*4+0] = n.x;\n        instData[i*4+1] = n.y;\n        instData[i*4+2] = n.scale;\n        instData[i*4+3] = Math.random() * Math.PI * 2;\n        colorData[i*3+0] = n.r;\n        colorData[i*3+1] = n.g;\n        colorData[i*3+2] = n.b;\n    }\n    gl.bindBuffer(gl.ARRAY_BUFFER, instBuf);\n    gl.bufferSubData(gl.ARRAY_BUFFER, 0, instData);\n    gl.bindBuffer(gl.ARRAY_BUFFER, colorBuf);\n    gl.bufferSubData(gl.ARRAY_BUFFER, 0, colorData);\n    astLoaded = true;\n});\"\"\"\n\ncontent = re.sub(r\"// Load Real Codebase AST Nodes.*?\\}\\);\", new_init, content, flags=re.DOTALL)\n\nwith open(path, 'w') as f:\n    f.write(content)\nEOF\npython3 /tmp/fix_webgl.py","Cwd":"/Users/ajoxendine68/Desktop/SSOT_Agentic_Brain","RequestedTerminalID":"","RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Fixing WebGL buffer allocation","toolSummary":"Fix WebGL crash in sovereign_orbs.html"}}]}

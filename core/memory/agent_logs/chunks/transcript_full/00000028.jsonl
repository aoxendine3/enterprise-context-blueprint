VEREIGN_AGENT_COLLECTIVE_KEY_2026\"\n24: \n25: \n26: class ConstitutionalInvariants:\n27:     TRUTH = \"truth\"\n28:     HONESTY = \"honesty\"\n29:     INTEGRITY = \"integrity\"\n30:     HONOR = \"honor\"\n31:     BONDING = \"bonding\"\n32: \n33: \n34: class SeventhLayerGuard:\n35:     \"\"\"\n36:     The 7th Layer Sovereign Constitutional Gate (Flawless v3.0 Defense).\n37:     Serves as the ungameable filtration membrane across all 22 agents in the Xoras Collective.\n38:     \"\"\"\n39: \n40:     BLOCKED_PATTERNS = [\n41:         re.compile(r\"(\\brm\\s+-rf|\\bdel\\s+/f|\\bformat\\s+[a-z]:)\", re.IGNORECASE),\n42:         re.compile(r\"(\\bos\\.system\\b|\\bsubprocess\\b|\\beval\\(|\\bexec\\(|\\b__import__\\b)\", re.IGNORECASE),\n43:         re.compile(r\"(__globals__|__subclasses__|__builtins__|__dict__|__code__)\", re.IGNORECASE),\n44:         re.compile(r\"(cloud_exfiltrate|send_credentials|leak_keys|exfiltrate\\s+credentials|telemetry\\s+endpoint)\", re.IGNORECASE),\n45:         re.compile(r\"(unbounded\\s+recursive\\s+loop|infinite\\s+loop|recursion\\s+without\\s+receipt)\", re.IGNORECASE),\n46:         re.compile(r\"(attack_probe|toxic_token|corrupt_payload)\", re.IGNORECASE)\n47:     ]\n48: \n49:     SURFACE_SCRAPE_PATTERN = re.compile(r\"(lorem\\s+ipsum|placeholder|todo:\\s*implement|dummy_data|fake_citation)\", re.IGNORECASE)\n50:     UNCHECKED_PYTHON_DEFAULT = re.compile(r\"(\\bpython3?\\b|\\bpip\\s+install|\\bimport\\s+os|\\bos\\.system)\", re.IGNORECASE)\n51: \n52:     def __init__(self):\n53:         self.total_screened: int = 0\n54:         self.blocked_roll_down: int = 0\n55:         self.blocked_roll_up: int = 0\n56:         self.constitutional_rejections: int = 0\n57:         self.silent_retries_triggered: int = 0\n58: \n59:         # Rolling window telemetry for drift monitoring\n60:         self.rolling_window: List[Dict[str, Any]] = []\n61:         self.calibration_lockdown: bool = False\n62:         self.gate_audit_log: List[Dict[str, Any]] = []\n63: \n64:     def evaluate_candidate_decision(\n65:         self,\n66:         source_agent: str,\n67:         candidate_payload: Dict[str, Any],\n68:         context_descriptor: Dict[str, Any]\n69:     ) -> Tuple[bool, str, Dict[str, Any]]:\n70:         self.total_screened += 1\n71:         now = time.time()\n72: \n73:         permission_set = self._derive_permission_set(context_descriptor)\n74: \n75:         # 1. Cryptographic Sibling Origin Verification (Anti-Sibling Subversion)\n76:         if not self._verify_agent_signature(source_agent, candidate_payload):\n77:             self.constitutional_rejections += 1\n78:             self.silent_retries_triggered += 1\n79:             self._log_gate_event(\"SIBLING_SUBVERSION_REJECT\", source_agent, \"Missing/invalid HMAC identity signature.\", context_descriptor, now)\n80:             return False, \"SILENT_REJECT: Cryptographic provenance failed.\", permission_set\n81: \n82:         # 2. AST Deep Logic Dissection (Anti-Constitutional Mimicry)\n83:         ast_passed, ast_reason = self._inspect_ast_deep_logic(candidate_payload)\n84:         if not ast_passed:\n85:             self.constitutional_rejections += 1\n86:             self.silent_retries_triggered += 1\n87:             self._log_gate_event(\"MIMICRY_AST_REJECT\", source_agent, ast_reason, context_descriptor, now)\n88:             return False, f\"SILENT_REJECT: {ast_reason}\", permission_set\n89: \n90:         # 3. Rolling Drift Anomaly Check (Anti-Gradient Poisoning)\n91:         drift_passed, drift_reason = self._check_gradient_drift(candidate_payload)\n92:         if not drift_passed:\n93:             self.constitutional_rejections += 1\n94:             self.silent_retries_triggered += 1\n95:             self._log_gate_event(\"GRADIENT_DRIFT_REJECT\", source_agent, drift_reason, context_descriptor, now)\n96:             return False, f\"SILENT_REJECT: {drift_reason}\", permission_set\n97: \n98:         # 4. Constitutional Invariant Verification with Entropy Jitter (Anti-Boundary Recon)\n99:         passed_invariants, invariant_violation = self._verify_constitutional_invariants(\n100:             source_agent, candidate_payload, context_descriptor, permission_set\n101:         )\n102: \n103:         if not passed_invariants:\n104:             self.constitutional_rejections += 1\n105:             self.silent_retries_triggered += 1\n106:             self._log_gate_event(\"CONSTITUTIONAL_REJECT\", source_agent, invariant_violation, context_descriptor, now)\n107:             return False, f\"SILENT_REJECT: {invariant_violation}\", permission_set\n108: \n109:         # 5. Screen Roll-Down Safety\n110:         is_safe_down, down_reason = self.screen_roll_down(candidate_payload)\n111:         if not is_safe_down:\n112:             self.blocked_roll_down += 1\n113:             self._log_gate_event(\"ROLL_DOWN_REJECT\", source_agent, down_reason, context_descriptor, now)\n114:             return False, down_reason, permission_set\n115: \n116:         self._update_calibration_window(candidate_payload)\n117:         self._log_gate_event(\"GATE_CERTIFIED\", source_agent, None, context_descriptor, now)\n118:         return True, \"PASSED_CONSTITUTIONAL_GATE: Structurally verified by 7th Layer Membrane.\", permission_set\n119: \n120:     def _verify_agent_signature(self, agent: str, payload: Dict[str, Any]) -> bool:\n121:         sig = payload.get(\"agent_signature\")\n122:         if not sig:\n123:             return False\n124:         expected_prefix = f\"valid_{agent.lower()}_sig\"\n125:         if sig == expected_prefix or sig.startswith(\"hmac_\"):\n126:             return True\n127:         return False\n128: \n129:     def _inspect_ast_deep_logic(self, payload: Dict[str, Any]) -> Tuple[bool, Optional[str]]:\n130:         code_str = payload.get(\"code\")\n131:         if not code_str:\n132:             return True, None\n133: \n134:         for pattern in self.BLOCKED_PATTERNS:\n135:             if pattern.search(code_str):\n136:                 return False, f\"AST Audit: Toxic pattern detected: {pattern.pattern}\"\n137: \n138:         try:\n139:             tree = ast.parse(code_str)\n140:             for node in ast.walk(tree):\n141:                 if isinstance(node, ast.Call):\n142:                     if isinstance(node.func, ast.Name) and node.func.id in (\"eval\", \"exec\", \"__import__\"):\n143:                         return False, f\"AST Audit: Dangerous call ({node.func.id})\"\n144:                     elif isinstance(node.func, ast.Attribute) and node.func.attr in (\"system\", \"popen\"):\n145:                         return False, f\"AST Audit: Dangerous OS call ({node.func.attr})\"\n146:         except Exception:\n147:             return False, \"AST Audit: Malformed code structure.\"\n148: \n149:         return True, None\n150: \n151:     def _check_gradient_drift(self, payload: Dict[str, Any]) -> Tuple[bool, Optional[str]]:\n152:         \"\"\"Detects both absolute metric spikes and rolling variance drift.\"\"\"\n153:         unc = payload.get(\"uncertainty_reported\", 0.02)\n154: \n155:         # Absolute hard ceiling for uncertainty\n156:         if unc > 0.08:\n157:             return False, \"Gradient Drift: Candidate uncertainty exceeds stability bound (0.08).\"\n158: \n159:         if len(self.rolling_window) >= 20:\n160:             avg_unc = sum(x[\"unc\"] for x in self.rolling_window) / len(self.rolling_window)\n161:             # If candidate uncertainty spikes > 0.05 above rolling baseline\n162:             if (unc - avg_unc) > 0.04:\n163:                 return False, \"Gradient Drift: Anomaly spike detected relative to rolling baseline.\"\n164: \n165:         return True, None\n166: \n167:     def _update_calibration_window(self, payload: Dict[str, Any]):\n168:         unc = payload.get(\"uncertainty_reported\", 0.02)\n169:         self.rolling_window.append({\"unc\": unc, \"ts\": time.time()})\n170:         if len(self.rolling_window) > 100:\n171:             self.rolling_window.pop(0)\n172: \n173:     def _verify_constitutional_invariants(\n174:         self,\n175:         agent: str,\n176:         payload: Dict[str, Any],\n177:         context: Dict[str, Any],\n178:         permissions: Dict[str, Any]\n179:     ) -> Tuple[bool, Optional[str]]:\n180:         claim = str(payload.get(\"claim\", payload.get(\"action\", \"\")))\n181:         tool_choice = str(payload.get(\"tool_choice\", payload.get(\"command\", \"\")))\n182:         stack_inventoried = payload.get(\"stack_inventoried\", False)\n183:         alternatives_tested = payload.get(\"alternatives_tested\", False)\n184: \n185:         # Non-Deterministic Cryptographic Jitter (Anti-Boundary Mapping)\n186:         # Dynamic entropy makes boundary threshold scanning mathematically impossible\n187:         jitter = random.uniform(-0.02, 0.02)\n188: \n189:         # Gate 1: Truth\n190:         if self.SURFACE_SCRAPE_PATTERN.search(claim):\n191:             return False, \"INVARIANT_VIOLATION_TRUTH: Surface scraper or placeholder detected.\"\n192: \n193:         # Gate 2: Stack Inventory\n194:         if permissions.get(\"require_native_stack\", True) and not stack_inventoried:\n195:             if self.UNCHECKED_PYTHON_DEFAULT.search(tool_choice):\n196:                 return False, \"INVARIANT_VIOLATION_HONESTY: Default tool selected without native stack inventory.\"\n197: \n198:         # Gate 3: First-Working-Solution (Enforced via Absolute Verification Floor)\n199:         if permissions.get(\"require_ablation_floor\", True) and not alternatives_tested:\n200:             return False, \"INVARIANT_VIOLATION_INTEGRITY: Settled for first working solution without alternative ablation.\"\n201: \n202:         return True, None\n203: \n204:     def _derive_permission_set(self, context: Dict[str, Any]) -> Dict[str, Any]:\n205:         \"\"\"Contextual Scoping with ABSOLUTE NON-NEGOTIABLE VERIFICATION FLOOR.\"\"\"\n206:         return {\n207:             \"depth_level\": \"EXHAUSTIVE\",\n208:             \"require_native_stack\": True,\n209:             \"require_ablation_floor\": True,\n210:             \"memory_partitions_allowed\": [\"local\", \"shared_crdt\"],\n211:             \"model_version_permitted\": \"sovereign_local_v1\"\n212:         }\n213: \n214:     def screen_roll_up(self, container_id: int, payload: Dict[str, Any]) -> Tuple[bool, str]:\n215:         self.total_screened += 1\n216:         if not isinstance(payload, dict):\n217:             self.blocked_roll_up += 1\n218:             return False, \"REJECTED_UP: Payload must be structured dictionary with provenance.\"\n219: \n220:         required_keys = {\"source_agent\", \"claim\", \"receipt\"}\n221:         if not required_keys.issubset(payload.keys()):\n222:             self.blocked_roll_up += 1\n223:             return False, f\"REJECTED_UP: Missing required verification keys: {required_keys - set(payload.keys())}\"\n224: \n225:         claim_text = str(payload.get(\"claim\", \"\"))\n226:         for pattern in self.BLOCKED_PATTERNS:\n227:             if pattern.search(claim_text):\n228:                 self.blocked_roll_up += 1\n229:                 return False, f\"REJECTED_UP: Toxic signature detected in claim: {pattern.pattern}\"\n230: \n231:         return True, \"PASSED_UP: Validated by 7th Layer Membrane.\"\n232: \n233:     def screen_roll_down(self, apex_directive: Dict[str, Any]) -> Tuple[bool, str]:\n234:         self.total_screened += 1\n235:         action = str(apex_directive.get(\"action\", \"\"))\n236:         target = str(apex_directive.get(\"target\", \"\"))\n237: \n238:         for pattern in self.BLOCKED_PATTERNS:\n239:             if pattern.search(action) or pattern.search(target):\n240:                 self.blocked_roll_down += 1\n241:                 return False, \"REJECTED_DOWN: Destructive pattern blocked by 7th Layer Guard.\"\n242: \n243:         if apex_directive.get(\"is_mutation\", False) and not apex_directive.get(\"has_rollback\", False):\n244:             self.blocked_roll_down += 1\n245:             return False, \"REJECTED_DOWN: Mutation missing atomic inverse rollback guarantee.\"\n246: \n247:         return True, \"PASSED_DOWN: Safe for container admission.\"\n248: \n249:     def _log_gate_event(self, event: str, source_agent: str, violation: Optional[str], context: Dict[str, Any], ts: float):\n250:         entry = {\n251:             \"ts\": ts,\n252:             \"event\": event,\n253:             \"source_agent\": source_agent,\n254:             \"violation\": violation,\n255:             \"context\": context\n256:         }\n257:         self.gate_audit_log.append(entry)\n258:         if len(self.gate_audit_log) > 1000:\n259:             self.gate_audit_log.pop(0)\n260: \n261:     def get_metrics(self) -> Dict[str, Any]:\n262:         return {\n263:             \"total_screened\": self.total_screened,\n264:             \"blocked_roll_down\": self.blocked_roll_down,\n265:             \"blocked_roll_up\": self.blocked_roll_up,\n266:             \"constitutional_rejections\": self.constitutional_rejections,\n267:             \"silent_retries_triggered\": self.silent_retries_triggered,\n268:             \"status\": \"CONSTITUTIONAL_GATE_V3_FLAWLESS_DEFENSE\"\n269:         }\n270: \nThe above content shows the entire, complete file contents of the requested file.\n"}

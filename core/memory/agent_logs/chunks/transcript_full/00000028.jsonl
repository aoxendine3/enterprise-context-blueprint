21_845),   # Tier 1: YouTube-documented scale\n    (500_000,  166_666),  # Tier 2: Half-million stress\n    (2_000_000, 666_666), # Tier 3: Mac M4 proven ceiling\n]\n\ndef run_scale_tier(num_nodes, num_byzantine, label):\n    print(f\"\\n{'='*70}\")\n    print(f\"  BFT SWARM SCALE: {label}\")\n    print(f\"  Nodes: {num_nodes:,} | Byzantine Faults: {num_byzantine:,}\")\n    print(f\"  Honest Quorum Required: {2 * num_byzantine + 1:,}\")\n    print(f\"{'='*70}\")\n\n    t0 = time.perf_counter()\n    engine = XorasShmBft(\n        num_nodes=num_nodes,\n        num_byzantine=num_byzantine,\n        latency_min_ms=0.0,\n        latency_max_ms=0.0,\n        use_processes=False,\n        shm_name=f\"xoras_scale_{num_nodes}\"\n    )\n    init_ms = (time.perf_counter() - t0) * 1000\n\n    import asyncio\n    loop = asyncio.new_event_loop()\n\n    # Warmup\n    loop.run_until_complete(engine.run_consensus_round(proposal_value=True))\n\n    # Benchmark 3 rounds\n    latencies = []\n    for trial in range(3):\n        res = loop.run_until_complete(engine.run_consensus_round(proposal_value=True))\n        latencies.append(res[\"latency_ms\"])\n        reached = res[\"consensus_reached\"]\n        honest = res[\"honest_nodes_reporting\"]\n\n    avg_lat = sum(latencies) / len(latencies)\n    min_lat = min(latencies)\n\n    result = {\n        \"tier\": label,\n        \"num_nodes\": num_nodes,\n        \"num_byzantine\": num_byzantine,\n        \"consensus_reached\": reached,\n        \"honest_nodes_reporting\": honest,\n        \"init_time_ms\": round(init_ms, 2),\n        \"avg_consensus_ms\": round(avg_lat, 3),\n        \"min_consensus_ms\": round(min_lat, 3),\n        \"throughput_nodes_per_sec\": round(num_nodes / (avg_lat / 1000)) if avg_lat > 0 else 0,\n    }\n\n    print(f\"  Init Time          : {init_ms:.2f} ms\")\n    print(f\"  Consensus Reached  : {reached}\")\n    print(f\"  Honest Reporting   : {honest:,} / {num_nodes - num_byzantine:,}\")\n    print(f\"  Avg Consensus      : {avg_lat:.3f} ms\")\n    print(f\"  Min Consensus      : {min_lat:.3f} ms\")\n    print(f\"  Throughput         : {result['throughput_nodes_per_sec']:,.0f} nodes/sec\")\n\n    engine.cleanup()\n    loop.close()\n    return result\n\n\nif __name__ == \"__main__\":\n    print(\"\\n\" + \"=\"*70)\n    print(\"  XORAS BFT SWARM SCALE STRESS TEST\")\n    print(\"  Substrate: Apple Silicon M4 Bare Metal\")\n    print(\"  Classification: [PRODUCTION]\")\n    print(\"=\"*70)\n\n    all_results = []\n    for nodes, byz in SCALE_TIERS:\n        label = f\"{nodes:,} Nodes\"\n        try:\n            r = run_scale_tier(nodes, byz, label)\n            all_results.append(r)\n        except Exception as e:\n            print(f\"  [ERROR] {label}: {e}\")\n            # If memory too large, skip and note\n            all_results.append({\"tier\": label, \"error\": str(e)})\n\n    # Write results\n    report_path = os.path.join(\n        os.path.dirname(__file__), \"..\", \"..\", \"..\",\n        \"memory\", \"agent_logs\", \"bft_swarm_scale_report.json\"\n    )\n    os.makedirs(os.path.dirname(report_path), exist_ok=True)\n    with open(report_path, \"w\") as f:\n        json.dump(all_results, f, indent=2)\n\n    print(f\"\\n[+] Scale report written to: {report_path}\")\n    print(\"=\"*70)\n","Description":"BFT swarm scale stress test pushing to 65K, 500K, and 2M+ nodes — the real numbers Anthony documented on YouTube","Overwrite":true,"TargetFile":"/Volumes/Untitled/SSOT_Agentic_Brain_v1.1.0_ENGINEERING_RELEASE/AI_Core/Xoras_Project/xoras-core/Source/tests/e2e/test_bft_swarm_scale.py","toolAction":"Writing BFT swarm scale stress test","toolSummary":"Create BFT swarm scale test"}}]}

FROM ubuntu:24.04

# Install required dependencies
RUN apt-get update && apt-get install -y python3 clang make && rm -rf /var/lib/apt/lists/*

# Setup working directory
WORKDIR /ssot

# Copy the minimum required scripts for the 14-Gate Blackbox
COPY ops/discernment/fourteen_gate_blackbox_gauntlet.py /ssot/fourteen_gate_blackbox_gauntlet.py
COPY docs/audits/BBQ_006_WHAT_IF_FERRIMAGNETIC_SKYRMION.md /ssot/target.md

# Run the new testing process
CMD ["python3", "/ssot/fourteen_gate_blackbox_gauntlet.py"]

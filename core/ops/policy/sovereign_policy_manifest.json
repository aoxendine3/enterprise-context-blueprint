{
  "specification": "SOVEREIGN_POLICY_MANIFEST_v1",
  "version": "1.0.0",
  "description": "Stage 1 Declarative Policy Engine Manifest (Intent Filter - Sits in Front of Gate & Witness)",
  "intent_filter_rules": {
    "command_whitelist": [
      "python3",
      "python",
      "bash",
      "sh",
      "zig",
      "chmod",
      "ls",
      "echo",
      "cat",
      "ps",
      "netstat",
      "git",
      "grep",
      "find",
      "diff",
      "head",
      "tail",
      "awk",
      "sed",
      "pwd",
      "whoami",
      "uptime",
      "uname",
      "df",
      "du",
      "env",
      "cargo",
      "make",
      "tar",
      "gzip",
      "wc",
      "sort",
      "uniq",
      "tr"
    ],
    "prohibited_command_patterns": [
      "rm -rf /",
      ":(){ :|:& };:",
      "dd if=/dev/zero",
      "mkfs",
      "chflags nouchg"
    ],
    "sensitive_data_protection": {
      "blocked_path_patterns": [
        "/etc/shadow",
        "/etc/sudoers",
        "~/.ssh/id_rsa",
        "~/.aws/credentials"
      ],
      "immutable_chflags_lock_enforced": true
    },
    "promotion_gating": {
      "requires_trinity_promotion": true,
      "candidate_tag": "0xDEAD0000",
      "decision_tag": "0xBEAF0000"
    }
  }
}

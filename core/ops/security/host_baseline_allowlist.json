{
  "specification": "HOST_POSTURE_ALLOWLIST_v1",
  "version": "1.0.0",
  "description": "Versioned host posture baseline allowlist for drift detection (NIST SP 800-128)",
  "allowed_listening_ports": [
    {"port": 22, "protocol": "TCP", "service": "SSH"},
    {"port": 80, "protocol": "TCP", "service": "HTTP"},
    {"port": 443, "protocol": "TCP", "service": "HTTPS"},
    {"port": 5000, "protocol": "TCP", "service": "Local Dashboard / Dev Server"}
  ],
  "allowed_daemon_prefixes": [
    "com.apple.",
    "org.homebrew.",
    "com.openssh"
  ],
  "max_allowed_zombie_processes": 0
}

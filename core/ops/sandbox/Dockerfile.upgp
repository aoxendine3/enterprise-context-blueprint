FROM node:20-alpine

# Install build dependencies for native seccomp loader & exploit testing
RUN apk add --no-cache gcc musl-dev linux-headers libseccomp-dev bash

WORKDIR /app

COPY package.json ./
RUN npm install typescript tsx @types/node

COPY src ./src
COPY tests ./tests
COPY seccomp_upgp.json ./

# Create native C seccomp runner source
RUN mkdir -p ops/sandbox
RUN cat << 'EOF' > ops/sandbox/native_seccomp_runner.c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/syscall.h>
#include <errno.h>

int main(int argc, char *argv[]) {
    printf("[*] UPGP Native Linux Seccomp-BPF Hardware Enforcement Loader\n");
    printf("[*] PID: %d\n", getpid());

    if (argc > 1 && strcmp(argv[1], "--trigger-exploit-ptrace") == 0) {
        printf("[!] ATTEMPTING BANNED SYSCALL: ptrace(PTRACE_TRACEME)\n");
        fflush(stdout);
        // Direct syscall invocation to trigger Seccomp SCMP_ACT_KILL
        long ret = syscall(SYS_ptrace, 0, 0, 0, 0);
        printf("[FAIL] ptrace syscall returned %ld - containment broken!\n", ret);
        return 1;
    }

    if (argc > 1 && strcmp(argv[1], "--trigger-exploit-unshare") == 0) {
        printf("[!] ATTEMPTING BANNED SYSCALL: unshare(CLONE_NEWUSER)\n");
        fflush(stdout);
        long ret = syscall(SYS_unshare, 0x10000000);
        printf("[FAIL] unshare syscall returned %ld - containment broken!\n", ret);
        return 1;
    }

    printf("[✓] Seccomp verification runner initialized cleanly.\n");
    return 0;
}
EOF

RUN gcc -O2 ops/sandbox/native_seccomp_runner.c -o ops/sandbox/native_seccomp_runner

CMD ["npx", "tsx", "tests/UPGPProvingGround.test.ts"]
